    {
      "id": "cxx17-stdlib-port",
      "description": "Replace C++20 and Abseil infrastructure with C++17 standard-library types, private namespace, and a non-throwing typed API."
    },
    {
      "id": "fixed-capacity-only",
      "description": "Retain fixed-capacity feasibility search; omit capacity minimization, IIS, CLI, converters, Python, and logging."
    },
    {
      "id": "deterministic-global-fuel",
      "description": "Use one DFS-node budget across partitions, preorder heuristics, and round-robin attempts, with a distinct resource-exhausted result."
    },
    {
      "id": "checked-boundary",
      "description": "Validate retained inputs and legality arithmetic; saturate heuristic-only area overflow without changing feasibility."
    },
    {
      "id": "strict-gap-subset",
      "description": "Accept only sorted, non-adjacent, non-empty gaps strictly inside a lifespan, matching the Wafer conflict-graph adapter."
    },
    {
      "id": "positive-buffer-core",
      "description": "Preserve positive-height canonical-search assumptions; the Wafer adapter handles zero-byte demands before this core."
    }
