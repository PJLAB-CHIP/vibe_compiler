{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wafer.invalid/schemas/wafer-profile-evidence.json",
  "title": "Wafer 16-tile profile evidence",
  "description": "Profile evidence for one compiled program with explicit physical card, Tile, and launch-slot bindings. Primary same-stream device elapsed, host submit, and host completion remain separate. Exact static work is recorded independently from measured timing so the report can form bounded hardware peak references without guessing workload from names.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "program",
    "topology",
    "measurement",
    "output_validation",
    "sites",
    "validity",
    "static_cost_model",
    "experiment"
  ],
  "properties": {
    "schema": {
      "const": "wafer.profile.evidence"
    },
    "run_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "program": {
      "$ref": "#/$defs/programMetadata"
    },
    "topology": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["card_id", "tile_id", "launch_slot", "x", "y"],
        "properties": {
          "card_id": {
            "const": 0
          },
          "tile_id": {
            "$ref": "#/$defs/tile"
          },
          "launch_slot": {
            "$ref": "#/$defs/tile"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples"],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/measurementSample"
          }
        }
      }
    },
    "output_validation": {
      "$ref": "#/$defs/outputValidation"
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "profile_instrumentation",
        "measurement_basis"
      ],
      "properties": {
        "environment": {
          "type": "boolean"
        },
        "profile_instrumentation": {
          "type": "boolean"
        },
        "measurement_basis": {
          "type": "boolean"
        }
      }
    },
    "static_cost_model": {
      "$ref": "#/$defs/staticCostModel"
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tile": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "engine": {
      "enum": ["CT", "NE", "RDMA", "WDMA", "TDMA", "DIRECT_DTE"]
    },
    "nccEngine": {
      "enum": ["CT", "NE", "RDMA", "WDMA", "TDMA"]
    },
    "staticCostMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "value", "reason"],
      "properties": {
        "knowledge": {
          "enum": ["known", "unavailable", "unsupported", "overflow"]
        },
        "value": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "enum": [
            "none",
            "dynamic-loop-trip-count",
            "invalid-loop-step",
            "conditional-control-flow",
            "unsupported-control-flow",
            "unavailable-physical-geometry",
            "unavailable-resource-bytes",
            "missing-accepted-spm-offset",
            "invalid-accepted-spm-offset",
            "missing-accepted-ddr-offset",
            "invalid-accepted-ddr-offset",
            "unsupported-spm-root",
            "unresolved-noc-route",
            "invalid-execution-topology",
            "unsupported-instruction-semantics",
            "unsupported-compute-type",
            "arithmetic-overflow"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"knowledge": {"const": "known"}},
            "required": ["knowledge"]
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              "reason": {"const": "none"}
            }
          },
          "else": {
            "properties": {
              "value": {"type": "null"},
              "reason": {
                "not": {"const": "none"}
              }
            }
          }
        },
        {
          "if": {
            "properties": {"knowledge": {"const": "overflow"}},
            "required": ["knowledge"]
          },
          "then": {
            "properties": {
              "reason": {"const": "arithmetic-overflow"}
            }
          }
        }
      ]
    },
    "staticCostWork": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "npu_f16_bf16_logical_ops",
        "npu_other_logical_ops",
        "vector_f16_bf16_logical_ops",
        "vector_f32_logical_ops",
        "vector_other_logical_ops",
        "ddr_read_bytes",
        "ddr_write_bytes",
        "spm_movement_bytes",
        "noc_transmit_bytes",
        "noc_receive_bytes",
        "directional_noc_transmit_bytes"
      ],
      "properties": {
        "npu_f16_bf16_logical_ops": {"$ref": "#/$defs/staticCostMetric"},
        "npu_other_logical_ops": {"$ref": "#/$defs/staticCostMetric"},
        "vector_f16_bf16_logical_ops": {
          "$ref": "#/$defs/staticCostMetric"
        },
        "vector_f32_logical_ops": {"$ref": "#/$defs/staticCostMetric"},
        "vector_other_logical_ops": {"$ref": "#/$defs/staticCostMetric"},
        "ddr_read_bytes": {"$ref": "#/$defs/staticCostMetric"},
        "ddr_write_bytes": {"$ref": "#/$defs/staticCostMetric"},
        "spm_movement_bytes": {"$ref": "#/$defs/staticCostMetric"},
        "noc_transmit_bytes": {"$ref": "#/$defs/staticCostMetric"},
        "noc_receive_bytes": {"$ref": "#/$defs/staticCostMetric"},
        "directional_noc_transmit_bytes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["north", "east", "south", "west"],
          "properties": {
            "north": {"$ref": "#/$defs/staticCostMetric"},
            "east": {"$ref": "#/$defs/staticCostMetric"},
            "south": {"$ref": "#/$defs/staticCostMetric"},
            "west": {"$ref": "#/$defs/staticCostMetric"}
          }
        }
      }
    },
    "staticCostTile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "tile_id", "launch_slot", "work"],
      "properties": {
        "card_id": {"const": 0},
        "tile_id": {"$ref": "#/$defs/tile"},
        "launch_slot": {"$ref": "#/$defs/tile"},
        "work": {"$ref": "#/$defs/staticCostWork"}
      }
    },
    "staticCostModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "scope", "rates", "tiles"],
      "properties": {
        "model": {"const": "tx81-static-throughput-lower-bound"},
        "scope": {
          "const": "complete-final-instruction-program-per-physical-tile"
        },
        "rates": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ddr_bytes_per_second",
            "directional_noc_bytes_per_second",
            "f16_bf16_npu_logical_ops_per_second_per_tile",
            "f16_bf16_vector_logical_ops_per_second_per_tile",
            "f32_vector_logical_ops_per_second_per_tile",
            "spm_movement_bytes_per_second"
          ],
          "properties": {
            "ddr_bytes_per_second": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "directional_noc_bytes_per_second": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "f16_bf16_npu_logical_ops_per_second_per_tile": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "f16_bf16_vector_logical_ops_per_second_per_tile": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "f32_vector_logical_ops_per_second_per_tile": {
              "type": "integer",
              "minimum": 1,
              "maximum": 18446744073709551615
            },
            "spm_movement_bytes_per_second": {
              "type": "null"
            }
          }
        },
        "tiles": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/staticCostTile"}
        }
      }
    },
    "runtimeLaunch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "form", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "kernel"},
            "form": {"const": "grid"},
            "entry_abi": {
              "enum": ["tile-major-pointer-table", "tile-row-pointer-table"]
            },
            "phases": {"const": ["main"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "form", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "kernel"},
            "form": {"const": "cluster"},
            "entry_abi": {
              "enum": ["tile-major-pointer-table", "tile-row-pointer-table"]
            },
            "phases": {"const": ["prepare", "main"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "model"},
            "entry_abi": {"const": "tx81-model-bootparam"},
            "phases": {"const": ["main"]}
          }
        }
      ]
    },
    "programMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_manifest_sha256",
        "target_identity",
        "launch",
        "card_count",
        "tile_count",
        "site_correlation_basis",
        "record_abi"
      ],
      "properties": {
        "program_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_identity": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "launch": {
          "$ref": "#/$defs/runtimeLaunch"
        },
        "card_count": {
          "const": 1
        },
        "tile_count": {
          "const": 16
        },
        "site_correlation_basis": {
          "const": "target-call-ordinal-ssa-position"
        },
        "record_abi": {
          "const": "wafer-tx81-profiler-record"
        }
      }
    },
    "outputValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "resources"],
      "properties": {
        "mode": {
          "enum": [
            "external-expected",
            "mixed",
            "same-session-primary"
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outputValidationResource"
          }
        }
      }
    },
    "outputValidationResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "role",
        "role_index",
        "bytes",
        "reference_sha256",
        "external_expected_comparison",
        "primary_output_validated",
        "diagnostic_captures_match_primary"
      ],
      "properties": {
        "scope": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "card_id"],
              "properties": {
                "kind": {"const": "card"},
                "card_id": {"const": 0}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "card_id", "tile_id"],
              "properties": {
                "kind": {"const": "tile"},
                "card_id": {"const": 0},
                "tile_id": {"$ref": "#/$defs/tile"}
              }
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role_index": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "reference_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "external_expected_comparison": {
          "type": ["string", "null"],
          "enum": ["exact", "relaxed-f16", null]
        },
        "primary_output_validated": {
          "type": "boolean"
        },
        "diagnostic_captures_match_primary": {
          "type": "boolean"
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "tile_id",
        "launch_slot",
        "site_id",
        "site_kind",
        "correlation_key",
        "engine",
        "target_call_ordinal",
        "target_call_symbol"
      ],
      "properties": {
        "card_id": {
          "const": 0
        },
        "tile_id": {
          "$ref": "#/$defs/tile"
        },
        "launch_slot": {
          "$ref": "#/$defs/tile"
        },
        "site_id": {
          "type": "integer",
          "minimum": 0
        },
        "site_kind": {
          "enum": [
            "ncc-command",
            "ncc-completion", "ddr-completion",
            "direct-dte-control",
            "direct-dte-issue",
            "direct-dte-wait"
          ]
        },
        "correlation_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "engine": {
          "anyOf": [
            {"$ref": "#/$defs/engine"},
            {"type": "null"}
          ]
        },
        "target_call_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "target_call_symbol": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "position": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"site_kind": {"const": "ncc-command"}},
            "required": ["site_kind"]
          },
          "then": {"properties": {"engine": {"$ref": "#/$defs/nccEngine"}}}
        },
        {
          "if": {
            "properties": {
              "site_kind": {
                "enum": ["ncc-completion", "ddr-completion", "direct-dte-control"]
              }
            },
            "required": ["site_kind"]
          },
          "then": {"properties": {"engine": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {
              "site_kind": {
                "enum": ["direct-dte-issue", "direct-dte-wait"]
              }
            },
            "required": ["site_kind"]
          },
          "then": {"properties": {"engine": {"const": "DIRECT_DTE"}}}
        }
      ]
    },
    "clockMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "card_id",
        "tile_id",
        "launch_slot",
        "slope",
        "offset",
        "uncertainty",
        "round_trips",
        "valid",
        "monotonic"
      ],
      "properties": {
        "card_id": {"const": 0},
        "tile_id": {
          "$ref": "#/$defs/tile"
        },
        "launch_slot": {
          "$ref": "#/$defs/tile"
        },
        "slope": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset": {
          "type": "number"
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "round_trips": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "boolean"
        },
        "monotonic": {
          "type": "boolean"
        }
      }
    },
    "measurementSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "sample_index",
        "device_elapsed_ns",
        "device_timer_kind",
        "host_submit_ns",
        "host_launch_to_completion_ns",
        "completion_observation_resolution_ns"
      ],
      "properties": {
        "sample_id": {
          "const": "primary"
        },
        "sample_index": {
          "const": 0
        },
        "device_elapsed_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "device_timer_kind": {
          "const": "tx-stream-events"
        },
        "host_submit_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "host_launch_to_completion_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "completion_observation_resolution_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "site_id",
        "sub_index",
        "engine",
        "kind",
        "observed_begin_cycle",
        "observed_end_cycle",
        "counter_delta",
        "site_begin_cycle",
        "site_end_cycle",
        "operation_begin_cycle",
        "operation_end_cycle",
        "observation_count",
        "observed_span_valid",
        "site_span_valid",
        "operation_span_valid",
        "positive_delta",
        "attribution_ambiguous",
        "ncc_counter_valid",
        "observation_status",
        "worker",
        "wait_scope",
        "dte_counter_valid",
        "dte_role"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "site_id": {
          "type": "integer",
          "minimum": 0
        },
        "sub_index": {
          "type": "integer",
          "minimum": 0
        },
        "engine": {
          "anyOf": [
            {"$ref": "#/$defs/engine"},
            {"type": "null"}
          ]
        },
        "kind": {
          "enum": [
            "ncc-command",
            "ncc-completion-wait",
            "direct-dte-issue",
            "direct-dte-wait",
            "direct-dte-peer-ready-wait",
            "direct-dte-setup-issue",
            "direct-dte-completion-wait",
            "direct-dte-cleanup",
            "target-site"
          ]
        },
        "observed_begin_cycle": {
          "$ref": "#/$defs/u64",
          "description": "Tile-local Kcore CPU cycle sampled with rdcycle."
        },
        "observed_end_cycle": {
          "$ref": "#/$defs/u64",
          "description": "Tile-local Kcore CPU cycle sampled with rdcycle."
        },
        "counter_delta": {
          "$ref": "#/$defs/u64",
          "description": "For NCC engines, vendor PMU engine execution time in nanoseconds. For DIRECT_DTE, uncalibrated raw channel-PMU activity when dte_counter_valid is true."
        },
        "site_begin_cycle": {
          "$ref": "#/$defs/u64"
        },
        "site_end_cycle": {
          "$ref": "#/$defs/u64"
        },
        "operation_begin_cycle": {
          "$ref": "#/$defs/u64"
        },
        "operation_end_cycle": {
          "$ref": "#/$defs/u64"
        },
        "observation_count": {
          "$ref": "#/$defs/u32"
        },
        "observed_span_valid": {
          "type": "boolean"
        },
        "site_span_valid": {
          "type": "boolean"
        },
        "operation_span_valid": {
          "type": "boolean"
        },
        "positive_delta": {
          "type": "boolean"
        },
        "attribution_ambiguous": {
          "type": "boolean"
        },
        "ncc_counter_valid": {
          "type": ["boolean", "null"]
        },
        "observation_status": {
          "type": ["string", "null"],
          "enum": [
            "engine-delta-bounded",
            "counter-no-change",
            "attribution-ambiguous",
            "counter-unavailable",
            null
          ]
        },
        "worker": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 2
        },
        "wait_scope": {
          "type": ["string", "null"],
          "enum": ["local", "worker", null]
        },
        "dte_counter_valid": {
          "type": ["boolean", "null"]
        },
        "dte_role": {
          "type": ["string", "null"],
          "enum": ["send", "receive", null]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ncc-command"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "engine": {"$ref": "#/$defs/nccEngine"},
              "observation_status": {
                "enum": [
                  "engine-delta-bounded",
                  "counter-no-change",
                  "attribution-ambiguous",
                  "counter-unavailable"
                ]
              },
              "ncc_counter_valid": {"type": "boolean"},
              "dte_counter_valid": {"type": "null"},
              "dte_role": {"type": "null"}
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "ncc_counter_valid": {"const": false}
                  },
                  "required": ["ncc_counter_valid"]
                },
                "then": {
                  "properties": {
                    "observed_begin_cycle": {"const": 0},
                    "observed_end_cycle": {"const": 0},
                    "counter_delta": {"const": 0},
                    "observation_count": {"const": 0},
                    "observed_span_valid": {"const": false},
                    "positive_delta": {"const": false},
                    "observation_status": {"const": "counter-unavailable"}
                  }
                },
                "else": {
                  "properties": {
                    "observation_count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    },
                    "observed_span_valid": {"const": true}
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "attribution_ambiguous": {"const": true}
                        },
                        "required": ["attribution_ambiguous"]
                      },
                      "then": {
                        "properties": {
                          "observation_status": {
                            "const": "attribution-ambiguous"
                          }
                        }
                      },
                      "else": {
                        "if": {
                          "properties": {
                            "positive_delta": {"const": true}
                          },
                          "required": ["positive_delta"]
                        },
                        "then": {
                          "properties": {
                            "observation_status": {
                              "const": "engine-delta-bounded"
                            }
                          }
                        },
                        "else": {
                          "properties": {
                            "observation_status": {
                              "const": "counter-no-change"
                            }
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "positive_delta": {"const": true}
                        },
