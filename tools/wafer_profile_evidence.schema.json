{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wafer.invalid/schemas/wafer-profile-evidence-v7.json",
  "title": "Wafer 16-tile profile evidence",
  "description": "Version 7 final-artifact evidence. Primary same-stream device elapsed, host submit, and host completion remain separate. Record ABI v3 separates Kcore site/operation spans from bounded NCC observations and publishes eight mutually-exclusive trace-only overhead counters. The analyzer forms an exclusive semantic rdcycle partition and a non-additive trace-overhead overlay; asynchronous NCC nanosecond work volume is never summed with either.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "identity",
    "topology",
    "measurement",
    "output_validation",
    "sites",
    "validity",
    "experiment"
  ],
  "properties": {
    "schema": {
      "const": "wafer.profile.evidence"
    },
    "schema_version": {
      "const": 7
    },
    "run_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "identity": {
      "$ref": "#/$defs/sharedIdentity"
    },
    "topology": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tile", "x", "y"],
        "properties": {
          "tile": {
            "$ref": "#/$defs/tile"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples"],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/measurementSample"
          }
        }
      }
    },
    "output_validation": {
      "$ref": "#/$defs/outputValidation"
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "package_companion",
        "measurement_basis"
      ],
      "properties": {
        "environment": {
          "type": "boolean"
        },
        "package_companion": {
          "type": "boolean"
        },
        "measurement_basis": {
          "type": "boolean"
        }
      }
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tile": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "engine": {
      "enum": ["CT", "NE", "RDMA", "WDMA", "TDMA", "DIRECT_DTE"]
    },
    "nccEngine": {
      "enum": ["CT", "NE", "RDMA", "WDMA", "TDMA"]
    },
    "runtimeLaunch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "form", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "kernel"},
            "form": {"const": "per-rank"},
            "entry_abi": {"const": "rank-local-pointer-block-v1"},
            "phases": {"const": ["main"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "form", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "kernel"},
            "form": {"const": "grid"},
            "entry_abi": {"const": "rank-major-pointer-table-v1"},
            "phases": {"const": ["main"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "form", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "kernel"},
            "form": {"const": "cluster"},
            "entry_abi": {"const": "rank-major-pointer-table-v1"},
            "phases": {"const": ["prepare", "main"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "model"},
            "entry_abi": {"const": "tx81-model-bootparam-v1"},
            "phases": {"const": ["main"]}
          }
        }
      ]
    },
    "sharedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_manifest_sha256",
        "profile_companion_schema_version",
        "target_profile",
        "launch",
        "execution_ranks",
        "site_correlation_basis",
        "record_abi"
      ],
      "properties": {
        "production_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_companion_schema_version": {
          "const": 4
        },
        "target_profile": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "launch": {
          "$ref": "#/$defs/runtimeLaunch"
        },
        "execution_ranks": {
          "const": 16
        },
        "site_correlation_basis": {
          "const": "typed-target-call-ordinal-ssa-identity-occurrence-v1"
        },
        "record_abi": {
          "const": "wafer-tx81-profiler-record-v3"
        }
      }
    },
    "outputValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "resources"],
      "properties": {
        "mode": {
          "enum": [
            "external-expected",
            "mixed",
            "same-session-production"
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outputValidationResource"
          }
        }
      }
    },
    "outputValidationResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_rank",
        "role",
        "role_index",
        "bytes",
        "reference_sha256",
        "external_expected_comparison",
        "production_execution_validated",
        "diagnostic_captures_match_primary"
      ],
      "properties": {
        "logical_rank": {
          "type": "integer",
          "minimum": -1
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role_index": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "reference_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "external_expected_comparison": {
          "type": ["string", "null"],
          "enum": ["exact", "relaxed-f16", null]
        },
        "production_execution_validated": {
          "type": "boolean"
        },
        "diagnostic_captures_match_primary": {
          "type": "boolean"
        }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "target_profile",
        "launch",
        "execution_ranks"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "target_profile": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "launch": {
          "$ref": "#/$defs/runtimeLaunch"
        },
        "execution_ranks": {
          "const": 16
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tile",
        "site_id",
        "site_kind",
        "correlation_key",
        "engine",
        "target_call_ordinal",
        "target_call_symbol"
      ],
      "properties": {
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "site_id": {
          "type": "integer",
          "minimum": 0
        },
        "site_kind": {
          "enum": [
            "ncc-command",
            "ncc-completion",
            "direct-dte-control",
            "direct-dte-wait"
          ]
        },
        "correlation_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "engine": {
          "anyOf": [
            {"$ref": "#/$defs/engine"},
            {"type": "null"}
          ]
        },
        "target_call_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "target_call_symbol": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "position": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"site_kind": {"const": "ncc-command"}},
            "required": ["site_kind"]
          },
          "then": {"properties": {"engine": {"$ref": "#/$defs/nccEngine"}}}
        },
        {
          "if": {
            "properties": {
              "site_kind": {
                "enum": ["ncc-completion", "direct-dte-control"]
              }
            },
            "required": ["site_kind"]
          },
          "then": {"properties": {"engine": {"type": "null"}}}
        },
        {
          "if": {
            "properties": {"site_kind": {"const": "direct-dte-wait"}},
            "required": ["site_kind"]
          },
          "then": {"properties": {"engine": {"const": "DIRECT_DTE"}}}
        }
      ]
    },
    "clockMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tile",
        "slope",
        "offset",
        "uncertainty",
        "round_trips",
        "valid",
        "monotonic"
      ],
      "properties": {
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "slope": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset": {
          "type": "number"
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "round_trips": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "boolean"
        },
        "monotonic": {
          "type": "boolean"
        }
      }
    },
    "measurementSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "sample_index",
        "device_elapsed_ns",
        "device_timer_kind",
        "host_submit_ns",
        "host_launch_to_completion_ns",
        "completion_observation_resolution_ns"
      ],
      "properties": {
        "sample_id": {
          "const": "primary"
        },
        "sample_index": {
          "const": 0
        },
        "device_elapsed_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "device_timer_kind": {
          "const": "tx-stream-events"
        },
        "host_submit_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "host_launch_to_completion_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "completion_observation_resolution_ns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "site_id",
        "sub_index",
        "engine",
        "kind",
        "observed_begin_cycle",
        "observed_end_cycle",
        "counter_delta",
        "site_begin_cycle",
        "site_end_cycle",
        "operation_begin_cycle",
        "operation_end_cycle",
        "observation_count",
        "observed_span_valid",
        "site_span_valid",
        "operation_span_valid",
        "positive_delta",
        "attribution_ambiguous",
        "ncc_counter_valid",
        "observation_status",
        "worker",
        "wait_scope",
        "dte_counter_valid",
        "dte_role"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "site_id": {
          "type": "integer",
          "minimum": 0
        },
        "sub_index": {
          "type": "integer",
          "minimum": 0
        },
        "engine": {
          "anyOf": [
            {"$ref": "#/$defs/engine"},
            {"type": "null"}
          ]
        },
        "kind": {
          "enum": [
            "ncc-command",
            "ncc-completion-wait",
            "direct-dte-wait",
            "direct-dte-peer-ready-wait",
            "direct-dte-setup-issue",
            "direct-dte-completion-wait",
            "direct-dte-cleanup",
            "target-site"
          ]
        },
        "observed_begin_cycle": {
          "$ref": "#/$defs/u64",
          "description": "Tile-local Kcore CPU cycle sampled with rdcycle."
        },
        "observed_end_cycle": {
          "$ref": "#/$defs/u64",
          "description": "Tile-local Kcore CPU cycle sampled with rdcycle."
        },
        "counter_delta": {
          "$ref": "#/$defs/u64",
          "description": "For NCC engines, vendor PMU engine execution time in nanoseconds. For DIRECT_DTE, uncalibrated raw channel-PMU activity when dte_counter_valid is true."
        },
        "site_begin_cycle": {
          "$ref": "#/$defs/u64"
        },
        "site_end_cycle": {
          "$ref": "#/$defs/u64"
        },
        "operation_begin_cycle": {
          "$ref": "#/$defs/u64"
        },
        "operation_end_cycle": {
          "$ref": "#/$defs/u64"
        },
        "observation_count": {
          "$ref": "#/$defs/u32"
        },
        "observed_span_valid": {
          "type": "boolean"
        },
        "site_span_valid": {
          "type": "boolean"
        },
        "operation_span_valid": {
          "type": "boolean"
        },
        "positive_delta": {
          "type": "boolean"
        },
        "attribution_ambiguous": {
          "type": "boolean"
        },
        "ncc_counter_valid": {
          "type": ["boolean", "null"]
        },
        "observation_status": {
          "type": ["string", "null"],
          "enum": [
            "engine-delta-bounded",
            "counter-no-change",
            "attribution-ambiguous",
            "counter-unavailable",
            null
          ]
        },
        "worker": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 2
        },
        "wait_scope": {
          "type": ["string", "null"],
          "enum": ["local", "worker", null]
        },
        "dte_counter_valid": {
          "type": ["boolean", "null"]
        },
        "dte_role": {
          "type": ["string", "null"],
          "enum": ["send", "receive", null]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "ncc-command"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "engine": {"$ref": "#/$defs/nccEngine"},
              "observation_status": {
                "enum": [
                  "engine-delta-bounded",
                  "counter-no-change",
                  "attribution-ambiguous",
                  "counter-unavailable"
                ]
              },
              "ncc_counter_valid": {"type": "boolean"},
              "dte_counter_valid": {"type": "null"},
              "dte_role": {"type": "null"}
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "ncc_counter_valid": {"const": false}
                  },
                  "required": ["ncc_counter_valid"]
                },
                "then": {
                  "properties": {
                    "observed_begin_cycle": {"const": 0},
                    "observed_end_cycle": {"const": 0},
                    "counter_delta": {"const": 0},
                    "observation_count": {"const": 0},
                    "observed_span_valid": {"const": false},
                    "positive_delta": {"const": false},
                    "observation_status": {"const": "counter-unavailable"}
                  }
                },
                "else": {
                  "properties": {
                    "observation_count": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4294967295
                    },
                    "observed_span_valid": {"const": true}
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "attribution_ambiguous": {"const": true}
                        },
                        "required": ["attribution_ambiguous"]
                      },
                      "then": {
                        "properties": {
                          "observation_status": {
                            "const": "attribution-ambiguous"
                          }
                        }
                      },
                      "else": {
                        "if": {
                          "properties": {
                            "positive_delta": {"const": true}
                          },
                          "required": ["positive_delta"]
                        },
                        "then": {
                          "properties": {
                            "observation_status": {
                              "const": "engine-delta-bounded"
                            }
                          }
                        },
                        "else": {
                          "properties": {
                            "observation_status": {
                              "const": "counter-no-change"
                            }
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "positive_delta": {"const": true}
                        },
                        "required": ["positive_delta"]
                      },
                      "then": {
                        "properties": {
                          "counter_delta": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 18446744073709551615
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "counter_delta": {"const": 0}
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "else": {
            "properties": {
              "observation_status": {"type": "null"},
              "ncc_counter_valid": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "engine": {"const": "DIRECT_DTE"}
            },
            "required": ["engine"]
          },
          "then": {
            "properties": {
              "dte_role": {"enum": ["send", "receive"]}
            }
          },
          "else": {
            "properties": {
              "dte_role": {"type": "null"},
              "dte_counter_valid": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "direct-dte-wait"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "dte_counter_valid": {"type": "boolean"}
            }
          },
          "else": {
            "properties": {
              "dte_counter_valid": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "target-site"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "sub_index": {"const": 0},
              "engine": {"type": "null"},
              "observed_begin_cycle": {"const": 0},
              "observed_end_cycle": {"const": 0},
              "counter_delta": {"const": 0},
              "operation_begin_cycle": {"const": 0},
              "operation_end_cycle": {"const": 0},
              "observation_count": {"const": 0},
              "observed_span_valid": {"const": false},
              "site_span_valid": {"const": true},
              "operation_span_valid": {"const": false},
              "positive_delta": {"const": false},
              "attribution_ambiguous": {"const": false},
              "ncc_counter_valid": {"type": "null"},
              "observation_status": {"type": "null"},
              "worker": {"type": "null"},
              "wait_scope": {"type": "null"},
              "dte_counter_valid": {"type": "null"},
              "dte_role": {"type": "null"}
            }
          }
        }
      ]
    },
    "costSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ncc_pmu_sample_cycles",
        "dte_pmu_sample_cycles",
        "event_bookkeeping_cycles",
        "status_poll_cycles",
        "site_hook_cycles",
        "completion_loop_bookkeeping_cycles",
        "entry_setup_cycles",
        "entry_teardown_cycles"
      ],
      "properties": {
        "ncc_pmu_sample_cycles": {"$ref": "#/$defs/u64"},
        "dte_pmu_sample_cycles": {"$ref": "#/$defs/u64"},
        "event_bookkeeping_cycles": {"$ref": "#/$defs/u64"},
        "status_poll_cycles": {"$ref": "#/$defs/u64"},
        "site_hook_cycles": {"$ref": "#/$defs/u64"},
        "completion_loop_bookkeeping_cycles": {"$ref": "#/$defs/u64"},
        "entry_setup_cycles": {"$ref": "#/$defs/u64"},
        "entry_teardown_cycles": {"$ref": "#/$defs/u64"}
      }
    },
    "traceTile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tile",
        "entry_begin_cycle",
        "entry_end_cycle",
        "capacity",
        "count",
        "preflight_count",
        "next_sequence",
        "dropped_event_count",
        "record_flags",
        "trace_state",
        "overflow",
        "cost_summary",
        "events"
      ],
      "properties": {
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "entry_begin_cycle": {
          "$ref": "#/$defs/u64",
          "description": "Tile-local Kcore CPU cycle sampled with rdcycle."
        },
        "entry_end_cycle": {
          "$ref": "#/$defs/u64",
          "description": "Tile-local Kcore CPU cycle sampled with rdcycle."
        },
        "capacity": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "preflight_count": {
          "$ref": "#/$defs/u64"
        },
        "next_sequence": {
          "$ref": "#/$defs/u64"
        },
        "dropped_event_count": {
          "$ref": "#/$defs/u32"
        },
        "record_flags": {
          "$ref": "#/$defs/u32"
        },
        "trace_state": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "overflow": {
          "type": "boolean"
        },
        "cost_summary": {
          "$ref": "#/$defs/costSummary"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "counterSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "recovery", "stable", "enabled"],
      "properties": {
        "start": {
          "$ref": "#/$defs/u64"
        },
        "end": {
          "$ref": "#/$defs/u64"
        },
        "recovery": {
          "$ref": "#/$defs/u64"
        },
        "stable": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "counterSnapshot32": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "recovery", "stable", "enabled"],
      "properties": {
        "start": {
          "$ref": "#/$defs/u32"
        },
        "end": {
          "$ref": "#/$defs/u32"
        },
        "recovery": {
          "$ref": "#/$defs/u32"
        },
        "stable": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "aggregateCounters": {
