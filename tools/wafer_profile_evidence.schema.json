{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wafer.invalid/schemas/wafer-profile-evidence-v4.json",
  "title": "Wafer 16-tile profile evidence",
  "description": "Version 4 final-artifact-only evidence consumed by wafer_profile_report.py. The production artifact's launch-to-completion host time is the top-level result; rank-local NCC and Direct-DTE hardware busy counters plus bounded activity observations explain each tile without inventing cross-tile order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_id",
    "identity",
    "topology",
    "measurement",
    "output_validation",
    "sites",
    "validity",
    "experiment"
  ],
  "properties": {
    "schema": {
      "const": "wafer.profile.evidence"
    },
    "schema_version": {
      "const": 4
    },
    "run_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "identity": {
      "$ref": "#/$defs/sharedIdentity"
    },
    "topology": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tile", "x", "y"],
        "properties": {
          "tile": {
            "$ref": "#/$defs/tile"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples"],
      "properties": {
        "samples": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/measurementSample"
          }
        }
      }
    },
    "output_validation": {
      "$ref": "#/$defs/outputValidation"
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/site"
      }
    },
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment",
        "package_companion",
        "measurement_basis"
      ],
      "properties": {
        "environment": {
          "type": "boolean"
        },
        "package_companion": {
          "type": "boolean"
        },
        "measurement_basis": {
          "type": "boolean"
        }
      }
    },
    "experiment": {
      "$ref": "#/$defs/experiment"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tile": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "engine": {
      "enum": ["CT", "NE", "RDMA", "WDMA", "TDMA", "DIRECT_DTE"]
    },
    "nccEngine": {
      "enum": ["CT", "NE", "RDMA", "WDMA", "TDMA"]
    },
    "runtimeLaunch": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "form", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "kernel"},
            "form": {"const": "per-rank"},
            "entry_abi": {"const": "rank-local-pointer-block-v1"},
            "phases": {"const": ["main"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "form", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "kernel"},
            "form": {"const": "grid"},
            "entry_abi": {"const": "rank-major-pointer-table-v1"},
            "phases": {"const": ["main"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "form", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "kernel"},
            "form": {"const": "cluster"},
            "entry_abi": {"const": "rank-major-pointer-table-v1"},
            "phases": {"const": ["prepare", "main"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "entry_abi", "phases"],
          "properties": {
            "kind": {"const": "model"},
            "entry_abi": {"const": "tx81-model-bootparam-v1"},
            "phases": {"const": ["main"]}
          }
        }
      ]
    },
    "sharedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_manifest_sha256",
        "profile_companion_schema_version",
        "target_profile",
        "launch",
        "execution_ranks",
        "site_correlation_basis"
      ],
      "properties": {
        "production_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_companion_schema_version": {
          "const": 2
        },
        "target_profile": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "launch": {
          "$ref": "#/$defs/runtimeLaunch"
        },
        "execution_ranks": {
          "const": 16
        },
        "site_correlation_basis": {
          "const": "heuristic-target-call-signature-occurrence-v1"
        }
      }
    },
    "outputValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "resources"],
      "properties": {
        "mode": {
          "enum": [
            "external-expected",
            "mixed",
            "same-session-production"
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/outputValidationResource"
          }
        }
      }
    },
    "outputValidationResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_rank",
        "role",
        "role_index",
        "bytes",
        "reference_sha256",
        "external_expected_comparison",
        "production_repeats_exact",
        "diagnostic_captures_exact"
      ],
      "properties": {
        "logical_rank": {
          "type": "integer",
          "minimum": -1
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role_index": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "reference_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "external_expected_comparison": {
          "type": ["string", "null"],
          "enum": ["exact", "relaxed-f16", null]
        },
        "production_repeats_exact": {
          "type": "boolean"
        },
        "diagnostic_captures_exact": {
          "type": "boolean"
        }
      }
    },
    "artifactIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "digest",
        "target_profile",
        "launch",
        "execution_ranks"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "target_profile": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "launch": {
          "$ref": "#/$defs/runtimeLaunch"
        },
        "execution_ranks": {
          "const": 16
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tile",
        "site_id",
        "correlation_key",
        "engine",
        "target_call_ordinal",
        "target_call_symbol"
      ],
      "properties": {
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "site_id": {
          "type": "integer",
          "minimum": 0
        },
        "correlation_key": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "target_call_ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "target_call_symbol": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "position": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "clockMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tile",
        "slope",
        "offset",
        "uncertainty",
        "round_trips",
        "valid",
        "monotonic"
      ],
      "properties": {
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "slope": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "offset": {
          "type": "number"
        },
        "uncertainty": {
          "type": "number",
          "minimum": 0
        },
        "round_trips": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "boolean"
        },
        "monotonic": {
          "type": "boolean"
        }
      }
    },
    "entryTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tile", "entry_begin", "entry_end"],
      "properties": {
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "entry_begin": {
          "$ref": "#/$defs/u64"
        },
        "entry_end": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "measurementSample": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_id",
        "sample_index",
        "host_elapsed_ns",
        "completion_observation_resolution_ns"
      ],
      "properties": {
        "sample_id": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sample_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "host_elapsed_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "completion_observation_resolution_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "site_id",
        "sub_index",
        "engine",
        "observed_begin_cycle",
        "observed_end_cycle",
        "counter_delta",
        "activity_valid",
        "dte_counter_valid",
        "dte_role"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "site_id": {
          "type": "integer",
          "minimum": 0
        },
        "sub_index": {
          "type": "integer",
          "minimum": 0
        },
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "observed_begin_cycle": {
          "$ref": "#/$defs/u64"
        },
        "observed_end_cycle": {
          "$ref": "#/$defs/u64"
        },
        "counter_delta": {
          "$ref": "#/$defs/u64"
        },
        "activity_valid": {
          "type": "boolean"
        },
        "dte_counter_valid": {
          "type": ["boolean", "null"]
        },
        "dte_role": {
          "type": ["string", "null"],
          "enum": ["send", "receive", null]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "engine": {
                "const": "DIRECT_DTE"
              }
            },
            "required": ["engine"]
          },
          "then": {
            "properties": {
              "activity_valid": {
                "const": true
              },
              "dte_counter_valid": {
                "type": "boolean"
              },
              "dte_role": {
                "enum": ["send", "receive"]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "dte_counter_valid": {
                      "const": false
                    }
                  },
                  "required": ["dte_counter_valid"]
                },
                "then": {
                  "properties": {
                    "counter_delta": {
                      "const": 0
                    }
                  }
                }
              }
            ]
          },
          "else": {
            "properties": {
              "dte_counter_valid": {
                "type": "null"
              },
              "dte_role": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "traceTile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tile",
        "entry_begin_cycle",
        "entry_end_cycle",
        "capacity",
        "count",
        "preflight_count",
        "next_sequence",
        "dropped_event_count",
        "record_flags",
        "trace_state",
        "overflow",
        "events"
      ],
      "properties": {
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "entry_begin_cycle": {
          "$ref": "#/$defs/u64"
        },
        "entry_end_cycle": {
          "$ref": "#/$defs/u64"
        },
        "capacity": {
          "type": "integer",
          "minimum": 0
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "preflight_count": {
          "$ref": "#/$defs/u64"
        },
        "next_sequence": {
          "$ref": "#/$defs/u64"
        },
        "dropped_event_count": {
          "$ref": "#/$defs/u32"
        },
        "record_flags": {
          "$ref": "#/$defs/u32"
        },
        "trace_state": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "overflow": {
          "type": "boolean"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "counterSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "recovery", "stable", "enabled"],
      "properties": {
        "start": {
          "$ref": "#/$defs/u64"
        },
        "end": {
          "$ref": "#/$defs/u64"
        },
        "recovery": {
          "$ref": "#/$defs/u64"
        },
        "stable": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "counterSnapshot32": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "recovery", "stable", "enabled"],
      "properties": {
        "start": {
          "$ref": "#/$defs/u32"
        },
        "end": {
          "$ref": "#/$defs/u32"
        },
        "recovery": {
          "$ref": "#/$defs/u32"
        },
        "stable": {
          "type": "boolean"
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "aggregateCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistics_window",
        "fu",
        "ct",
        "ne",
        "rdma",
        "wdma",
        "tdma",
        "scalar"
      ],
      "properties": {
        "statistics_window": {
          "$ref": "#/$defs/counterSnapshot"
        },
        "fu": {
          "$ref": "#/$defs/counterSnapshot"
        },
        "ct": {
          "$ref": "#/$defs/counterSnapshot"
        },
        "ne": {
          "$ref": "#/$defs/counterSnapshot"
        },
        "rdma": {
          "$ref": "#/$defs/counterSnapshot"
        },
        "wdma": {
          "$ref": "#/$defs/counterSnapshot"
        },
        "tdma": {
          "$ref": "#/$defs/counterSnapshot"
        },
        "scalar": {
          "$ref": "#/$defs/counterSnapshot"
        }
      }
    },
    "workerEngineCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "instructions", "blocking"],
      "properties": {
        "engine": {
          "$ref": "#/$defs/nccEngine"
        },
        "instructions": {
          "$ref": "#/$defs/counterSnapshot32"
        },
        "blocking": {
          "$ref": "#/$defs/counterSnapshot32"
        }
      }
    },
    "workerCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worker", "engines"],
      "properties": {
        "worker": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "engines": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/workerEngineCounters"
          }
        }
      }
    },
    "pmuTile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tile", "aggregates", "workers"],
      "properties": {
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "aggregates": {
          "$ref": "#/$defs/aggregateCounters"
        },
        "workers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/workerCounters"
          }
        }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "clock",
        "summary",
        "trace",
        "pmu"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifactIdentity"
        },
        "clock": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/clockMapping"
          }
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tiles"],
          "properties": {
            "tiles": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/entryTiming"
              }
            }
          }
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["complete", "tiles"],
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "tiles": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/traceTile"
              }
            }
          }
        },
        "pmu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tiles"],
          "properties": {
            "tiles": {
              "type": "array",
              "minItems": 16,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/pmuTile"
              }
            }
          }
        }
      }
    }
  }
}
