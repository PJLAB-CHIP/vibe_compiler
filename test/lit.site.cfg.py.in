config.wafer_src_root = r"@CMAKE_SOURCE_DIR@"
config.wafer_obj_root = r"@CMAKE_BINARY_DIR@"
config.wafer_tools_dir = r"@CMAKE_BINARY_DIR@/bin"
config.llvm_tools_dir = r"@LLVM_TOOLS_BINARY_DIR@"
config.filecheck_dir = r"@WAFER_FILECHECK_DIR@"
config.python_executable = r"@Python3_EXECUTABLE@"
config.importer_python_executable = r"@WAFER_IMPORTER_PYTHON_EXECUTABLE@"
config.wafer_enable_importer_deps = "@WAFER_ENABLE_IMPORTER_DEPS@"
config.wafer_enable_spmd_partitioner_deps = "@WAFER_ENABLE_SPMD_PARTITIONER_DEPS@"
config.wafer_enable_pytorch_xla_importer = "@WAFER_ENABLE_PYTORCH_XLA_IMPORTER@"

lit_config.load_config(config, r"@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py")
