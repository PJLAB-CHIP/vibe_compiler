# CHECK: backend: tx-host
# CHECK: package: model_package_sample
# CHECK: runtime_mode: tx
# CHECK: completion_source: runtime_stream_wait
# CHECK: selected_entrypoint: debug_kernel tx.module
# CHECK: model: model_package_sample abi=wafer-cabi-v0
# CHECK: session_binding: lhs role=input bytes=16 lifecycle=import_or_allocate,query,bind,copy_h2d read_only=true host_visible=true
# CHECK: session_binding: out role=output bytes=16 lifecycle=allocate,query,bind,copy_d2h read_only=false host_visible=true
# CHECK: session_binding: tmp role=workspace bytes=16 lifecycle=allocate,query,bind read_only=false host_visible=false
# CHECK: session_binding: rhs_resident role=resident_constant bytes=16 lifecycle=allocate,query,bind,copy_h2d source=launch_input:rhs read_only=true host_visible=false
# CHECK: module_resolve: kernel format=tx.kcore path=model_package.so
# CHECK: launch_arg: 0 lhs role=input bytes=16
# CHECK: launch_arg: 2 out role=output bytes=16
# CHECK: launch_arg: 4 rhs_resident role=resident_constant bytes=16
# CHECK: entrypoint_plan: debug_kernel executor=tx.module launch_api=txLaunchKernel module=kernel function=model_package_sample_abi arg_bytes=80
# CHECK: completion_plan: wait runtime_stream_wait
# CHECK: tx_runtime_library: {{.*}}libhpgr.so
# CHECK: tx_runtime_symbols: ok
# CHECK: board_launch_gate: not executed

# BAD-BINDING: error: entrypoint debug_kernel binding_order[0] does not name a runtime binding: missing_binding

# DESCRIPTOR-ONLY: error: tx.model entrypoint model_bpm requires a materialized BPM descriptor

# STUB-COMPLETION: error: completion source is not supported by tx-host backend: TsmDeviceSynchronize

# LEGACY-MODE: error: tx-host backend requires runtime.mode tx

# MISSING: error: tx runtime library is missing required symbol(s) for tx.module: txLaunchKernel
