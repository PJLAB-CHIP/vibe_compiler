# RUN: rm -rf %t.package %t.bad-package
# RUN: mkdir -p %t.package/modules
# RUN: touch %t.package/modules/tile_00000.so
# RUN: mkdir -p %t.package/data
# RUN: touch %t.package/data/program-data.bin
# RUN: cp %S/Inputs/typed-package-manifest.json %t.package/manifest.json
# RUN: wafer-run --package-dir %t.package --no-card | FileCheck %s --check-prefix=PLAN
# RUN: not wafer-run --package-dir %t.package 2>&1 | FileCheck %s --check-prefix=NO-MODE
# RUN: not wafer-run --package-dir %t.package --board 2>&1 | FileCheck %s --check-prefix=BOARD-QUALIFICATION
# RUN: not wafer-run --package-dir %t.package --board --max-resource-bytes 32 2>&1 | FileCheck %s --check-prefix=BOARD-OPTIONS
# RUN: not wafer-run --package-dir %t.package --no-card --max-resource-bytes 32 2>&1 | FileCheck %s --check-prefix=CAPACITY
# RUN: not wafer-run --package-dir %t.package --no-card --device-id 0 2>&1 | FileCheck %s --check-prefix=NO-CARD-BOARD-OPTION
# RUN: not wafer-run --package-dir %t.package --no-card --device-timing 2>&1 | FileCheck %s --check-prefix=NO-CARD-BOARD-OPTION
# RUN: not wafer-run --package-dir %t.package --no-card --output 1=%t.raw 2>&1 | FileCheck %s --check-prefix=NO-CARD-BOARD-OPTION
# RUN: cp -R %t.package %t.bad-package
# RUN: printf extra > %t.bad-package/modules/extra.so
# RUN: not wafer-run --package-dir %t.bad-package --no-card 2>&1 | FileCheck %s --check-prefix=EXTRA
# RUN: rm -rf %t.bad-package
# RUN: cp -R %t.package %t.bad-package
# RUN: printf corrupt > %t.bad-package/modules/tile_00000.so
# RUN: not wafer-run --package-dir %t.bad-package --no-card 2>&1 | FileCheck %s --check-prefix=DIGEST
# RUN: not wafer-run --package-dir %S/../Tools --no-card 2>&1 | FileCheck %s --check-prefix=MISSING-MANIFEST

# PLAN: package: id=0 cards=1 tiles=16
# PLAN: target_identity: wafer-tx81-single-card
# PLAN: target: wafer-tx81-single-card runtime_abi=wafer-tx81-kernel module_format=elf-riscv64
# PLAN: launch: kind=kernel form=grid entry_abi=tile-major-pointer-table phases=main
# PLAN: entry: 0 card_id=0 tile_id=1 launch_slot=0
# PLAN: module: 0 path=modules/tile_00000.so
# PLAN: launch_phase: role=main symbol=main
# PLAN: launch_argument: 0 base=invocation offset=0
# PLAN: launch_argument: 1 base=invocation offset=256
# PLAN: launch_argument: 2 base=invocation offset=512
# PLAN: completion: return_after_local_drain
# PLAN: invocation_tiles: 16
# PLAN: board_execution: false

# NO-MODE: wafer-run requires explicit --no-card
# BOARD-QUALIFICATION: --board requires complete explicit TX qualification options
# BOARD-OPTIONS: no-card verification options are not valid with --board
# CAPACITY: runtime environment invocation capacity is insufficient
# NO-CARD-BOARD-OPTION: board binding and qualification options require --board
# EXTRA: package modules contain an unreferenced payload
# DIGEST: package module digest mismatch
# MISSING-MANIFEST: failed to open package manifest member
