# RUN: FileCheck %s --input-file=%t.group.program/functions/forward.mlir --check-prefix=GROUP
# RUN: not wafer-opt --pass-pipeline='builtin.module(wafer-lower-groups-to-llvm)' \
# RUN:   %t.group.program/functions/forward.mlir 2>&1 | FileCheck %s --check-prefix=BLOCKER

