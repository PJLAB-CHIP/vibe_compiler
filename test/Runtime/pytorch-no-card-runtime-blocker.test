# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper

# RUN: rm -rf %t.input.program %t.group.program
# RUN: printf '%b' 'import pathlib\nimport sys\nimport torch\nsys.path.insert(0, "%wafer_src_root/test/Tools/Inputs")\nimport wafer_pytorch_xla_capture as capture\nclass AddModel(torch.nn.Module):\n  def forward(self, x):\n    return x + x\ncapture.emit_reference_stablehlo_program(pathlib.Path("%t.input.program"), reference_module_factory=AddModel, size=32)\n' > %t.capture.py
# RUN: %importer_python %t.capture.py
# RUN: wafer-opt --program-pipeline=stablehlo-spmd-to-group \
# RUN:   --input-program-dir %t.input.program \
