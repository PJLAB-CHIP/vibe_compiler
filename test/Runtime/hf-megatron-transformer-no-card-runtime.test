# PIPELINE: wafer-opt: completed Wafer program pipeline stablehlo-spmd-to-group:

# GROUP: mhlo.spmd_parameters_shardings
# GROUP: func.func @main
# GROUP: wafer.group

# INSTR-NOT: wafer.group
# INSTR-NOT: wafer.tile.all_gather
# INSTR: wafer.instr.gemm
# INSTR: wafer.instr.dte_send
# INSTR: wafer.instr.dte_recv
# INSTR: wafer.instr.wdma

# LLVM: llvm.func @main_abi
# LLVM-SAME: %{{.*}}: i64
# LLVM: llvm.call @wafer_gemm
# LLVM: llvm.call @wafer_dte_send
# LLVM: llvm.call @wafer_wdma

# PACKAGE: "name": "hf_megatron_transformer_no_card"
# PACKAGE: "workspace": [
# PACKAGE: "name": "workspace0"
# PACKAGE: "workspace_bytes": 272
# PACKAGE: "kind": "non_finite"
# PACKAGE: "value": "-inf"
# PACKAGE: "op": "wafer.instr.dte_send"

# RUNTIME: backend: tx-host
# RUNTIME: package: hf_megatron_transformer_no_card
# RUNTIME: runtime_mode: tx
# RUNTIME: selected_entrypoint: debug_kernel tx.module
# RUNTIME: tx_runtime_symbols: ok
# RUNTIME: board_launch_gate: not executed
