// The installed production compiler must run from a relocated install tree:
// helper, device linker script, CRT and ABI resources are discovered next to
// the executable, python3/clang++ come from PATH and TX8_DEPS_ROOT is the
// only external configuration. The run happens from a fresh scratch
// directory, never from the source or build tree.

# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper

# RUN: rm -rf %t.install %t.input %t.package
# RUN: %cmake --install %wafer_obj_root --prefix %t.install
# RUN: test -x %t.install/bin/wafer-compile
# RUN: test -x %t.install/bin/wafer-verify-program
# RUN: test -f %t.install/lib/python/wafer/frontend/__init__.py
# RUN: test -f %t.install/share/wafer/wafer_device_link.py
# RUN: test -x %t.install/libexec/wafer/wafer_xla_spmd_partitioner
# RUN: test -f %t.install/share/wafer/crt/src/wafer_tx81_crt.c
# RUN: test -f %t.install/share/wafer/crt/include/wafer_tx81_crt.h
# RUN: test -f %t.install/share/wafer/include/Wafer/ABI/Tx81ProfilerABI.h
# RUN: env PYTHONPATH=%t.install/lib/python %importer_python -c 'import pathlib,torch; from wafer.frontend import export_pytorch_program; M=type("M",(torch.nn.Module,),{"forward":lambda self,x:x+x}); export_pytorch_program(M().eval(),(torch.ones(16),),pathlib.Path("%t.input"))'
# RUN: %t.install/bin/wafer-verify-program --program-dir %t.input | FileCheck %s --check-prefix=VERIFY
# RUN: %t.install/bin/wafer-compile --input-program-dir %t.input --output-dir %t.package --num-partitions=1 | FileCheck %s
# RUN: test -s %t.package/manifest.json
# RUN: test -s %t.package/modules/module_00000.so
# RUN: test -f %t.package/data/program-data.bin
# RUN: %t.install/bin/wafer-run --package-dir %t.package --no-card | FileCheck %s --check-prefix=NO-CARD

# CHECK: wafer-compile: wrote verified package with num-partitions=1 tiles=16:
# VERIFY: wafer-verify-program: verified portable StableHLO program parameters=0 constants=0
# NO-CARD: invocation_tiles: 16
# NO-CARD: board_execution: false
