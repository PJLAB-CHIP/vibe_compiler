# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper

# RUN: rm -rf %t.input.program %t.group.program
# RUN: env CPU_NUM_DEVICES=16 PJRT_DEVICE=CPU %importer_python %wafer_src_root/test/Tools/Inputs/wafer_pytorch_xla_capture.py --emit-sharded-program --sharding-strategy column --size 32 --output-program-dir %t.input.program
# RUN: wafer-opt --program-pipeline=stablehlo-spmd-to-group --input-program-dir %t.input.program --output-program-dir %t.group.program --default-tile-count=16 | FileCheck %s --check-prefix=PIPELINE
# RUN: FileCheck %s --input-file=%t.group.program/functions/forward.mlir --check-prefix=GROUP-MLIR
# RUN: wafer-opt --wafer-dump-group-tiling-demand %t.group.program/functions/forward.mlir 2>&1 | FileCheck %s --check-prefix=DEMAND
# RUN: wafer-opt --wafer-dump-group-layout-plan %t.group.program/functions/forward.mlir 2>&1 | FileCheck %s --check-prefix=LAYOUT

# PIPELINE: wafer-opt: completed Wafer program pipeline stablehlo-spmd-to-group:

# GROUP-MLIR: mhlo.spmd_parameters_shardings
# GROUP-MLIR: func.func @main
# GROUP-MLIR-NOT: stablehlo.all_gather
# GROUP-MLIR: wafer.group
# GROUP-MLIR: wafer.tensor_collective.all_gather
# GROUP-MLIR-SAME: rank_group = array<i64:
# GROUP-MLIR: wafer.group ins(%arg0, %{{[^ ]+}} : tensor<2xf32>, tensor<32x32xf32>) outs(%{{[^ ]+}} : tensor<32x32xf32>) {
# GROUP-MLIR: wafer.tensor_collective.all_gather
# GROUP-MLIR: linalg.generic
# GROUP-MLIR: arith.addf
# GROUP-MLIR: wafer.group_yield
# GROUP-MLIR-NOT: wafer.comm

# DEMAND-LABEL: wafer.tiling_demand group @main#0
# DEMAND: result_tile #0 type=tensor<32x32xf32> slice=[d0,d1]
# DEMAND: op #0 wafer.tensor_collective.all_gather
# DEMAND: collective kind=all_gather rank_group=[
# DEMAND: op #1 linalg.generic
# DEMAND: input #0 slice=[d0,d1]

# LAYOUT-LABEL: wafer.layout_plan group @main#0
# LAYOUT: op #0 wafer.tensor_collective.all_gather
# LAYOUT: collective kind=all_gather rank_group=[
# LAYOUT: result #0 layout=tensor slice=[d0,d1]
# LAYOUT: op #1 linalg.generic
# LAYOUT: input #0 layout=tensor slice=[d0,d1]
# LAYOUT: result #0 layout=tensor slice=[d0,d1]
