# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper

# RUN: rm -rf %t.input.program %t.group.program
# RUN: env CPU_NUM_DEVICES=16 PJRT_DEVICE=CPU %importer_python %wafer_src_root/test/Tools/Inputs/wafer_pytorch_xla_capture.py --emit-sharded-program --sharding-strategy column --size 32 --output-program-dir %t.input.program
# RUN: wafer-opt --program-pipeline=stablehlo-spmd-to-group --input-program-dir %t.input.program --output-program-dir %t.group.program | FileCheck %s --check-prefix=PIPELINE
# RUN: FileCheck %s --input-file=%t.group.program/functions/forward.mlir --check-prefix=GROUP-MLIR
# RUN: wafer-opt --wafer-dump-group-tiling-demand %t.group.program/functions/forward.mlir 2>&1 | FileCheck %s --check-prefix=DEMAND
# RUN: wafer-opt --wafer-dump-group-layout-plan %t.group.program/functions/forward.mlir 2>&1 | FileCheck %s --check-prefix=LAYOUT
# RUN: wafer-opt --wafer-dump-group-to-tile-region %t.group.program/functions/forward.mlir 2>&1 | FileCheck %s --check-prefix=GROUP-TO-TILE

# PIPELINE: wafer-opt: completed Wafer program pipeline stablehlo-spmd-to-group:

# GROUP-MLIR: mhlo.spmd_parameters_shardings
# GROUP-MLIR: wafer.target.topology @default
# GROUP-MLIR: wafer.execution.mesh @default_mesh
# GROUP-MLIR-SAME: policy = "all_available"
# GROUP-MLIR-SAME: shape = array<i64: 16>
# GROUP-MLIR: func.func @main
# GROUP-MLIR-NOT: stablehlo.all_gather
# GROUP-MLIR: wafer.group ins(%{{[^, ]+}}, %{{[^, ]+}}, %{{[^, ]+}} : tensor<32x32xf32>, tensor<32x2xf32>, tensor<2xf32>) outs(%{{[^ ]+}} : tensor<32x2xf32>) {
# GROUP-MLIR: linalg.matmul
# GROUP-MLIR: linalg.generic
# GROUP-MLIR: arith.addf
# GROUP-MLIR: wafer.group.yield
# GROUP-MLIR-NOT: wafer.tile.

# DEMAND-LABEL: wafer.tiling_demand group @main#0
# DEMAND: result_tile #0 type=tensor<32x2xf32> slice=[d0,d1]
# DEMAND: op #3 linalg.matmul
# DEMAND: accumulator result #0 reduction_dims=[d2]
# DEMAND: op #5 linalg.generic
# DEMAND: input #0 slice=[d1]
# DEMAND: op #6 linalg.generic

# LAYOUT-LABEL: wafer.layout_plan group @main#0
# LAYOUT: op #3 linalg.matmul
# LAYOUT: input #0 layout=cx slice=[d0,d2]
# LAYOUT: accumulator result #0 layout=cx reduction_dims=[d2]
# LAYOUT: op #5 linalg.generic
# LAYOUT: input #0 layout=tensor slice=[d1] relation=broadcast
# LAYOUT: op #6 linalg.generic
# LAYOUT: materialization #5 op #6 result #0 -> group result #0 cx->tensor type=tensor<32x2xf32>

# GROUP-TO-TILE-LABEL: wafer.group_to_tile_region group @main#0
# GROUP-TO-TILE: wafer.tile.gemm
# GROUP-TO-TILE: wafer.tile.broadcast
# GROUP-TO-TILE: wafer.tile.elementwise <add>
# GROUP-TO-TILE-NOT: wafer.tile.all_gather
# GROUP-TO-TILE: wafer.tile.store
