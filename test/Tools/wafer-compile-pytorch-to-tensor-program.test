# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper

# RUN: rm -rf %t.input.program %t.package
# RUN: printf '%b' 'import pathlib\nimport sys\nimport torch\nsys.path.insert(0, "%wafer_src_root/test/Tools/Inputs")\nimport wafer_pytorch_xla_capture as capture\nclass AddModel(torch.nn.Module):\n  def forward(self, x):\n    return x + x\ncapture.emit_reference_stablehlo_program(pathlib.Path("%t.input.program"), reference_module_factory=AddModel, size=32)\n' > %t.capture.py
# RUN: %importer_python %t.capture.py
# RUN: wafer-compile \
# RUN:   --input-program-dir %t.input.program \
# RUN:   --output-dir %t.package \
# RUN:   --num-partitions=1 | FileCheck %s --check-prefix=PIPELINE
# RUN: %python -c 'import json, pathlib; p=pathlib.Path("%t.package"); m=json.loads((p/"manifest.json").read_text()); assert m["program_data"]["total_bytes"]==0 and m["program_data"]["base_alignment"]==1 and m["program_data"]["digest"]=="sha256:e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"; assert m["program_tensors"]==[] and m["target_tensors"]==[]; i=m["inputs"][0]; assert i["role_index"]==0 and i["logical_dtype"]=="f16" and i["logical_shape"]==[32,32] and i["dtype"]=="f16" and i["bytes"]==2048; o=m["outputs"][0]; assert o["role_index"]==0 and o["logical_dtype"]=="f16" and o["logical_shape"]==[32,32] and o["dtype"]=="f16" and o["bytes"]==2048; assert all([(a["kind"], a["access"]) for a in e["arguments"][:2]]==[("external_input","read_only"),("external_output","write_only")] and len(e["arguments"])>=3 and all(a["kind"]=="workspace" and a["access"]=="read_write" and a["bytes"]>0 and a["alignment"]>0 for a in e["arguments"][2:]) for e in m["entries"])'
# RUN: test ! -e %t.package/functions

# PIPELINE: wafer-compile: wrote verified package with num-partitions=1 tiles=16:
