# RUN: env CPU_NUM_DEVICES=16 PJRT_DEVICE=CPU %importer_python %wafer_src_root/test/Tools/Inputs/wafer_pytorch_xla_capture.py --emit-workload-corpus --corpus-case simple-gemm-f16 --corpus-case large-gemm-f16 --output-corpus-dir %t.corpus --verify-corpus-reproducibility
# RUN: %wafer_bulk_qualify --mode source-spec --format f16 --m 4 --k 16 --n 16 --batch-count 1 --seed 101 --lhs-npy %t.corpus/simple-gemm-f16/reference/qualification/calibration-lhs.npy --rhs-npy %t.corpus/simple-gemm-f16/reference/qualification/calibration-rhs.npy --output %t.qualification/linear-calibration-spec.json
