# FORMAL: target model outputs matched; tiles=16 transactions=
# FORMAL-SAME: formal_commands=16 managed_reference_commands=0 managed_reference_scalars=0 bulk_commands=0
# UNMATCHED: target model outputs matched; tiles=16 transactions=
# UNMATCHED-SAME: formal_commands=16 managed_reference_commands=0 managed_reference_scalars=0 bulk_commands=0 bulk_matmuls=0
# UNMATCHED-NOT: target model bulk qualification=
# MANAGED-TENSOR: target model outputs matched; tiles=16 transactions=
# MANAGED-TENSOR-SAME: formal_commands=0 managed_reference_commands=0 managed_reference_scalars=0
# MANAGED-TENSOR-SAME: bulk_commands=16 bulk_matmuls=16
# MANAGED-TENSOR: wafer-compile: target model managed-reference environment=sha256:
# MANAGED: target model outputs matched; tiles=16 transactions=
# MANAGED-SAME: formal_commands=0 managed_reference_commands=0 managed_reference_scalars=0 bulk_commands=16 bulk_matmuls=16
# MANAGED-SAME: bulk_formal_fmas=0
# MANAGED: wafer-compile: target model managed-reference environment=sha256:
# MANAGED-NOT: target model bulk qualification=
# MISSING: wafer-compile: wrote verified package with num-partitions=1 tiles=16:
