# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper, target-model-bulk

# RUN: rm -rf %t.corpus %t.formal %t.unmatched %t.managed-tensor %t.large-managed %t.large-missing %t.qualification
