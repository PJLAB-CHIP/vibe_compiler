# RUN: not wafer-compile --input-program-dir %t.corpus/large-gemm-f16/program --output-program-dir %t.large-missing --num-partitions=1 --model-input 0=%t.corpus/large-gemm-f16/reference/input.npy --model-input 1=%t.corpus/large-gemm-f16/reference/input-1.npy --model-expected 0=%t.corpus/large-gemm-f16/reference/expected.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=10000 --target-model-max-fused-multiply-adds=10000 --target-model-max-movement-bytes=100000000 --target-model-max-movement-segments=100000 --target-model-numeric-policy=bulk-then-formal --target-model-bulk-record=%t.qualification/linear-record.json --target-model-max-bulk-total-bytes=100000000 --target-model-max-bulk-scratchpad-bytes=100000000 --target-model-max-bulk-reorder-bytes=100000000 2>&1 | FileCheck %s --check-prefix=MISSING
