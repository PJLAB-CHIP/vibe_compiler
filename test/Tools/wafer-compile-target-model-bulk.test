# RUN: %wafer_bulk_qualify --mode calibrate --spec %t.qualification/linear-calibration-spec.json --output %t.qualification/linear-calibration.json --formal-scalar-budget 100000 --formal-fma-budget 100000 --maximum-total-bytes 10000000 --maximum-scratchpad-bytes 10000000 --maximum-reorder-bytes 10000000
# RUN: %wafer_bulk_qualify --mode freeze --calibration %t.qualification/linear-calibration.json --held-out-spec %t.qualification/linear-held-spec.json --maximum-absolute-error 0.00001 --maximum-relative-error 0.00001 --output %t.qualification/linear-policy.json
# RUN: %wafer_bulk_qualify --mode validate --policy %t.qualification/linear-policy.json --output %t.qualification/linear-record.json --formal-scalar-budget 100000 --formal-fma-budget 100000 --maximum-total-bytes 10000000 --maximum-scratchpad-bytes 10000000 --maximum-reorder-bytes 10000000
# RUN: wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.formal --num-partitions=1 --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-input 1=%t.corpus/simple-gemm-f16/reference/input-1.npy --model-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=100000 --target-model-max-fused-multiply-adds=100000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 | FileCheck %s --check-prefix=FORMAL
# A source-wide qualification record must not be reused for the distinct
# Tile commands and payloads produced by card spatial mapping.
# RUN: wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.unmatched --num-partitions=1 --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-input 1=%t.corpus/simple-gemm-f16/reference/input-1.npy --model-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=100000 --target-model-max-fused-multiply-adds=100000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 --target-model-numeric-policy=bulk-then-formal --target-model-bulk-record=%t.qualification/linear-record.json --target-model-max-bulk-total-bytes=10000000 --target-model-max-bulk-scratchpad-bytes=10000000 --target-model-max-bulk-reorder-bytes=10000000 | FileCheck %s --check-prefix=UNMATCHED
# RUN: wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.managed-tensor --num-partitions=1 --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-input 1=%t.corpus/simple-gemm-f16/reference/input-1.npy --model-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=100000 --target-model-max-fused-multiply-adds=100000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 --target-model-numeric-policy=managed-reference --target-model-max-bulk-total-bytes=10000000 --target-model-max-bulk-scratchpad-bytes=10000000 --target-model-max-bulk-reorder-bytes=10000000 | FileCheck %s --check-prefix=MANAGED-TENSOR
