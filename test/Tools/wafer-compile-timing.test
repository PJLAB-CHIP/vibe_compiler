# REQUIRES: stablehlo, shardy, xla-spmd-helper

# RUN: rm -rf %t.input %t.default %t.timed %t.removed-preset %t.default.log %t.timed.log
# RUN: mkdir -p %t.input/functions
# RUN: printf '%b' 'module @timing {\n  func.func @main(%%arg0: tensor<32x32xf32>) -> tensor<32x32xf32> {\n    %%0 = stablehlo.add %%arg0, %%arg0 : tensor<32x32xf32>\n    return %%0 : tensor<32x32xf32>\n  }\n}\n' > %t.input/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[32,32],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[32,32],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":""}],"unused_inputs":[]}\n' > %t.input/functions/forward.meta

# Detailed timing is opt-in. The ordinary production transaction remains free
# of detailed events and tables.
# RUN: not wafer-compile --input-program-dir %t.input --output-program-dir %t.removed-preset --num-partitions=1 --launch-kind=kernel --optimization-preset=none 2>&1 | FileCheck %s --check-prefix=REMOVED-PRESET
# RUN: test ! -e %t.removed-preset
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.default --num-partitions=1 --launch-kind=kernel --optimization-policy=none 2>&1 | tee %t.default.log
# RUN: not grep -q 'compile-timing-' %t.default.log

# One source-to-package invocation exposes the card-program/physical-Tile seam,
# exact memory/target gates, MLIR passes/analyses, conversions/patterns, and
# internal algorithm phases. Numeric timings are deliberately not golden
# values. The retired rank-candidate search pipeline must not reappear.
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.timed --num-partitions=1 --launch-kind=kernel --optimization-policy=search --compile-timing 2>&1 | tee %t.timed.log | FileCheck %s --check-prefix=TIMING
# RUN: test -s %t.timed/modules/module_00000.so

# REMOVED-PRESET: wafer-compile: unknown argument: --optimization-preset=none

# TIMING: wafer-compile: compile-timing-summary-begin
# TIMING: wafer-compile: | kind | pipeline | item | calls | cumulative wall ms | cumulative CPU ms | average wall ms | max wall ms | failures |
# TIMING-DAG: wafer-compile: | stage | source-to-package | source-to-tensor-program | 1 |
# TIMING-DAG: wafer-compile: | stage | tensor-program-to-executable | whole-card-executable-synthesis | 1 |
# TIMING-DAG: wafer-compile: | conversion | whole-card-executable-synthesis | tensor-program-to-card-program | {{[1-9][0-9]*}} |
# TIMING-DAG: wafer-compile: | conversion | card-program-to-executable | card-program-to-physical-tiles | {{[1-9][0-9]*}} |
# TIMING-DAG: wafer-compile: | lowering-phase | tile-region-to-instr | full-conversion |
# TIMING-DAG: wafer-compile: | lowering-pattern | tile-region-to-instr | wafer.tile.load |
# TIMING-DAG: wafer-compile: | conversion | convertTensorProgramToTileRegionModuleInPlace | total |
# TIMING-DAG: wafer-compile: | conversion | tile-region-to-instr | region-conversion |
# TIMING-DAG: wafer-compile: | transformation | planSPMMemoryModule | total |
# TIMING-DAG: wafer-compile: | transformation | planDDRMemoryModule | total |
# TIMING-DAG: wafer-compile: | analysis | physical-tile-spm-planning | wafer::memory_planning::detail::StructuredTimelineAnalysis |
# TIMING-DAG: wafer-compile: | analysis | accepted-tile-ddr-planning | wafer::analysis::DirectCallGraphAnalysis |
# TIMING-DAG: wafer-compile: | conversion-phase | rewriteTensorProgramInPlace | TileRegionBodyEmitter::emit |
# TIMING-DAG: wafer-compile: | external-pipeline | source-to-tensor-program | xla-spmd-partitioning |
# TIMING-DAG: wafer-compile: | pass | stablehlo-to-linalg |
# TIMING-DAG: wafer-compile: | pass | instr-to-target-llvm |
# TIMING: wafer-compile: compile-timing-summary-end transaction_wall_ms={{[0-9]+\.[0-9][0-9][0-9]}}
# TIMING: wafer-compile: published verified package with num-partitions=1 physical-tiles=16:
