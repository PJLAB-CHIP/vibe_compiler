# REQUIRES: stablehlo, shardy, xla-spmd-helper

# RUN: rm -rf %t.input %t.default %t.timed %t.default.log %t.timed.log
# RUN: mkdir -p %t.input/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%arg0: tensor<4x8xf32>) -> tensor<8x4xf32> {\n    %%0 = "stablehlo.transpose"(%%arg0) {permutation = array<i64: 1, 0>} : (tensor<4x8xf32>) -> tensor<8x4xf32>\n    return %%0 : tensor<8x4xf32>\n  }\n}\n' > %t.input/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[4,8],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[8,4],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"input"}],"unused_inputs":[]}\n' > %t.input/functions/forward.meta

# Detailed timing is opt-in. The ordinary production transaction remains free
# of detailed events and tables.
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.default --execution-ranks=1 --launch-kind=kernel --optimization-preset=none 2>&1 | tee %t.default.log
# RUN: not grep -q 'compile-timing-' %t.default.log

# One source-to-package invocation exposes the complete-rank structured seam,
# exact memory/target gates, MLIR passes/analyses, conversions/patterns, and
# internal algorithm phases. Numeric timings are deliberately not golden
# values. The retired per-candidate lowering pipeline must not reappear.
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.timed --execution-ranks=1 --launch-kind=kernel --optimization-preset=production --compile-timing 2>&1 | tee %t.timed.log | FileCheck %s --check-prefix=TIMING
# RUN: test -s %t.timed/modules/module_00000.so

# TIMING: wafer-compile: compile-timing-summary-begin
# TIMING: wafer-compile: | kind | pipeline | item | calls | cumulative wall ms | cumulative CPU ms | average wall ms | max wall ms | failures |
# TIMING-DAG: wafer-compile: | stage | source-to-package | source-to-tensor-program | 1 |
# TIMING-DAG: wafer-compile: | stage | tensor-program-to-executable | coordinated-tile-frontier | 1 |
# TIMING-DAG: wafer-compile: | stage | tensor-program-to-executable | coordinated-executable-finalization | 1 |
# TIMING-DAG: wafer-compile: | search | coordinated-schedule-action | online-estimate-beam |
# TIMING-DAG: wafer-compile: | lowering-phase | tile-region-to-instr | full-conversion |
# TIMING-DAG: wafer-compile: | lowering-pattern | tile-region-to-instr | wafer.tile.load |
# TIMING-DAG: wafer-compile: | conversion | convertTensorProgramToTileRegionModuleInPlace | total |
# TIMING-DAG: wafer-compile: | conversion | tile-region-to-instr | module-conversion |
# TIMING-DAG: wafer-compile: | transformation | planSPMMemoryModule | total |
# TIMING-DAG: wafer-compile: | transformation | planDDRMemoryModule | total |
# TIMING-DAG: wafer-compile: | analysis-phase | planFunction(SPM) | StructuredTimeline::build |
# TIMING-DAG: wafer-compile: | conversion-phase | rewriteTensorProgramInPlace | TileRegionBodyEmitter::emit |
# TIMING-DAG: wafer-compile: | external-pipeline | source-to-tensor-program | xla-spmd-partitioning |
# TIMING-DAG: wafer-compile: | pass | stablehlo-to-linalg |
# TIMING-DAG: wafer-compile: | pass | coordinated-rank-preparation |
# TIMING-DAG: wafer-compile: | pass | instr-to-target-llvm |
# TIMING-NOT: wafer-compile: | search-phase | candidate-evaluation |
# TIMING-NOT: wafer-compile: | stage | tensor-program-to-executable | rank-candidate-generation |
# TIMING-NOT: wafer-compile: | search | rank-candidate-generation | rank-request-shard |
# TIMING: wafer-compile: compile-timing-summary-end transaction_wall_ms={{[0-9]+\.[0-9][0-9][0-9]}}
# TIMING: wafer-compile: published verified package with execution-ranks=1:
