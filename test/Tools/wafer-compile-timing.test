# REQUIRES: stablehlo, shardy, xla-spmd-helper

# RUN: rm -rf %t.input %t.default %t.timed %t.default.log %t.timed.log
# RUN: mkdir -p %t.input/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%arg0: tensor<4x8xf32>) -> tensor<8x4xf32> {\n    %%0 = "stablehlo.transpose"(%%arg0) {permutation = array<i64: 1, 0>} : (tensor<4x8xf32>) -> tensor<8x4xf32>\n    return %%0 : tensor<8x4xf32>\n  }\n}\n' > %t.input/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[4,8],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[8,4],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"input"}],"unused_inputs":[]}\n' > %t.input/functions/forward.meta

# Detailed timing is opt-in. The ordinary production transaction remains free
# of detailed events and tables.
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.default --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel --optimization-preset=none 2>&1 | tee %t.default.log
# RUN: not grep -q 'compile-timing-' %t.default.log

# One source-to-package invocation exposes orchestration, every configured
# optimization axis, MLIR passes/analyses, conversions/patterns, and internal
# algorithm phases. Numeric timings are deliberately not golden values.
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.timed --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel --optimization-preset=production --compile-timing 2>&1 | tee %t.timed.log | FileCheck %s --check-prefix=TIMING
# RUN: test -s %t.timed/modules/module_00000.so

