# REQUIRES: stablehlo

# RUN: rm -rf %t.compile.program && mkdir -p %t.compile.program/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%lhs: tensor<4x8xf16>, %%rhs: tensor<8x16xf16>) -> tensor<4x16xf16> {\n    %%0 = "stablehlo.dot_general"(%%lhs, %%rhs) {\n      dot_dimension_numbers = #stablehlo.dot<lhs_contracting_dimensions = [1], rhs_contracting_dimensions = [0]>,\n      precision_config = [#stablehlo<precision DEFAULT>, #stablehlo<precision DEFAULT>]\n    } : (tensor<4x8xf16>, tensor<8x16xf16>) -> tensor<4x16xf16>\n    return %%0 : tensor<4x16xf16>\n  }\n}\n' > %t.compile.program/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[4,8],"dtype":"float16","dynamic_dims":[]},{"shape":[8,16],"dtype":"float16","dynamic_dims":[]}],"output_signature":[{"shape":[4,16],"dtype":"float16","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"lhs"},{"type_":"input_arg","position":1,"name":"rhs"}],"unused_inputs":[]}\n' > %t.compile.program/functions/forward.meta
# RUN: wafer-compile-stablehlo --help | FileCheck %s --check-prefix=HELP
# RUN: not wafer-compile-stablehlo --partition-stablehlo-program %t.compile.program 2>&1 | FileCheck %s --check-prefix=NO-PARTITION
# RUN: not wafer-compile-stablehlo --output-package-dir %t.out 2>&1 | FileCheck %s --check-prefix=NO-OUTPUT-DIR
# RUN: not wafer-compile-stablehlo --xla-spmd-partitioner-helper %t.helper 2>&1 | FileCheck %s --check-prefix=NO-HELPER
# RUN: not wafer-compile-stablehlo --default-tile-count=16 2>&1 | FileCheck %s --check-prefix=NO-TILE-COUNT

# HELP-NOT: --propagate-stablehlo-sharding
# HELP-NOT: --partition-stablehlo-program
# HELP-NOT: --output-package-dir
# HELP-NOT: --xla-spmd-partitioner-helper
# HELP-NOT: --default-tile-count
# NO-PARTITION: wafer-compile-stablehlo: unknown argument: --partition-stablehlo-program
# NO-OUTPUT-DIR: wafer-compile-stablehlo: unknown argument: --output-package-dir
# NO-HELPER: wafer-compile-stablehlo: unknown argument: --xla-spmd-partitioner-helper
# NO-TILE-COUNT: wafer-compile-stablehlo: unknown argument: --default-tile-count=16
