# REQUIRES: stablehlo, shardy, xla-spmd-helper, numeric-model, systemc-model

# RUN: rm -rf %t.source %t.outputs %t.bad-output %t.a.npy %t.b.npy %t.c.npy %t.expected.npy %t.bad.npy
# RUN: mkdir -p %t.source/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%a: tensor<1024xf32>, %%b: tensor<1024xf32>, %%c: tensor<1024xf32>) -> tensor<1024xf32> {\n    %%ab = stablehlo.add %%a, %%b : tensor<1024xf32>\n    %%result = stablehlo.add %%ab, %%c : tensor<1024xf32>\n    return %%result : tensor<1024xf32>\n  }\n}\n' > %t.source/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[1024],"dtype":"float32","dynamic_dims":[]},{"shape":[1024],"dtype":"float32","dynamic_dims":[]},{"shape":[1024],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[1024],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"a"},{"type_":"input_arg","position":1,"name":"b"},{"type_":"input_arg","position":2,"name":"c"}],"unused_inputs":[]}\n' > %t.source/functions/forward.meta
# RUN: %python -c 'import numpy as np; a=np.arange(1024,dtype=np.float32); b=np.full(1024,2,dtype=np.float32); c=np.full(1024,3,dtype=np.float32); expected=a+b+c; bad=expected.copy(); bad[0]+=1; np.save("%t.a.npy",a); np.save("%t.b.npy",b); np.save("%t.c.npy",c); np.save("%t.expected.npy",expected); np.save("%t.bad.npy",bad)'

# This uses the same private selection seam as package qualification. The
# ordinary target-model gate consumes the exact accepted ExecutableBundle and
# TargetLLVMModuleBundle retained from publication; it does not rebuild a
# hand-mutated worker program.
# RUN: env WAFER_TEST_SELECT_WORKER_PLACEMENT=1 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.outputs --execution-ranks=1 --launch-kind=kernel --model-input 0=%t.a.npy --model-input 1=%t.b.npy --model-input 2=%t.c.npy --model-expected 0=%t.expected.npy --model-atol=0 --model-rtol=0 --model-report-numeric-statistics --target-model --target-model-max-scalar-evaluations=100000 --target-model-max-fused-multiply-adds=100000 --target-model-max-movement-bytes=1000000 --target-model-max-movement-segments=10000 | FileCheck %s
# RUN: not env WAFER_TEST_SELECT_WORKER_PLACEMENT=1 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.bad-output --execution-ranks=1 --launch-kind=kernel --model-input 0=%t.a.npy --model-input 1=%t.b.npy --model-input 2=%t.c.npy --model-expected 0=%t.bad.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=100000 --target-model-max-fused-multiply-adds=100000 --target-model-max-movement-bytes=1000000 --target-model-max-movement-segments=10000 2>&1 | FileCheck %s --check-prefix=MISMATCH
# RUN: test -s %t.bad-output/manifest.json

# CHECK: wafer-compile: published verified package with execution-ranks=1:
# CHECK: wafer-compile: target model numeric statistics index=0 rank=0 dtype=f32 elements=1024 exact=1024 exact_fraction=1
# CHECK-SAME: mean_abs=0 p99_abs=0 p999_abs=0 max_abs=0 mean_ulp=0 p99_ulp=0 p999_ulp=0 max_ulp=0
# CHECK: wafer-compile: target model outputs matched; ranks=1 transactions=9
# CHECK-SAME: systemc_threads=
# CHECK-SAME: formal_commands=2 managed_reference_commands=0
# MISMATCH: wafer-compile: published verified package with execution-ranks=1:
# MISMATCH: wafer-compile: target model output differs at index 0 rank 0
# MISMATCH-NOT: target model outputs matched
