# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[16],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[16],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"input"}],"unused_inputs":[]}\n' > %t.input/functions/forward.meta

# Production selects the accepted reciprocal implementation. The public none
# preset keeps only the fully gated conservative baseline; the same semantic
# axis can also be disabled from production or enabled on top of none.
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/production --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel | FileCheck %s --check-prefix=PUBLISHED
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/baseline --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel --optimization-preset=none 2>&1 | FileCheck %s --check-prefixes=NONE-CONFIG,PUBLISHED
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/disabled-implementation --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel --disable-optimization=implementation-selection | FileCheck %s --check-prefix=PUBLISHED
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/only-implementation --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel --optimization-preset=none --enable-optimization=implementation-selection | FileCheck %s --check-prefix=PUBLISHED
