# REQUIRES: stablehlo, shardy, xla-spmd-helper

# RUN: rm -rf %t.input %t.outputs
# RUN: mkdir -p %t.input/functions %t.outputs
# RUN: printf '%b' 'module {\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%one = stablehlo.constant dense<1.000000e+00> : tensor<16xf32>\n    %%0 = stablehlo.divide %%one, %%arg0 : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.input/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[16],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[16],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"input"}],"unused_inputs":[]}\n' > %t.input/functions/forward.meta

# Default and explicit production are the same public policy. The only public
# A/B counterpart is the explicit none preset, which keeps the admitted
# conservative baseline without selecting individual implementation axes.
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/default-production --execution-ranks=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefixes=PRODUCTION-CONFIG,PUBLISHED
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/explicit-production --execution-ranks=1 --launch-kind=kernel --optimization-preset=production 2>&1 | FileCheck %s --check-prefixes=PRODUCTION-CONFIG,PUBLISHED
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/none --execution-ranks=1 --launch-kind=kernel --optimization-preset=none 2>&1 | FileCheck %s --check-prefixes=NONE-CONFIG,PUBLISHED
# RUN: test -s %t.outputs/default-production/modules/module_00000.so
# RUN: test -s %t.outputs/explicit-production/modules/module_00000.so
# RUN: test -s %t.outputs/none/modules/module_00000.so
# RUN: cmp -s %t.outputs/default-production/modules/module_00000.so %t.outputs/explicit-production/modules/module_00000.so

# The real StableHLO tensor-splat-one form lowers through Linalg and complete
# Tile materialization before implementation selection. Production must retain
# that typed SSA proof across the tiled extract_slice, while none preserves the
# ordinary division baseline.
# RUN: %wafer_src_root/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-nm --defined-only %t.outputs/default-production/modules/module_00000.so | FileCheck %s --check-prefix=PRODUCTION-RECIPROCAL
# RUN: %wafer_src_root/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-nm --defined-only %t.outputs/none/modules/module_00000.so | FileCheck %s --check-prefix=NONE-DIVISION

# The production binary still does not consume the private testing seam.
# RUN: env WAFER_TEST_SELECT_RESERVED_BASELINE=1 wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/production-with-env --execution-ranks=1 --launch-kind=kernel | FileCheck %s --check-prefix=PUBLISHED
# RUN: cmp -s %t.outputs/default-production/modules/module_00000.so %t.outputs/production-with-env/modules/module_00000.so

# The private reserved-baseline seam remains only for failure-isolation tests
# and cannot be combined with a failure injection.
# RUN: not env WAFER_TEST_SELECT_RESERVED_BASELINE=1 WAFER_TEST_FAIL_AFTER_LOGICAL_RANK=0 %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/private-conflicting --execution-ranks=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=PRIVATE-CONFLICT

# Invalid presets and both retired per-axis options fail before compilation or
# publication. The old spellings are ordinary unknown arguments, not hidden
# compatibility aliases.
# RUN: not wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/invalid-preset --execution-ranks=1 --launch-kind=kernel --optimization-preset=custom 2>&1 | FileCheck %s --check-prefix=INVALID-PRESET
# RUN: not wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/legacy-enable --execution-ranks=1 --launch-kind=kernel --enable-optimization=implementation-selection 2>&1 | FileCheck %s --check-prefix=LEGACY-ENABLE
# RUN: not wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/legacy-disable --execution-ranks=1 --launch-kind=kernel --disable-optimization=implementation-selection 2>&1 | FileCheck %s --check-prefix=LEGACY-DISABLE
# RUN: test ! -e %t.outputs/invalid-preset
# RUN: test ! -e %t.outputs/legacy-enable
# RUN: test ! -e %t.outputs/legacy-disable
# RUN: test ! -e %t.outputs/private-conflicting

# PRODUCTION-CONFIG: wafer-compile: optimization-policy=production
# NONE-CONFIG: wafer-compile: optimization-policy=none
# PRODUCTION-RECIPROCAL-NOT: wafer_tx81_elementwise_div_v3
# PRODUCTION-RECIPROCAL: wafer_tx81_elementwise_recip_v3
# PRODUCTION-RECIPROCAL-NOT: wafer_tx81_elementwise_div_v3
# NONE-DIVISION-NOT: wafer_tx81_elementwise_recip_v3
# NONE-DIVISION: wafer_tx81_elementwise_div_v3
# NONE-DIVISION-NOT: wafer_tx81_elementwise_recip_v3
# PUBLISHED: wafer-compile: published verified package with execution-ranks=1:
# INVALID-PRESET: wafer-compile: invalid --optimization-preset value: custom (expected production or none)
# LEGACY-ENABLE: wafer-compile: unknown argument: --enable-optimization=implementation-selection
# LEGACY-DISABLE: wafer-compile: unknown argument: --disable-optimization=implementation-selection
# PRIVATE-CONFLICT: wafer-compile: test-only reserved-baseline selection cannot be combined with failure injection
