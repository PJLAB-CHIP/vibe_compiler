# The production binary still does not consume the private testing seam.
# RUN: env WAFER_TEST_SELECT_RESERVED_BASELINE=1 wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/production-with-env --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel | FileCheck %s --check-prefix=PUBLISHED
# RUN: cmp -s %t.outputs/production/modules/module_00000.so %t.outputs/production-with-env/modules/module_00000.so

# The private reserved-baseline seam remains only for failure-isolation tests
# and cannot be combined with a failure injection.
# RUN: not env WAFER_TEST_SELECT_RESERVED_BASELINE=1 WAFER_TEST_FAIL_AFTER_LOGICAL_RANK=0 %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/private-conflicting --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=PRIVATE-CONFLICT

# Unknown, duplicate and conflicting axis specifications fail before
# compilation or publication.
# RUN: not wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/unknown --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel --enable-optimization=unknown-axis 2>&1 | FileCheck %s --check-prefix=UNKNOWN
# RUN: not wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/duplicate --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel --enable-optimization=implementation-selection --enable-optimization=implementation-selection 2>&1 | FileCheck %s --check-prefix=DUPLICATE
# RUN: not wafer-compile --input-program-dir %t.input --output-program-dir %t.outputs/conflicting --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel --enable-optimization=implementation-selection --disable-optimization=implementation-selection 2>&1 | FileCheck %s --check-prefix=CONFLICT
