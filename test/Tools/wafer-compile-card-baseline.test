# REQUIRES: stablehlo, shardy, xla-spmd-helper

# The conservative policy is a real source-to-package baseline, not a second
# lowering path.  Keep three small, independently attributable graphs here:
# an ordinary multi-op chain with explicit op boundaries, a 16-Tile spatial
# compute, and an exact cross-Tile transpose that must materialize peer
# communication.  The none policy must not report coupled operator fusion.

# RUN: rm -rf %t.chain %t.chain-package %t.gemm %t.gemm-package %t.cross %t.cross-package %t.cross-ir

# RUN: mkdir -p %t.chain/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%lhs: tensor<32x32xf16>, %%rhs: tensor<32x32xf16>) -> tensor<32x32xf16> {\n    %%sum = stablehlo.add %%lhs, %%rhs : tensor<32x32xf16>\n    %%result = stablehlo.multiply %%sum, %%rhs : tensor<32x32xf16>\n    return %%result : tensor<32x32xf16>\n  }\n}\n' > %t.chain/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[32,32],"dtype":"float16","dynamic_dims":[]},{"shape":[32,32],"dtype":"float16","dynamic_dims":[]}],"output_signature":[{"shape":[32,32],"dtype":"float16","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"lhs"},{"type_":"input_arg","position":1,"name":"rhs"}],"unused_inputs":[]}\n' > %t.chain/functions/forward.meta
# RUN: wafer-compile --input-program-dir %t.chain --output-program-dir %t.chain-package --num-partitions=1 --optimization-policy=none 2>&1 | FileCheck %s --check-prefix=CHAIN
# RUN: wafer-run --package-dir %t.chain-package --no-card | FileCheck %s --check-prefix=NO-CARD

# RUN: mkdir -p %t.gemm/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%lhs: tensor<32x32xf16>, %%rhs: tensor<32x32xf16>) -> tensor<32x32xf16> {\n    %%result = "stablehlo.dot_general"(%%lhs, %%rhs) {dot_dimension_numbers = #stablehlo.dot<lhs_contracting_dimensions = [1], rhs_contracting_dimensions = [0]>, precision_config = [#stablehlo<precision DEFAULT>, #stablehlo<precision DEFAULT>]} : (tensor<32x32xf16>, tensor<32x32xf16>) -> tensor<32x32xf16>\n    return %%result : tensor<32x32xf16>\n  }\n}\n' > %t.gemm/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[32,32],"dtype":"float16","dynamic_dims":[]},{"shape":[32,32],"dtype":"float16","dynamic_dims":[]}],"output_signature":[{"shape":[32,32],"dtype":"float16","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"lhs"},{"type_":"input_arg","position":1,"name":"rhs"}],"unused_inputs":[]}\n' > %t.gemm/functions/forward.meta
# RUN: wafer-compile --input-program-dir %t.gemm --output-program-dir %t.gemm-package --num-partitions=1 --optimization-policy=none 2>&1 | FileCheck %s --check-prefix=SPATIAL
# RUN: wafer-run --package-dir %t.gemm-package --no-card | FileCheck %s --check-prefix=NO-CARD

# RUN: mkdir -p %t.cross/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%lhs: tensor<32x32xf16>, %%rhs: tensor<32x32xf16>) -> (tensor<32x32xf16>, tensor<32x32xf16>) {\n    %%sum = stablehlo.add %%lhs, %%rhs : tensor<32x32xf16>\n    %%transposed = "stablehlo.transpose"(%%sum) {permutation = array<i64: 1, 0>} : (tensor<32x32xf16>) -> tensor<32x32xf16>\n    %%result = stablehlo.multiply %%transposed, %%transposed : tensor<32x32xf16>\n    return %%sum, %%result : tensor<32x32xf16>, tensor<32x32xf16>\n  }\n}\n' > %t.cross/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[32,32],"dtype":"float16","dynamic_dims":[]},{"shape":[32,32],"dtype":"float16","dynamic_dims":[]}],"output_signature":[{"shape":[32,32],"dtype":"float16","dynamic_dims":[]},{"shape":[32,32],"dtype":"float16","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"lhs"},{"type_":"input_arg","position":1,"name":"rhs"}],"unused_inputs":[]}\n' > %t.cross/functions/forward.meta
# RUN: wafer-compile --input-program-dir %t.cross --output-program-dir %t.cross-package --num-partitions=1 --optimization-policy=none --dump-compiler-ir %t.cross-ir 2>&1 | FileCheck %s --check-prefix=CROSS
# RUN: FileCheck %s --input-file=%t.cross-ir/instruction/tile_00000.mlir --check-prefix=CROSS-INSTR
# RUN: wafer-run --package-dir %t.cross-package --no-card --direct-dte-status-abi wafer-direct-dte-status --supports-host-watchdog | FileCheck %s --check-prefix=NO-CARD

# CHAIN-NOT: card-executable-search policy=none
# CHAIN: wafer-compile: card-executable-baseline-controller search_states=0 placement_enumeration=0 candidate_family=0
# CHAIN-SAME: full_compilations=1
# CHAIN: wafer-compile: card-executable-selection
# CHAIN-SAME: active_tiles=16
# CHAIN-SAME: peer_transfers=0
# CHAIN-SAME: actual_fused_edges=0
# CHAIN: wafer-compile: wrote verified package with num-partitions=1 tiles=16:

# SPATIAL: wafer-compile: card-executable-selection
# SPATIAL-SAME: active_tiles=16
# SPATIAL-SAME: peer_transfers=0
# SPATIAL-SAME: actual_fused_edges=0
# SPATIAL: wafer-compile: wrote verified package with num-partitions=1 tiles=16:

# CROSS-NOT: card-executable-search policy=none
# CROSS: wafer-compile: card-executable-baseline-controller search_states=0 placement_enumeration=0 candidate_family=0
# CROSS-SAME: full_compilations=1
# CROSS: wafer-compile: card-executable-selection
# CROSS-SAME: active_tiles=16
# CROSS-SAME: peer_transfers={{[1-9][0-9]*}}
# CROSS-SAME: peer_bytes={{[1-9][0-9]*}}
# CROSS-SAME: actual_fused_edges=0
# CROSS: wafer-compile: wrote verified package with num-partitions=1 tiles=16:

# CROSS-INSTR: wafer.instr.dte_recv
# CROSS-INSTR: wafer.instr.dte_send
# CROSS-INSTR: wafer.instr.dte_wait

# NO-CARD: package: id=0 cards=1 tiles=16
# NO-CARD: board_execution: false
