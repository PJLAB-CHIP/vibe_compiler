# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper

# RUN: rm -rf %t.input.program %t.compiled.program %t.compiler-ir
# RUN: env CPU_NUM_DEVICES=16 PJRT_DEVICE=CPU %importer_python %wafer_src_root/test/Tools/Inputs/wafer_pytorch_xla_capture.py --emit-hf-megatron-transformer-block --hf-config-json %wafer_src_root/test/Tools/Inputs/hf/tiny-random-llama-fp16-config.json --sequence-length 1 --output-program-dir %t.input.program
# RUN: FileCheck %s --input-file=%t.input.program/functions/forward.mlir --check-prefix=INPUT
# RUN: wafer-compile --input-program-dir %t.input.program --output-program-dir %t.compiled.program --execution-ranks=16 --launch-kind=kernel --dump-compiler-ir %t.compiler-ir
# RUN: %python -c 'import json,pathlib; root=pathlib.Path("%t.compiled.program"); manifest=json.loads((root/"manifest.json").read_text()); assert manifest["schema_version"]==7; assert manifest["target"]["identity"]=="wafer-tx81-single-card"; assert manifest["target"]["runtime_abi"]=="wafer-tx81-kernel-v3"; assert manifest["rank_count"]==len(manifest["entries"])==16; assert len(manifest["modules"])==1'
# RUN: %python -c 'import pathlib; root=pathlib.Path("%t.compiler-ir"); tile=sorted((root/"tile-dataflow").glob("rank_*.mlir")); instr=sorted((root/"instruction").glob("rank_*.mlir")); llvm=sorted((root/"target-llvm").glob("rank_*.ll")); expected=[f"rank_{rank:05d}" for rank in range(16)]; assert [p.stem for p in tile]==expected; assert [p.stem for p in instr]==expected; assert [p.stem for p in llvm]==expected; assert all(p.stat().st_size for p in [*tile,*instr,*llvm]); assert all("wafer.tile.region" in p.read_text() and "wafer.instr." not in p.read_text() for p in tile); assert "wafer.instr.gemm" in instr[0].read_text(); assert "wafer_tx81_gemm_" in llvm[0].read_text()'

# INPUT: func.func @main
# INPUT: mhlo.sharding = "{devices=
# INPUT: mhlo.sharding = "{replicated}"
