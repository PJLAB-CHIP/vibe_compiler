# RUN: FileCheck %s --input-file=%t.input.program/functions/forward.mlir --check-prefix=INPUT
# RUN: not wafer-compile --input-program-dir %t.input.program --output-program-dir %t.compiled.program --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=tx81-cluster-direct-dte-prepare-main-v1 2>&1 | FileCheck %s --check-prefix=PACKET

# INPUT: func.func @main
# INPUT: mhlo.sharding = "{devices=
# INPUT: mhlo.sharding = "{replicated}"

# The captured block has more than 15 pointer slots per rank. The qualified
# V5.6 cluster ABI therefore cannot carry its 16-row rank-major table in one
# C-INS packet; the full compiler chain must reach and preserve that target
# legality failure instead of weakening the hardware limit.
# PACKET: wafer-compile: target launch ABI verification failed: multi-tile rank-major argument table exceeds the qualified V5.6 packet limit
