# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper

# RUN: rm -rf %t.corpus %t.rank1 %t.rank16 %t.mismatch %t.bad-expected.npy
# RUN: env CPU_NUM_DEVICES=16 PJRT_DEVICE=CPU %importer_python %wafer_src_root/test/Tools/Inputs/wafer_pytorch_xla_capture.py --emit-workload-corpus --output-corpus-dir %t.corpus
# RUN: wafer-compile --input-program-dir %t.corpus/linear-residual-mlp-f32/program --output-program-dir %t.rank1 --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --reference-input 0=%t.corpus/linear-residual-mlp-f32/reference/input.npy --reference-expected 0=%t.corpus/linear-residual-mlp-f32/reference/expected.npy --reference-atol=1e-6 --reference-rtol=1e-5 | FileCheck %s --check-prefix=RANK1
# RUN: %python -c 'import json; from pathlib import Path; root=Path("%t.rank1"); manifest=json.loads((root/"manifest.json").read_text()); assert manifest["rank_count"]==1 and [x["rank"] for x in manifest["modules"]]==[0] and [x["rank"] for x in manifest["entries"]]==[0] and [x["rank"] for x in manifest["completions"]]==[0]; modules=list((root/"modules").glob("rank_*.so")); assert len(modules)==1 and all(path.read_bytes().startswith(b"\x7fELF") for path in modules)'
# RUN: wafer-run --package-dir %t.rank1 --entry-id 0 --no-card | FileCheck %s --check-prefix=NO-CARD-RANK1
# RUN: wafer-compile --input-program-dir %t.corpus/linear-residual-mlp-f32/program --output-program-dir %t.rank16 --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --reference-input 0=%t.corpus/linear-residual-mlp-f32/reference/input.npy --reference-expected 0=%t.corpus/linear-residual-mlp-f32/reference/expected.npy --reference-atol=1e-6 --reference-rtol=1e-5 | FileCheck %s --check-prefix=RANK16
# RUN: %python -c 'import json; from pathlib import Path; root=Path("%t.rank16"); manifest=json.loads((root/"manifest.json").read_text()); expected=list(range(16)); assert manifest["rank_count"]==16 and [x["rank"] for x in manifest["modules"]]==expected and [x["rank"] for x in manifest["entries"]]==expected and [x["rank"] for x in manifest["completions"]]==expected; modules=list((root/"modules").glob("rank_*.so")); assert len(modules)==16 and all(path.read_bytes().startswith(b"\x7fELF") for path in modules)'
# RUN: %python -c 'import subprocess; runs=[subprocess.run(["wafer-run", "--package-dir", "%t.rank16", "--entry-id", str(entry), "--no-card"], capture_output=True, text=True) for entry in range(16)]; assert all(run.returncode==0 and f"entry: {entry} rank={entry} symbol=main" in run.stdout and "board_execution: false" in run.stdout for entry, run in enumerate(runs))'
# RUN: %python -c 'import numpy as np; value=np.load("%t.corpus/linear-residual-mlp-f32/reference/expected.npy"); value.flat[0]+=1.0; np.save("%t.bad-expected.npy", value)'
# RUN: not wafer-compile --input-program-dir %t.corpus/linear-residual-mlp-f32/program --output-program-dir %t.mismatch --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --reference-input 0=%t.corpus/linear-residual-mlp-f32/reference/input.npy --reference-expected 0=%t.bad-expected.npy 2>&1 | FileCheck %s --check-prefix=MISMATCH
# RUN: test -s %t.mismatch/manifest.json
# RUN: test -s %t.mismatch/modules/rank_00000.so

# RANK1: wafer-compile: published verified package with execution-ranks=1:
# RANK1: wafer-compile: reference outputs matched
# NO-CARD-RANK1: package: id=0 schema=3 ranks=1
# NO-CARD-RANK1: entry: 0 rank=0 symbol=main
# NO-CARD-RANK1: board_execution: false
# RANK16: wafer-compile: published verified package with execution-ranks=16:
# RANK16: wafer-compile: reference outputs matched
# MISMATCH: wafer-compile: published verified package with execution-ranks=1:
# MISMATCH: wafer-compile: reference output mismatch at index 0 element 0:
