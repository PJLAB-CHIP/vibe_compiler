# REQUIRES: stablehlo

# RUN: wafer-import-model --help | FileCheck %s --check-prefix=HELP
# RUN: wafer-import-model --emit-static-reference-artifact | FileCheck %s --check-prefix=EMIT
# RUN: wafer-import-model --emit-static-reference-artifact > %t.static.mlir
# RUN: wafer-import-model --verify-import-result %t.static.mlir | FileCheck %s --check-prefix=VERIFY

# RUN: printf '%b' 'module attributes {"wafer.import.graph_break" = "python control flow escaped capture"} {}\n' > %t.graph-break.mlir
# RUN: not wafer-import-model --verify-import-result %t.graph-break.mlir 2>&1 | FileCheck %s --check-prefix=GRAPH

# RUN: printf '%b' 'module attributes {"wafer.import.eager_fallback" = "aten fallback remained in capture"} {}\n' > %t.eager-fallback.mlir
# RUN: not wafer-import-model --verify-import-result %t.eager-fallback.mlir 2>&1 | FileCheck %s --check-prefix=EAGER

# RUN: printf '%b' 'module {\n  func.func @unbounded_dynamic(%%arg0: tensor<?x4xf32>) -> tensor<?x4xf32> {\n    return %%arg0 : tensor<?x4xf32>\n  }\n}\n' > %t.dynamic.mlir
# RUN: not wafer-import-model --verify-import-result %t.dynamic.mlir 2>&1 | FileCheck %s --check-prefix=DYNAMIC

# RUN: printf '%b' 'module {\n  func.func @bounded_dynamic(%%arg0: tensor<?x4xf32> {wafer.frontend.dynamic_bounds = [8, 4]}) -> (tensor<?x4xf32> {wafer.frontend.dynamic_bounds = [8, 4]}) {\n    return %%arg0 : tensor<?x4xf32>\n  }\n}\n' > %t.bounded-dynamic.mlir
# RUN: wafer-import-model --verify-import-result %t.bounded-dynamic.mlir | FileCheck %s --check-prefix=VERIFY

# RUN: printf '%b' 'module {\n  func.func @bad_dynamic_bound(%%arg0: tensor<?x4xf32> {wafer.frontend.dynamic_bounds = [0, 4]}) -> tensor<?x4xf32> {\n    return %%arg0 : tensor<?x4xf32>\n  }\n}\n' > %t.bad-dynamic-bound.mlir
# RUN: not wafer-import-model --verify-import-result %t.bad-dynamic-bound.mlir 2>&1 | FileCheck %s --check-prefix=BAD-BOUND

# RUN: rm -rf %t.bundle && mkdir -p %t.bundle/functions %t.bundle/data
# RUN: printf '%b' 'module {\n  func.func @main(%%arg0: tensor<2x4xf32>) -> tensor<2x4xf32> {\n    return %%arg0 : tensor<2x4xf32>\n  }\n}\n' > %t.bundle/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[2,4],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[2,4],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"parameter","position":-1,"name":"weight"}],"unused_inputs":[]}\n' > %t.bundle/functions/forward.meta
# RUN: %python -c 'from pathlib import Path; Path("%t.bundle/data/weight").write_bytes(b"0" * 32)'
# RUN: wafer-import-model --verify-stablehlo-bundle %t.bundle | FileCheck %s --check-prefix=BUNDLE

# RUN: rm -rf %t.shards.bundle && mkdir -p %t.shards.bundle/functions %t.shards.bundle/parameter_shards/weight
# RUN: printf '%b' 'module attributes {"mhlo.spmd_parameters_shardings" = ""} {\n  func.func @main(%%arg0: tensor<1x4xf32>) -> tensor<1x4xf32> {\n    return %%arg0 : tensor<1x4xf32>\n  }\n}\n' > %t.shards.bundle/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[1,4],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[1,4],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"parameter","position":-1,"name":"weight"}],"unused_inputs":[]}\n' > %t.shards.bundle/functions/forward.meta
# RUN: printf '%b' '{"parameter_shards_version":2,"function":"forward","logical_rank_count":2,"parameters":[{"argument_index":0,"name":"weight","global_shape":[2,4],"local_shape":[1,4],"dtype":"float32","shards":[{"rank":0,"replica_id":0,"file":"parameter_shards/weight/rank_00000.npy","offsets":[0,0],"sizes":[1,4],"strides":[1,1]},{"rank":1,"replica_id":0,"file":"parameter_shards/weight/rank_00001.npy","offsets":[1,0],"sizes":[1,4],"strides":[1,1]}]}]}\n' > %t.shards.bundle/functions/forward.parameter_shards.json
# RUN: %python -c 'from pathlib import Path; Path("%t.shards.bundle/parameter_shards/weight/rank_00000.npy").write_bytes(b"0" * 16); Path("%t.shards.bundle/parameter_shards/weight/rank_00001.npy").write_bytes(b"0" * 16)'
# RUN: wafer-import-model --verify-stablehlo-bundle %t.shards.bundle | FileCheck %s --check-prefix=SHARD-BUNDLE

# RUN: rm -rf %t.missing-shards.bundle && mkdir -p %t.missing-shards.bundle && cp -R %t.shards.bundle/. %t.missing-shards.bundle
# RUN: rm %t.missing-shards.bundle/functions/forward.parameter_shards.json
# RUN: not wafer-import-model --verify-stablehlo-bundle %t.missing-shards.bundle 2>&1 | FileCheck %s --check-prefix=MISSING-SHARDS

# RUN: rm -rf %t.missing-shard-file.bundle && mkdir -p %t.missing-shard-file.bundle && cp -R %t.shards.bundle/. %t.missing-shard-file.bundle
# RUN: rm %t.missing-shard-file.bundle/parameter_shards/weight/rank_00001.npy
# RUN: not wafer-import-model --verify-stablehlo-bundle %t.missing-shard-file.bundle 2>&1 | FileCheck %s --check-prefix=MISSING-SHARD-FILE

# RUN: rm -rf %t.bad-shape.bundle && mkdir -p %t.bad-shape.bundle && cp -R %t.bundle/. %t.bad-shape.bundle
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[4,2],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[2,4],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"parameter","position":-1,"name":"weight"}],"unused_inputs":[]}\n' > %t.bad-shape.bundle/functions/forward.meta
# RUN: not wafer-import-model --verify-stablehlo-bundle %t.bad-shape.bundle 2>&1 | FileCheck %s --check-prefix=BUNDLE-SHAPE

# RUN: rm -rf %t.missing-data.bundle && mkdir -p %t.missing-data.bundle && cp -R %t.bundle/. %t.missing-data.bundle
# RUN: rm %t.missing-data.bundle/data/weight
# RUN: not wafer-import-model --verify-stablehlo-bundle %t.missing-data.bundle 2>&1 | FileCheck %s --check-prefix=BUNDLE-DATA

# HELP-NOT: --verify-spmd-bundle

# EMIT: module
# EMIT: func.func @wafer_import_static_reference
# EMIT: tensor<2x4xf32>
# EMIT: stablehlo.add

# VERIFY: wafer-import-model: verified frontend artifact

# GRAPH: wafer-import-model: graph break rejected
# GRAPH: python control flow escaped capture

# EAGER: wafer-import-model: eager fallback rejected
# EAGER: aten fallback remained in capture

# DYNAMIC: wafer-import-model: unbounded dynamic shape rejected
# DYNAMIC: func.func @unbounded_dynamic

# BAD-BOUND: wafer-import-model: invalid dynamic bound rejected
# BAD-BOUND: func.func @bad_dynamic_bound argument 0

# BUNDLE: wafer-import-model: verified StableHLO bundle parameters: 1
# BUNDLE: wafer-import-model: verified frontend artifact

# SHARD-BUNDLE: wafer-import-model: verified StableHLO bundle parameters: 1
# SHARD-BUNDLE: wafer-import-model: verified StableHLO bundle parameter shard bindings: 1
# SHARD-BUNDLE: wafer-import-model: verified frontend artifact

# MISSING-SHARDS: wafer-import-model: StableHLO bundle metadata rejected
# MISSING-SHARDS: partitioned StableHLO bundle is missing parameter shard bindings

# MISSING-SHARD-FILE: wafer-import-model: StableHLO bundle metadata rejected
# MISSING-SHARD-FILE: parameter shard file is missing

# BUNDLE-SHAPE: wafer-import-model: StableHLO bundle metadata rejected
# BUNDLE-SHAPE: shape mismatch for function argument 0

# BUNDLE-DATA: wafer-import-model: StableHLO bundle metadata rejected
# BUNDLE-DATA: parameter data file is missing: weight
