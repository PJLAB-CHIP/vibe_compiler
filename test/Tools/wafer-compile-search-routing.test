# REQUIRES: stablehlo, shardy, xla-spmd-helper

# Public search evaluates a bounded complete Q50 physical assignment through
# the shared executable gate while retaining the accepted baseline incumbent.
# This stays a small source-to-package/no-card routing gate; model-scale policy
# and performance profiling belong to Q52.

# RUN: rm -rf %t.source %t.package
# RUN: mkdir -p %t.source/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%lhs: tensor<8x8xf16>, %%rhs: tensor<8x8xf16>) -> tensor<8x8xf16> {\n    %%result = stablehlo.add %%lhs, %%rhs : tensor<8x8xf16>\n    return %%result : tensor<8x8xf16>\n  }\n}\n' > %t.source/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[8,8],"dtype":"float16","dynamic_dims":[]},{"shape":[8,8],"dtype":"float16","dynamic_dims":[]}],"output_signature":[{"shape":[8,8],"dtype":"float16","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"lhs"},{"type_":"input_arg","position":1,"name":"rhs"}],"unused_inputs":[]}\n' > %t.source/functions/forward.meta
# RUN: wafer-compile --input-program-dir %t.source --output-dir %t.package --num-partitions=1 --optimization-policy=search 2>&1 | FileCheck %s --check-prefix=SEARCH --implicit-check-not=card-executable-selection --implicit-check-not=compile-stats --implicit-check-not=compile-work
# RUN: wafer-run --package-dir %t.package --no-card | FileCheck %s --check-prefix=NO-CARD

# SEARCH: wafer-compile: card-executable-compilation outcome=accepted physical_tiles=16
# SEARCH: wafer-compile: wrote verified package with num-partitions=1 tiles=16:
# NO-CARD: package: id=0 cards=1 tiles=16
# NO-CARD: board_execution: false
