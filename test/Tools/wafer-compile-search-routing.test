# REQUIRES: stablehlo, shardy, xla-spmd-helper

# During the current-IR cutover both product policies stop at the
# DeviceExecutable boundary. Neither may enter old planning, actual memory or
# package publication, and neither may fall back to the other policy.

# RUN: rm -rf %t.source %t.search-package %t.none-package
# RUN: mkdir -p %t.source/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%lhs: tensor<2x1025x128xf16>, %%rhs: tensor<2x1025x128xf16>) -> tensor<2x1025x128xf16> {\n    %%result = stablehlo.add %%lhs, %%rhs : tensor<2x1025x128xf16>\n    return %%result : tensor<2x1025x128xf16>\n  }\n}\n' > %t.source/functions/forward.mlir
# RUN: %stablehlo_translate --serialize --target=1.7.1 %t.source/functions/forward.mlir -o %t.source/functions/forward.stablehlo.bc && rm %t.source/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[2,1025,128],"dtype":"float16","dynamic_dims":[]},{"shape":[2,1025,128],"dtype":"float16","dynamic_dims":[]}],"output_signature":[{"shape":[2,1025,128],"dtype":"float16","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"lhs"},{"type_":"input_arg","position":1,"name":"rhs"}],"unused_inputs":[]}\n' > %t.source/functions/forward.meta
# RUN: not wafer-compile --input-program-dir %t.source --output-dir %t.search-package --num-partitions=1 --optimization-policy=search --compile-timing 2>&1 | FileCheck %s --check-prefix=SEARCH
# RUN: test ! -e %t.search-package
# RUN: not wafer-compile --input-program-dir %t.source --output-dir %t.none-package --num-partitions=1 --optimization-policy=none 2>&1 | FileCheck %s --check-prefix=NONE
# RUN: test ! -e %t.none-package

# SEARCH: wafer-compile: optimization-policy=search
# SEARCH: wafer-compile: operation_not_supported: optimization-policy=search is unavailable while the current-IR executable pipeline is being rebuilt
# SEARCH-NOT: physical-search
# SEARCH-NOT: deterministic-device-executable-baseline
# SEARCH-NOT: actual-memory-target
# SEARCH-NOT: wrote verified package

# NONE: wafer-compile: optimization-policy=none
# NONE: wafer-compile: operation_not_supported: optimization-policy=none is unavailable while the current-IR executable pipeline is being rebuilt
# NONE-NOT: physical-search
# NONE-NOT: deterministic-device-executable-baseline
# NONE-NOT: actual-memory-target
# NONE-NOT: wrote verified package
