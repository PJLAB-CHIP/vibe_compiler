# MISSING-INPUT: wafer-compile: missing required --input-program-dir
# MISSING-OUTPUT: wafer-compile: missing required --output-program-dir
# MISSING-PARTITIONS: wafer-compile: missing required --num-partitions
# INVALID-PARTITIONS: wafer-compile: invalid --num-partitions value: not-an-integer
# OVERFLOW-PARTITIONS: wafer-compile: invalid --num-partitions value: 18446744073709551616
# MULTI-CARD-PARTITIONS: wafer-compile: num-partitions must be exactly 1 for the single-card compiler
# DUPLICATE-INPUT: wafer-compile: duplicate option: --input-program-dir
# DUPLICATE-TIMING: wafer-compile: duplicate option: --compile-timing
# RETIRED-POLICY: wafer-compile: invalid --optimization-policy value: production (expected search or none)
# DUPLICATE-OUTPUT: wafer-compile: duplicate option: --output-program-dir
# DUPLICATE-PARTITIONS: wafer-compile: duplicate option: --num-partitions
# DUPLICATE-PROFILE-PRODUCT: wafer-compile: duplicate option: --profile
# PROFILE-MODEL: wafer-compile: --profile cannot be combined with --target-model
# MISSING-LAUNCH: wafer-compile: missing required --launch-kind
# UNKNOWN-LAUNCH: wafer-compile: unknown runtime launch kind 'not-a-launch-kind'
# DUPLICATE-LAUNCH: wafer-compile: duplicate option: --launch-kind
# NO-HELPER: wafer-compile: no XLA SPMD partitioner helper configured
# MODEL-WITHOUT-TARGET: wafer-compile: model input/expected options require --target-model
