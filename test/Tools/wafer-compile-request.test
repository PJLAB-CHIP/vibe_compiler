# MISSING-INPUT: wafer-compile: missing required --input-program-dir
# MISSING-OUTPUT: wafer-compile: missing required --output-program-dir
# MISSING-RANKS: wafer-compile: missing required --execution-ranks
# INVALID-RANKS: wafer-compile: invalid --execution-ranks value: not-an-integer
# OVERFLOW-RANKS: wafer-compile: invalid --execution-ranks value: 18446744073709551616
# DUPLICATE-INPUT: wafer-compile: duplicate option: --input-program-dir
# DUPLICATE-OUTPUT: wafer-compile: duplicate option: --output-program-dir
# DUPLICATE-RANKS: wafer-compile: duplicate option: --execution-ranks
# DUPLICATE-PROFILE-PRODUCT: wafer-compile: duplicate option: --profile
# PROFILE-RANK1: wafer-compile: profile compilation requires execution-ranks=16
# PROFILE-MODEL: wafer-compile: --profile cannot be combined with --target-model
# MISSING-PROFILE: wafer-compile: missing required --target-profile
# UNKNOWN-PROFILE: wafer-compile: unknown target profile 'not-a-registered-profile'
# DUPLICATE-PROFILE: wafer-compile: duplicate option: --target-profile
# MISSING-LAUNCH: wafer-compile: missing required --launch-abi
# UNKNOWN-LAUNCH: wafer-compile: unknown target launch ABI 'not-a-registered-launch-abi'
# DUPLICATE-LAUNCH: wafer-compile: duplicate option: --launch-abi
# RANK1-GRID: wafer-compile: multi-tile target launch ABI requires execution-ranks=16
# NO-HELPER: wafer-compile: no XLA SPMD partitioner helper configured
# OLD-MESH-RANKS: wafer-compile: unknown argument: --execution-mesh-ranks=16
# OLD-HELPER: wafer-compile: unknown argument: --xla-spmd-partitioner-helper={{.*}}
# OLD-TILE-COUNT: wafer-compile: unknown argument: --default-tile-count=16
# OLD-PARTITION: wafer-compile: unknown argument: --partition-stablehlo-program
# OLD-REFERENCE-INPUT: wafer-compile: unknown argument: --reference-input
# OLD-MODEL-ORACLE: wafer-compile: unknown argument: --target-model-oracle=reference
# MODEL-WITHOUT-TARGET: wafer-compile: model input/expected options require --target-model
