# REQUIRES: stablehlo, shardy, xla-spmd-helper, numeric-model, systemc-model

# RUN: rm -rf %t.source %t.outputs %t.mock-spmd-helper %t.lhs.npy %t.rhs.npy %t.expected.npy
# RUN: mkdir -p %t.source/functions %t.outputs
# RUN: printf '%b' 'module {\n  func.func @main(%%lhs: tensor<524288xf32>, %%rhs: tensor<524288xf32>) -> tensor<524288xf32> {\n    %%add = stablehlo.add %%lhs, %%lhs : tensor<524288xf32>\n    %%mul = stablehlo.multiply %%rhs, %%rhs : tensor<524288xf32>\n    %%result = stablehlo.add %%add, %%mul : tensor<524288xf32>\n    return %%result : tensor<524288xf32>\n  }\n}\n' > %t.source/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[524288],"dtype":"float32","dynamic_dims":[]},{"shape":[524288],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[524288],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"lhs"},{"type_":"input_arg","position":1,"name":"rhs"}],"unused_inputs":[]}\n' > %t.source/functions/forward.meta
# RUN: %python -c 'import numpy as np; lhs=np.arange(524288,dtype=np.float32); rhs=np.full(524288,2,dtype=np.float32); np.save("%t.lhs.npy",lhs); np.save("%t.rhs.npy",rhs); np.save("%t.expected.npy",lhs+lhs+rhs*rhs)'
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nrank_count=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    --logical-rank-count) rank_count="$2"; shift 2 ;;\n    --entry-function) shift 2 ;;\n    *) shift ;;\n  esac\ndone\ntest "$rank_count" = 16\nrm -rf "$output"\nmkdir -p "$output"\ncp -R "$input/." "$output/"\nmodule="$output/functions/forward.mlir"\nsed -i "0,/^module {/s//module attributes {\\\"mhlo.spmd_parameters_shardings\\\" = \\\"\\\"} {/" "$module"\necho "{\\\"parameter_shards_version\\\":3,\\\"function\\\":\\\"forward\\\",\\\"logical_rank_count\\\":$rank_count,\\\"parameters\\\":[]}" > "$output/functions/forward.parameter_shards.json"\npython3 - "$output/functions/forward.meta" "$rank_count" <<PY\nimport json\nimport sys\npath = sys.argv[1]\nrank_count = int(sys.argv[2])\nwith open(path) as stream:\n    meta = json.load(stream)\nshape = [524288]\ndef binding(index_field, index):\n    ranks = [{\"rank\": rank, \"replica_id\": rank, \"offsets\": [0], \"sizes\": shape, \"strides\": [1]} for rank in range(rank_count)]\n    return {index_field: index, \"distribution\": \"replicated\", \"global_shape\": shape, \"local_shape\": shape, \"dtype\": \"float32\", \"ranks\": ranks}\nmeta[\"distributed_boundary\"] = {\"version\": 1, \"logical_rank_count\": rank_count, \"inputs\": [binding(\"argument_index\", 0), binding(\"argument_index\", 1)], \"outputs\": [binding(\"result_index\", 0)]}\nwith open(path, \"w\") as stream:\n    json.dump(meta, stream)\nPY\n' > %t.mock-spmd-helper
# RUN: chmod +x %t.mock-spmd-helper

# The private selector can only retain one fully accepted tuple whose current
# instruction IR simultaneously proves actual Direct DTE on every rank and
# both directions across the tuple, static fixed slots, and disjoint
# multi-worker placement.
# RUN: env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-spmd-helper WAFER_TEST_SELECT_NOC_RESIDENT_FIXED_SLOT_WORKER=1 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.outputs/qualified --execution-ranks=16 --launch-kind=kernel --model-input 0=%t.lhs.npy --model-input 1=%t.rhs.npy --model-expected 0=%t.expected.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=50000000 --target-model-max-fused-multiply-adds=50000000 --target-model-max-movement-bytes=400000000 --target-model-max-movement-segments=4000000 | FileCheck %s --check-prefix=QUALIFIED
# RUN: %python -c 'import hashlib,json,pathlib; p=pathlib.Path("%t.outputs/qualified"); m=json.loads((p/"manifest.json").read_text()); q=pathlib.Path(str(p)+".qualification"); ab=(q/"attestation.json").read_bytes(); a=json.loads(ab); act=json.loads((q/"activation.json").read_text()); manifest_digest="sha256:"+hashlib.sha256((p/"manifest.json").read_bytes()).hexdigest(); attestation_digest="sha256:"+hashlib.sha256(ab).hexdigest(); assert m["schema_version"]==7 and m["rank_count"]==16 and m["target"]["identity"]=="wafer-tx81-single-card"; assert [entry["transport"]["kind"] for entry in m["entries"]]==["direct_dte"]*16; assert a["schema"]=="wafer-static-fixed-slot-qualification" and a["schema_version"]==1 and a["selection_kind"]=="static-fixed-slot"; assert a["target"]=={"identity": "wafer-tx81-single-card","rank_count":16,"logical_ranks":list(range(16))}; assert a["manifest_sha256"]==act["manifest_sha256"]==manifest_digest and act["attestation_sha256"]==attestation_digest; assert all(r["static_loops"] and [edge for loop in r["static_loops"] for edge in loop["spm_iter_arg_rotations"]] for r in a["ranks"]); assert {issue["kind"] for r in a["ranks"] for issue in r["dte"]["issues"]}=={"send","recv"}; assert all(r["dte"]["token_count"]==len(r["dte"]["issues"])>0 and sorted(token for wait in r["dte"]["waits"] for token in wait["tokens"])==list(range(r["dte"]["token_count"])) for r in a["ranks"]); assert all(len({issue["worker"] for issue in r["engine_worker_issues"]})>=2 and any(issue["worker"]!=0 for issue in r["engine_worker_issues"]) for r in a["ranks"])'
# RUN: %python -c 'import json,pathlib,re,subprocess; p=pathlib.Path("%t.outputs/qualified"); m=json.loads((p/"manifest.json").read_text()); tool="%wafer_src_root/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-objdump"; inspector="%wafer_src_root/test/Tools/Inputs/inspect_tx81_worker_calls.py"; outputs=[subprocess.run(["%python",inspector,"--objdump",tool,"--elf",str(p/module["path"])],check=True,text=True,capture_output=True).stdout for module in m["modules"]]; values=lambda text:[int(v) for line in text.splitlines() if " workers=" in line for v in line.split("=",1)[1].split(",") if v]; assert outputs and all(len(set(values(text)))>=2 and any(worker!=0 for worker in values(text)) for text in outputs),outputs'
# RUN: %python %wafer_src_root/test/Board/wafer_board_engine_pipeline_characterization_test.py --mode production-gate --production-package %t.outputs/qualified --require-production-ready | FileCheck %s --check-prefix=PRODUCTION-GATE
# RUN: wafer-run --package-dir %t.outputs/qualified --all-ranks --no-card --direct-dte-status-abi wafer-direct-dte-status-v2 --supports-host-watchdog | FileCheck %s --check-prefix=NO-CARD

# The production executable ignores the private environment seam.
# RUN: env WAFER_TEST_SELECT_NOC_RESIDENT_FIXED_SLOT_WORKER=1 wafer-compile --input-program-dir %t.source --output-program-dir %t.outputs/production --execution-ranks=1 --launch-kind=kernel | FileCheck %s --check-prefix=PUBLISHED
# RUN: test ! -e %t.outputs/production.qualification

# Private selection is exclusive, cannot combine with failure injection, and
# atomically refuses a caller-owned qualification companion.
# RUN: not env WAFER_TEST_SELECT_NOC_RESIDENT_FIXED_SLOT_WORKER=1 WAFER_TEST_SELECT_STATIC_FIXED_SLOT=1 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.outputs/mutually-exclusive --execution-ranks=16 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=MUTUALLY-EXCLUSIVE
# RUN: test ! -e %t.outputs/mutually-exclusive
# RUN: not env WAFER_TEST_SELECT_NOC_RESIDENT_FIXED_SLOT_WORKER=1 WAFER_TEST_FAIL_AFTER_LOGICAL_RANK=0 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.outputs/conflicting --execution-ranks=16 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=CONFLICT
# RUN: test ! -e %t.outputs/conflicting
# RUN: test ! -e %t.outputs/conflicting.qualification
# RUN: mkdir %t.outputs/existing.qualification
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-spmd-helper WAFER_TEST_SELECT_NOC_RESIDENT_FIXED_SLOT_WORKER=1 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.outputs/existing --execution-ranks=16 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=EXISTING
# RUN: test ! -e %t.outputs/existing
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'

# QUALIFIED: wafer-compile: published verified package with execution-ranks=16:
# QUALIFIED: wafer-compile: target model outputs matched; ranks=16 transactions=
# PUBLISHED: wafer-compile: published verified package with execution-ranks=1:
# PRODUCTION-GATE: production_pipeline_preparation: {{.*}}"ready": true
# NO-CARD: package: id=0 schema=7 ranks=16
# NO-CARD: board_execution: false
# MUTUALLY-EXCLUSIVE: wafer-compile: test-only whole-variant selections are mutually exclusive
# CONFLICT: wafer-compile: test-only NoC-resident fixed-slot worker qualification cannot be combined with failure injection
# EXISTING: wafer-compile: refusing to replace existing fixed-slot qualification companion directory
