# RUN: rm %t.missing-shard-file.program/parameter_shards/weight/rank_00001.npy
# RUN: not wafer-compile-stablehlo --verify-stablehlo-program %t.missing-shard-file.program 2>&1 | FileCheck %s --check-prefix=MISSING-SHARD-FILE

# RUN: rm -rf %t.bad-shape.program && mkdir -p %t.bad-shape.program && cp -R %t.program/. %t.bad-shape.program
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[4,2],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[2,4],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"parameter","position":-1,"name":"weight"}],"unused_inputs":[]}\n' > %t.bad-shape.program/functions/forward.meta
# RUN: not wafer-compile-stablehlo --verify-stablehlo-program %t.bad-shape.program 2>&1 | FileCheck %s --check-prefix=PROGRAM-SHAPE

