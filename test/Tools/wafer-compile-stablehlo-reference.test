# REQUIRES: stablehlo

# RUN: wafer-compile-stablehlo --help | FileCheck %s --check-prefix=HELP
# RUN: printf '%b' 'module {\n  func.func @frontend_verifier_smoke(%%arg0: tensor<2x4xf32>, %%arg1: tensor<2x4xf32>) -> tensor<2x4xf32> {\n    %%0 = stablehlo.add %%arg0, %%arg1 : tensor<2x4xf32>\n    return %%0 : tensor<2x4xf32>\n  }\n}\n' > %t.verify.mlir
# RUN: wafer-compile-stablehlo --verify-frontend-program %t.verify.mlir | FileCheck %s --check-prefix=VERIFY

# RUN: printf '%b' 'module attributes {"wafer.import.graph_break" = "python control flow escaped capture"} {}\n' > %t.graph-break.mlir
# RUN: not wafer-compile-stablehlo --verify-frontend-program %t.graph-break.mlir 2>&1 | FileCheck %s --check-prefix=GRAPH

# RUN: printf '%b' 'module attributes {"wafer.import.eager_fallback" = "aten fallback remained in capture"} {}\n' > %t.eager-fallback.mlir
# RUN: not wafer-compile-stablehlo --verify-frontend-program %t.eager-fallback.mlir 2>&1 | FileCheck %s --check-prefix=EAGER

# RUN: printf '%b' 'module {\n  func.func @unbounded_dynamic(%%arg0: tensor<?x4xf32>) -> tensor<?x4xf32> {\n    return %%arg0 : tensor<?x4xf32>\n  }\n}\n' > %t.dynamic.mlir
# RUN: not wafer-compile-stablehlo --verify-frontend-program %t.dynamic.mlir 2>&1 | FileCheck %s --check-prefix=DYNAMIC

# RUN: printf '%b' 'module {\n  func.func @bounded_dynamic(%%arg0: tensor<?x4xf32> {wafer.frontend.dynamic_bounds = [8, 4]}) -> (tensor<?x4xf32> {wafer.frontend.dynamic_bounds = [8, 4]}) {\n    return %%arg0 : tensor<?x4xf32>\n  }\n}\n' > %t.bounded-dynamic.mlir
# RUN: wafer-compile-stablehlo --verify-frontend-program %t.bounded-dynamic.mlir | FileCheck %s --check-prefix=VERIFY

# RUN: printf '%b' 'module {\n  func.func @bad_dynamic_bound(%%arg0: tensor<?x4xf32> {wafer.frontend.dynamic_bounds = [0, 4]}) -> tensor<?x4xf32> {\n    return %%arg0 : tensor<?x4xf32>\n  }\n}\n' > %t.bad-dynamic-bound.mlir
# RUN: not wafer-compile-stablehlo --verify-frontend-program %t.bad-dynamic-bound.mlir 2>&1 | FileCheck %s --check-prefix=BAD-BOUND

# RUN: rm -rf %t.program && mkdir -p %t.program/functions %t.program/data
# RUN: printf '%b' 'module {\n  func.func @main(%%arg0: tensor<2x4xf32>) -> tensor<2x4xf32> {\n    return %%arg0 : tensor<2x4xf32>\n  }\n}\n' > %t.program/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[2,4],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[2,4],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"parameter","position":-1,"name":"weight"}],"unused_inputs":[]}\n' > %t.program/functions/forward.meta
# RUN: %python -c 'import numpy as np; from pathlib import Path; p = Path("%t.program/data/weight"); f = p.open("wb"); np.save(f, np.zeros((2, 4), dtype=np.float32)); f.close()'
# RUN: wafer-compile-stablehlo --verify-stablehlo-program %t.program | FileCheck %s --check-prefix=PROGRAM

# RUN: rm -rf %t.shards.program && mkdir -p %t.shards.program/functions %t.shards.program/parameter_shards/weight
# RUN: printf '%b' 'module attributes {"mhlo.spmd_parameters_shardings" = ""} {\n  wafer.target.topology @default {card_grid = array<i64: 1, 1>, card_interconnect = "mesh", tile_grid = array<i64: 1, 2>, unavailable_tiles = array<i64>}\n  wafer.execution.mesh @default_mesh {topology = @default, axes = ["rank"], shape = array<i64: 2>, policy = "all_available", endpoints = array<i64>}\n  func.func @main(%%arg0: tensor<1x4xf32>) -> tensor<1x4xf32> {\n    return %%arg0 : tensor<1x4xf32>\n  }\n}\n' > %t.shards.program/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[1,4],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[1,4],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"parameter","position":-1,"name":"weight"}],"unused_inputs":[]}\n' > %t.shards.program/functions/forward.meta
# RUN: printf '%b' '{"parameter_shards_version":2,"function":"forward","logical_rank_count":2,"parameters":[{"argument_index":0,"name":"weight","global_shape":[2,4],"local_shape":[1,4],"dtype":"float32","shards":[{"rank":0,"replica_id":0,"file":"parameter_shards/weight/rank_00000.npy","offsets":[0,0],"sizes":[1,4],"strides":[1,1]},{"rank":1,"replica_id":0,"file":"parameter_shards/weight/rank_00001.npy","offsets":[1,0],"sizes":[1,4],"strides":[1,1]}]}]}\n' > %t.shards.program/functions/forward.parameter_shards.json
# RUN: %python -c 'import numpy as np; from pathlib import Path; np.save(Path("%t.shards.program/parameter_shards/weight/rank_00000.npy"), np.zeros((1, 4), dtype=np.float32)); np.save(Path("%t.shards.program/parameter_shards/weight/rank_00001.npy"), np.zeros((1, 4), dtype=np.float32))'
# RUN: wafer-compile-stablehlo --verify-stablehlo-program %t.shards.program | FileCheck %s --check-prefix=SHARD-PROGRAM

