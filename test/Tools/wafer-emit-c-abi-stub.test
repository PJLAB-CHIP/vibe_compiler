# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-single-tile-matmul > %t.manifest.json
# RUN: %python %wafer_src_root/tools/wafer_emit_c_abi_stub.py --manifest %t.manifest.json | FileCheck %s
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-single-tile-elementwise > %t.elementwise.json
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --validate %t.elementwise.json
# RUN: %python %wafer_src_root/tools/wafer_emit_c_abi_stub.py --manifest %t.elementwise.json > %t.elementwise.c
# RUN: cc -fsyntax-only %t.elementwise.c
# RUN: FileCheck %s --check-prefix=ELT < %t.elementwise.c
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-local-transformer-block > %t.block.json
# RUN: %python %wafer_src_root/tools/wafer_emit_c_abi_stub.py --manifest %t.block.json > %t.block.c
# RUN: cc -fsyntax-only %t.block.c
# RUN: FileCheck %s --check-prefix=BLOCK < %t.block.c

