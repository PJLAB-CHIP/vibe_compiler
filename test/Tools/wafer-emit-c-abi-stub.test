# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-m0-smoke > %t.manifest.json
# RUN: %python %wafer_src_root/tools/wafer_emit_c_abi_stub.py --manifest %t.manifest.json | FileCheck %s
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-elementwise-smoke > %t.elementwise.json
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --validate %t.elementwise.json
# RUN: %python %wafer_src_root/tools/wafer_emit_c_abi_stub.py --manifest %t.elementwise.json > %t.elementwise.c
# RUN: cc -fsyntax-only %t.elementwise.c
# RUN: FileCheck %s --check-prefix=ELT < %t.elementwise.c
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-m6-local-smoke > %t.m6.json
# RUN: %python %wafer_src_root/tools/wafer_emit_c_abi_stub.py --manifest %t.m6.json > %t.m6.c
# RUN: cc -fsyntax-only %t.m6.c
# RUN: FileCheck %s --check-prefix=M6 < %t.m6.c

