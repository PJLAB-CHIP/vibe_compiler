# REQUIRES: stablehlo, shardy, xla-spmd-helper

# This bounded timing probe uses FP16 ports as raw diagnostic containers.
# Numerical comparison is intentionally absent; the DTE path retains the
# current cluster prepare/status ABI, two guarded buffers and exact waits.
# RUN: rm -rf %t.clock %t.dte %t.sync %t.combined
# RUN: %python %S/../Board/Support/wafer_board_dte_latency.py --work-dir %t.clock --wafer-compile %wafer_compile_test --wafer-run %wafer_obj_root/bin/wafer-run --llvm-clangxx clang++ --clock-cycles 2000000 --no-card | FileCheck %s --check-prefix=CLOCK
# RUN: %python %S/../Board/Support/wafer_board_dte_latency.py --work-dir %t.dte --wafer-compile %wafer_compile_test --wafer-run %wafer_obj_root/bin/wafer-run --llvm-clangxx clang++ --payload-bytes 8192 --no-card | FileCheck %s --check-prefix=DTE
# RUN: %python %S/../Board/Support/wafer_board_dte_latency.py --work-dir %t.sync --wafer-compile %wafer_compile_test --wafer-run %wafer_obj_root/bin/wafer-run --llvm-clangxx clang++ --payload-bytes 8192 --ncc-sync --no-card | FileCheck %s --check-prefix=SYNC
# RUN: %python %S/../Board/Support/wafer_board_dte_latency.py --work-dir %t.combined --wafer-compile %wafer_compile_test --wafer-run %wafer_obj_root/bin/wafer-run --llvm-clangxx clang++ --payload-bytes 8192 --ncc-sync --ncc-participants 3 --no-card | FileCheck %s --check-prefix=COMBINED

# CLOCK: latency_no_card: cycles=2000000 payload=2048 tiles=16
# DTE: latency_no_card: cycles=0 payload=8192 tiles=16
# SYNC: latency_no_card: cycles=0 payload=8192 tiles=16 ncc_sync=True
# COMBINED: latency_no_card: cycles=0 payload=8192 tiles=16 ncc_sync=True participants=3

# Host-only bounded oracle for the summary used to derive the cost priors.
# RUN: %python -c "import sys; sys.path.insert(0, r'%S/../Board/Support'); import wafer_board_latency_summary as summary; assert summary.distribution([10, 1, 3, 2], 0.5) == dict(samples=4, median_ns=1.25, p90_ns=5, min_ns=0.5, max_ns=5); print('latency_summary: scaled median and tail verified')" | FileCheck %s --check-prefix=SUMMARY
# SUMMARY: latency_summary: scaled median and tail verified
