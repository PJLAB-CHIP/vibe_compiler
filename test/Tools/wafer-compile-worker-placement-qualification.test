# REQUIRES: stablehlo, shardy, xla-spmd-helper

# RUN: rm -rf %t.source %t.outputs
# RUN: mkdir -p %t.source/functions %t.outputs
# RUN: printf '%b' 'module {\n  func.func @main(%%a: tensor<1024xf32>, %%b: tensor<1024xf32>, %%c: tensor<1024xf32>) -> tensor<1024xf32> {\n    %%ab = stablehlo.add %%a, %%b : tensor<1024xf32>\n    %%result = stablehlo.add %%ab, %%c : tensor<1024xf32>\n    return %%result : tensor<1024xf32>\n  }\n}\n' > %t.source/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[1024],"dtype":"float32","dynamic_dims":[]},{"shape":[1024],"dtype":"float32","dynamic_dims":[]},{"shape":[1024],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[1024],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"a"},{"type_":"input_arg","position":1,"name":"b"},{"type_":"input_arg","position":2,"name":"c"}],"unused_inputs":[]}\n' > %t.source/functions/forward.meta

# The private qualification mode chooses an exact-admitted typed worker sibling
# from the coordinated executable frontier; every source, target, publication
# and canonical readback gate remains the ordinary transaction.
# RUN: env WAFER_TEST_SELECT_WORKER_PLACEMENT=1 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.outputs/qualified --execution-ranks=1 --launch-kind=kernel | FileCheck %s --check-prefix=PUBLISHED
# RUN: %python -c 'import json,pathlib; p=pathlib.Path("%t.outputs/qualified"); m=json.loads((p/"manifest.json").read_text()); assert m["schema_version"]==7 and m["rank_count"]==1 and m["target"]["identity"]=="wafer-tx81-single-card"; assert len(m["modules"])==len(m["entries"])==len(m["completions"])==1; assert (p/m["modules"][0]["path"]).read_bytes().startswith(b"\x7fELF")'
# RUN: %python -c 'import pathlib,re,subprocess; p=pathlib.Path("%t.outputs/qualified/modules/module_00000.so"); d=subprocess.run(["%wafer_src_root/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-objdump","-dr",str(p)],check=True,text=True,capture_output=True).stdout; count=lambda name:len(re.findall(r"\b(?:jal|j)\s+[^\n]*<"+re.escape(name)+r">",d)); counts={name:count(name) for name in ("wafer_tx81_rdma_v3","wafer_tx81_wdma_v3","wafer_tx81_elementwise_add_v3","wafer_tx81_ncc_join")}; assert all(value>0 for value in counts.values()),(counts,d)'
# RUN: %python -c 'import subprocess; out=subprocess.run(["%python","%wafer_src_root/test/Tools/Inputs/inspect_tx81_worker_calls.py","--objdump","%wafer_src_root/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-objdump","--elf","%t.outputs/qualified/modules/module_00000.so"],check=True,text=True,capture_output=True).stdout; workers=[int(v) for line in out.splitlines() if " workers=" in line for v in line.split("=",1)[1].split(",") if v]; assert len(set(workers))>=2 and any(worker!=0 for worker in workers),(workers,out)'
# RUN: wafer-run --package-dir %t.outputs/qualified --all-ranks --no-card | FileCheck %s --check-prefix=NO-CARD

# The production executable cannot consume the private environment seam.
# RUN: env WAFER_TEST_SELECT_WORKER_PLACEMENT=1 wafer-compile --input-program-dir %t.source --output-program-dir %t.outputs/production --execution-ranks=1 --launch-kind=kernel | FileCheck %s --check-prefix=PUBLISHED
# RUN: wafer-run --package-dir %t.outputs/production --all-ranks --no-card | FileCheck %s --check-prefix=NO-CARD

# RUN: not env WAFER_TEST_SELECT_WORKER_PLACEMENT=1 WAFER_TEST_FAIL_AFTER_LOGICAL_RANK=0 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.outputs/conflicting --execution-ranks=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=CONFLICT
# RUN: test ! -e %t.outputs/conflicting
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'

# PUBLISHED: wafer-compile: published verified package with execution-ranks=1:
# NO-CARD: package: id=0 schema=7 ranks=1
# NO-CARD: board_execution: false
# CONFLICT: wafer-compile: test-only worker-placement qualification cannot be combined with failure injection
