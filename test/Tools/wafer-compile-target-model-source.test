# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper, numeric-model, systemc-model

# RUN: rm -rf %t.corpus %t.f16 %t.bf16 %t.llama %t.late-model %t.bad %t.bad.npy %t.model-cli
# RUN: env CPU_NUM_DEVICES=16 PJRT_DEVICE=CPU %importer_python %wafer_src_root/test/Tools/Inputs/wafer_pytorch_xla_capture.py --emit-workload-corpus --corpus-case simple-gemm-f16 --corpus-case simple-gemm-bf16 --corpus-case tiny-llama-decoder-f32 --output-corpus-dir %t.corpus --verify-corpus-reproducibility
# RUN: wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.f16 --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-input 1=%t.corpus/simple-gemm-f16/reference/input-1.npy --model-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy --model-atol=0 --model-rtol=0 --model-report-numeric-statistics --target-model --target-model-max-scalar-evaluations=10000 --target-model-max-fused-multiply-adds=10000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 | FileCheck %s --check-prefix=F16
# RUN: wafer-compile --input-program-dir %t.corpus/simple-gemm-bf16/program --output-program-dir %t.bf16 --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 --model-input 0=%t.corpus/simple-gemm-bf16/reference/input.npy --model-input 1=%t.corpus/simple-gemm-bf16/reference/input-1.npy --model-expected 0=%t.corpus/simple-gemm-bf16/reference/expected.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=10000 --target-model-max-fused-multiply-adds=10000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 | FileCheck %s --check-prefix=BF16
# RUN: not wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.model-cli --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 --target-model --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy 2>&1 | FileCheck %s --check-prefix=MODEL-MISSING
# RUN: not wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.model-cli --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 --target-model --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy 2>&1 | FileCheck %s --check-prefix=MODEL-DUPLICATE
# RUN: not wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.model-cli --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 --target-model --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy --model-atol=-1 2>&1 | FileCheck %s --check-prefix=MODEL-TOLERANCE
# RUN: wafer-compile --input-program-dir %t.corpus/tiny-llama-decoder-f32/program --output-program-dir %t.llama --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 --model-input 0=%t.corpus/tiny-llama-decoder-f32/reference/input.npy --model-expected 0=%t.corpus/tiny-llama-decoder-f32/reference/expected.npy --model-atol=5e-4 --model-rtol=1e-4 --target-model --target-model-max-scalar-evaluations=1000000 --target-model-max-fused-multiply-adds=1000000 --target-model-max-movement-bytes=100000000 --target-model-max-movement-segments=1000000 | FileCheck %s --check-prefix=LLAMA
# RUN: not env WAFER_TEST_FAIL_TARGET_MODEL_TERMINAL_RANK=15 %wafer_compile_test --input-program-dir %t.corpus/tiny-llama-decoder-f32/program --output-program-dir %t.late-model --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 --model-input 0=%t.corpus/tiny-llama-decoder-f32/reference/input.npy --model-expected 0=%t.corpus/tiny-llama-decoder-f32/reference/expected.npy --model-atol=5e-4 --model-rtol=1e-4 --target-model --target-model-max-scalar-evaluations=1000000 --target-model-max-fused-multiply-adds=1000000 --target-model-max-movement-bytes=100000000 --target-model-max-movement-segments=1000000 2>&1 | FileCheck %s --check-prefix=LATE-MODEL
# RUN: test -s %t.late-model/manifest.json
# RUN: test -s %t.late-model/modules/rank_00015.so
# RUN: %importer_python -c 'import numpy as np; p="%t.corpus/simple-gemm-f16/reference/expected.npy"; a=np.load(p); a.flat[0]=np.float16(a.flat[0]+1); np.save("%t.bad.npy",a)'
# RUN: not wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.bad --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-input 1=%t.corpus/simple-gemm-f16/reference/input-1.npy --model-expected 0=%t.bad.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=10000 --target-model-max-fused-multiply-adds=10000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 2>&1 | FileCheck %s --check-prefix=MISMATCH
# RUN: test -s %t.bad/manifest.json
# RUN: test -s %t.bad/modules/rank_00000.so

# F16: wafer-compile: published verified package with execution-ranks=1:
# F16: target model numeric statistics index=0 rank=0 dtype=f16 elements=64 exact=64 exact_fraction=1
# F16-SAME: mean_abs=0 p99_abs=0 p999_abs=0 max_abs=0 mean_ulp=0 p99_ulp=0 p999_ulp=0 max_ulp=0
# F16: target model outputs matched; ranks=1 transactions=5
# F16-SAME: formal_commands=1 managed_reference_commands=0 managed_reference_scalars=0 bulk_commands=0
# BF16: wafer-compile: published verified package with execution-ranks=1:
# BF16: target model outputs matched; ranks=1 transactions=5
# BF16-SAME: formal_commands=1 managed_reference_commands=0 managed_reference_scalars=0 bulk_commands=0
# MODEL-MISSING: wafer-compile: target model execution requires both --model-input and --model-expected
# MODEL-DUPLICATE: wafer-compile: duplicate --model-input index: 0
# MODEL-TOLERANCE: wafer-compile: invalid --model-atol value: -1
# LLAMA: wafer-compile: published verified package with execution-ranks=16:
# LLAMA: target model outputs matched; ranks=16 transactions=8900 systemc_threads=17
# LATE-MODEL: wafer-compile: published verified package with execution-ranks=16:
# LATE-MODEL: SystemC target model invocation-failure: stage=injected-terminal-failure rank=15: test-only terminal failure injection
# LATE-MODEL-NOT: target model outputs matched
# MISMATCH: wafer-compile: published verified package with execution-ranks=1:
# MISMATCH: wafer-compile: target model output differs at index 0 rank 0
# MISMATCH-NOT: target model outputs matched
