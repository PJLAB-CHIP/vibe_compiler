# RUN: not wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.reference-unsupported --execution-ranks=1 --target-profile=wafer-tx81-single-card-kernel-v1 --reference-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --reference-input 1=%t.corpus/simple-gemm-f16/reference/input-1.npy --reference-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy --reference-atol=0 --reference-rtol=0 --target-model --target-model-oracle=reference --target-model-max-scalar-evaluations=10000 --target-model-max-fused-multiply-adds=10000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 2>&1 | FileCheck %s --check-prefix=REFERENCE-FAIL
