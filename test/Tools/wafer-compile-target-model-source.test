# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper, numeric-model, systemc-model

# RUN: rm -rf %t.corpus %t.f16 %t.bf16 %t.bad %t.bad.npy %t.model-cli
# RUN: env CPU_NUM_DEVICES=16 PJRT_DEVICE=CPU %importer_python %wafer_src_root/test/Tools/Inputs/wafer_pytorch_xla_capture.py --emit-workload-corpus --corpus-case simple-gemm-f16 --corpus-case simple-gemm-bf16 --output-corpus-dir %t.corpus --verify-corpus-reproducibility
# RUN: wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.f16 --num-partitions=1 --launch-kind=kernel --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-input 1=%t.corpus/simple-gemm-f16/reference/input-1.npy --model-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy --model-atol=0 --model-rtol=0 --model-report-numeric-statistics --target-model --target-model-max-scalar-evaluations=10000 --target-model-max-fused-multiply-adds=10000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 | FileCheck %s --check-prefix=F16
# RUN: wafer-compile --input-program-dir %t.corpus/simple-gemm-bf16/program --output-program-dir %t.bf16 --num-partitions=1 --launch-kind=kernel --model-input 0=%t.corpus/simple-gemm-bf16/reference/input.npy --model-input 1=%t.corpus/simple-gemm-bf16/reference/input-1.npy --model-expected 0=%t.corpus/simple-gemm-bf16/reference/expected.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=10000 --target-model-max-fused-multiply-adds=10000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 | FileCheck %s --check-prefix=BF16
# RUN: not wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.model-cli --num-partitions=1 --launch-kind=kernel --target-model --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy 2>&1 | FileCheck %s --check-prefix=MODEL-MISSING
# RUN: not wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.model-cli --num-partitions=1 --launch-kind=kernel --target-model --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy 2>&1 | FileCheck %s --check-prefix=MODEL-DUPLICATE
# RUN: not wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.model-cli --num-partitions=1 --launch-kind=kernel --target-model --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-expected 0=%t.corpus/simple-gemm-f16/reference/expected.npy --model-atol=-1 2>&1 | FileCheck %s --check-prefix=MODEL-TOLERANCE
# RUN: %python -c 'import json,pathlib; manifests=[json.loads((pathlib.Path(p)/"manifest.json").read_text()) for p in ("%t.f16","%t.bf16")]; assert all(m["schema_version"]==8 and m["card_count"]==1 and m["tile_count"]==16 for m in manifests); assert all(m["target"]["launch"]["kind"]=="kernel" and m["target"]["launch"]["entry_abi"] in {"tile-major-pointer-table","tile-row-pointer-table"} for m in manifests); assert all(len(m["entries"])==16 and {e["card_id"] for e in m["entries"]}=={0} and {e["tile_id"] for e in m["entries"]}==set(range(16)) and {e["launch_slot"] for e in m["entries"]}==set(range(16)) and {e["completion"] for e in m["entries"]}=={"return_after_local_drain"} for m in manifests); assert all(all(r["scope"]=={"kind":"card","card_id":0} if r["role"] in {"user_input","parameter","constant","output"} else r["scope"]["kind"]=="tile" for r in m["resources"]) for m in manifests)'
# RUN: %importer_python -c 'import numpy as np; p="%t.corpus/simple-gemm-f16/reference/expected.npy"; a=np.load(p); a.flat[0]=np.float16(a.flat[0]+1); np.save("%t.bad.npy",a)'
# RUN: not wafer-compile --input-program-dir %t.corpus/simple-gemm-f16/program --output-program-dir %t.bad --num-partitions=1 --launch-kind=kernel --model-input 0=%t.corpus/simple-gemm-f16/reference/input.npy --model-input 1=%t.corpus/simple-gemm-f16/reference/input-1.npy --model-expected 0=%t.bad.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=10000 --target-model-max-fused-multiply-adds=10000 --target-model-max-movement-bytes=10000000 --target-model-max-movement-segments=100000 2>&1 | FileCheck %s --check-prefix=MISMATCH
# RUN: test -s %t.bad/manifest.json
# RUN: test -s %t.bad/modules/module_00000.so

# F16: wafer-compile: wrote verified package with num-partitions=1 tiles=16:
# F16: target model numeric statistics index=0 launch_slot=0 dtype=f16 elements=64 exact=64 exact_fraction=1
# F16-SAME: mean_abs=0 p99_abs=0 p999_abs=0 max_abs=0 mean_ulp=0 p99_ulp=0 p999_ulp=0 max_ulp=0
# F16: target model outputs matched; tiles=16 transactions=
# F16-SAME: formal_commands=1 managed_reference_commands=0 managed_reference_scalars=0 bulk_commands=0
# BF16: wafer-compile: wrote verified package with num-partitions=1 tiles=16:
# BF16: target model outputs matched; tiles=16 transactions=
# BF16-SAME: formal_commands=1 managed_reference_commands=0 managed_reference_scalars=0 bulk_commands=0
# MODEL-MISSING: wafer-compile: target model execution requires both --model-input and --model-expected
# MODEL-DUPLICATE: wafer-compile: duplicate --model-input index: 0
# MODEL-TOLERANCE: wafer-compile: invalid --model-atol value: -1
