# CHECK-SAME: -O2
# CHECK-SAME: -c
# CHECK-SAME: -fPIC
# CHECK-SAME: --target=riscv64-unknown-elf
# CHECK-SAME: -march=rv64imafdc
# CHECK-SAME: -o
# CHECK-SAME: kernel.o

