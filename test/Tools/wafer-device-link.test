# RUN: %python %wafer_src_root/tools/wafer_device_link.py \
# RUN:   --llvm-ir %S/Inputs/minimal-wafer-abi.ll \
# RUN:   --output %t.kernel.so \
# RUN:   --object-output %t.kernel.o \
# RUN:   --llvm-clangxx /opt/llvm/bin/clang++ \
# RUN:   --print-commands | FileCheck %s

# RUN: not %python %wafer_src_root/tools/wafer_device_link.py \
# RUN:   --llvm-ir %S/Inputs/missing.ll \
# RUN:   --output %t.kernel.so \
# RUN:   --llvm-clangxx /opt/llvm/bin/clang++ \
# RUN:   --print-commands 2>&1 | FileCheck %s --check-prefix=ERR

# CHECK-LABEL: compile:
# CHECK-SAME: /opt/llvm/bin/clang++
# CHECK-SAME: minimal-wafer-abi.ll
# CHECK-SAME: -O2
# CHECK-SAME: -c
# CHECK-SAME: -fPIC
# CHECK-SAME: --target=riscv64-unknown-elf
# CHECK-SAME: -march=rv64imafdc
# CHECK-SAME: -o
# CHECK-SAME: kernel.o

# CHECK-LABEL: shim-compile:
# CHECK-SAME: /opt/llvm/bin/clang++
# CHECK-SAME: -x c
# CHECK-SAME: wafer_cabi_shim.c
# CHECK-SAME: -O2
# CHECK-SAME: -c
# CHECK-SAME: -fPIC
# CHECK-SAME: --target=riscv64-unknown-elf
# CHECK-SAME: -march=rv64imafdc
# CHECK-SAME: -mabi=lp64d
# CHECK-SAME: --sysroot={{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/riscv64-unknown-elf
# CHECK-SAME: -isystem
# CHECK-SAME: {{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/riscv64-unknown-elf/include
# CHECK-SAME: -DUSING_RISCV
# CHECK-SAME: -DCONFIG_NO_PLATFORM_HOOK_H
# CHECK-SAME: -I{{[^ ]*}}/third_party/tx8_deps/include
# CHECK-SAME: -o
# CHECK-SAME: kernel.wafer_cabi_shim.o

# CHECK-LABEL: normalize:
# CHECK-SAME: {{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-objcopy
# CHECK-SAME: -R
# CHECK-SAME: .riscv.attributes
# CHECK-SAME: kernel.o

# CHECK-LABEL: normalize:
# CHECK-SAME: {{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-objcopy
# CHECK-SAME: -R
# CHECK-SAME: .riscv.attributes
# CHECK-SAME: kernel.wafer_cabi_shim.o

# CHECK-LABEL: link:
# CHECK-SAME: {{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-gcc
# CHECK-SAME: -shared
# CHECK-SAME: -march=rv64imafdc
# CHECK-SAME: -nostartfiles
# CHECK-SAME: -Wl,--allow-shlib-undefined
# CHECK-SAME: -mabi=lp64d
# CHECK-SAME: -Wl,--no-dynamic-linker
# CHECK-SAME: kernel.o
# CHECK-SAME: kernel.wafer_cabi_shim.o
# CHECK-SAME: -L{{[^ ]*}}/third_party/wafer_crt/lib
# CHECK-SAME: -L{{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/riscv64-unknown-elf/lib/rv64imafdc/lp64d
# CHECK-SAME: -L{{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/lib/gcc/riscv64-unknown-elf/10.4.0/rv64imafdc/lp64d
# CHECK-SAME: -L{{[^ ]*}}/third_party/tx8_deps/lib
# CHECK-SAME: -Wl,--start-group
# CHECK-SAME: -lcommon_util
# CHECK-SAME: -linstr_tx81
# CHECK-SAME: -llibc_stub
# CHECK-SAME: -lvr
# CHECK-SAME: -Wl,--end-group
# CHECK-SAME: -lm
# CHECK-SAME: -Wl,--gc-sections
# CHECK-SAME: -Wl,--unique=.rodata.name
# CHECK-SAME: -lc
# CHECK-SAME: -lgcc
# CHECK-SAME: -o
# CHECK-SAME: kernel.so

