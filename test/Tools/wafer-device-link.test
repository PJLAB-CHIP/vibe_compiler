# CHECK-LABEL: compile:
# CHECK-SAME: /opt/llvm/bin/clang++
# CHECK-SAME: minimal-target-kernel.ll
# CHECK-SAME: -O2
# CHECK-SAME: -c
# CHECK-SAME: -fPIC
# CHECK-SAME: --target=riscv64-unknown-elf
# CHECK-SAME: -march=rv64imafdc
# CHECK-SAME: -o
# CHECK-SAME: kernel.o

# CHECK-LABEL: normalize:
# CHECK-SAME: {{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-objcopy
# CHECK-SAME: -R
# CHECK-SAME: .riscv.attributes
# CHECK-SAME: kernel.o

# CHECK-LABEL: compile-crt:
# CHECK-SAME: {{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-gcc
# CHECK-SAME: runtime/wafer_crt/src/wafer_tx81_crt.c
# CHECK-SAME: -O2
# CHECK-SAME: -c
# CHECK-SAME: -fPIC
# CHECK-SAME: -ffunction-sections
# CHECK-SAME: -fdata-sections
# CHECK-SAME: -fvisibility=hidden
# CHECK-SAME: -DCONFIG_NO_PLATFORM_HOOK_H
# CHECK-SAME: -DUSING_RISCV
# CHECK-SAME: -I{{[^ ]*}}/runtime/wafer_crt/include
# CHECK-SAME: -I{{[^ ]*}}/third_party/tx8_deps/include
# CHECK-SAME: -march=rv64imafdc
# CHECK-SAME: -mabi=lp64d
# CHECK-SAME: -o
# CHECK-SAME: kernel.wafer_crt.o

# CHECK-LABEL: normalize-crt:
# CHECK-SAME: {{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-objcopy
# CHECK-SAME: -R
# CHECK-SAME: .riscv.attributes
# CHECK-SAME: kernel.wafer_crt.o

# CHECK-LABEL: link:
# CHECK-SAME: {{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-gcc
# CHECK-SAME: -shared
# CHECK-SAME: -march=rv64imafdc
# CHECK-SAME: -nostartfiles
# CHECK-SAME: -Wl,--allow-shlib-undefined
# CHECK-SAME: -mabi=lp64d
# CHECK-SAME: -Wl,--no-dynamic-linker
# CHECK-SAME: kernel.o
# CHECK-SAME: kernel.wafer_crt.o
# CHECK-SAME: -L{{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/riscv64-unknown-elf/lib/rv64imafdc/lp64d
# CHECK-SAME: -L{{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/lib/gcc/riscv64-unknown-elf/10.4.0/rv64imafdc/lp64d
# CHECK-SAME: -L{{[^ ]*}}/third_party/tx8_deps/lib
# CHECK-SAME: -Wl,--exclude-libs,ALL
# CHECK-SAME: -Wl,--start-group
# CHECK-SAME: -lcommon_util
# CHECK-SAME: -linstr_tx81
# CHECK-SAME: -llibc_stub
# CHECK-SAME: -Wl,--end-group
# CHECK-SAME: -lm
# CHECK-SAME: -Wl,--gc-sections
# CHECK-SAME: -Wl,--unique=.rodata.name
# CHECK-SAME: -lc
# CHECK-SAME: -lgcc
# CHECK-SAME: -o
# CHECK-SAME: kernel.so

# CHECK-LABEL: required-symbol-scan:
# CHECK-SAME: {{[^ ]*}}/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-nm
# CHECK-SAME: -u
# CHECK-SAME: kernel.so

# ERR: error: LLVM IR input does not exist

# UNDEF: error: undefined Wafer target CRT symbols remain after link: wafer_tx81_missing

# NOTALLOWED: error: target_symbol_not_allowed: undefined symbols are not allowed by loader ABI tx8-kcore-loader-v1: unexpected_loader_hook

# HEAP-DAG: U csi_kernel_free
# HEAP-DAG: U csi_kernel_malloc
# HEAP-NOT: rt_free
# HEAP-NOT: rt_malloc

# GETPID: U __get_pid
# GETPID-BASE: error: target_symbol_not_allowed: undefined symbols are not allowed by loader ABI tx8-kcore-loader-v1: __get_pid
