# RUN: %python %wafer_src_root/tools/wafer_device_link.py \
# RUN:   --llvm-ir %S/Inputs/minimal-target-kernel.ll \
# RUN:   --output %t.kernel.so \
# RUN:   --object-output %t.kernel.o \
# RUN:   --llvm-clangxx /opt/llvm/bin/clang++ \
# RUN:   --print-commands | FileCheck %s --implicit-check-not=shim-compile --implicit-check-not=capture-shim

# RUN: not %python %wafer_src_root/tools/wafer_device_link.py \
# RUN:   --llvm-ir %S/Inputs/missing.ll \
# RUN:   --output %t.kernel.so \
# RUN:   --llvm-clangxx /opt/llvm/bin/clang++ \
# RUN:   --print-commands 2>&1 | FileCheck %s --check-prefix=ERR

# CHECK-LABEL: compile:
