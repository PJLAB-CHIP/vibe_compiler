# An unrelated testing sibling must not become an input or collision for an
# ordinary production transaction.
# RUN: mkdir %t.outputs/unrelated.qualification
# RUN: printf 'caller-owned\n' > %t.outputs/unrelated.qualification/marker
# RUN: wafer-compile --input-program-dir %t.source --output-program-dir %t.outputs/unrelated --execution-ranks=1 --launch-kind=kernel | FileCheck %s --check-prefix=PUBLISHED
# RUN: grep -qx 'caller-owned' %t.outputs/unrelated.qualification/marker

# Selection controls are mutually exclusive and cannot weaken transaction
# atomicity by combining with a late failure injection.
# RUN: not env WAFER_TEST_SELECT_STATIC_FIXED_SLOT=1 WAFER_TEST_FAIL_AFTER_LOGICAL_RANK=0 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.outputs/conflicting --execution-ranks=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=CONFLICT
