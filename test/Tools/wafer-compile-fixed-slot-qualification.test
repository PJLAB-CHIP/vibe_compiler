# RUN: test ! -e %t.outputs/conflicting.qualification
# RUN: mkdir %t.outputs/existing.qualification
# RUN: not env WAFER_TEST_SELECT_STATIC_FIXED_SLOT=1 %wafer_compile_test --input-program-dir %t.source --output-program-dir %t.outputs/existing --execution-ranks=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=EXISTING
