# PUBLISHED: wafer-compile: published verified package with execution-ranks=1:
# WORKER-QUALIFIED: wafer-compile: published verified package with execution-ranks=16:
# WORKER-QUALIFIED: target model outputs matched; ranks=16 transactions=
# PRODUCTION-GATE: production_pipeline_preparation: {{.*}}"ready": true
# NO-CARD: package: id=0 schema=7 ranks=1
# NO-CARD: board_execution: false
# WORKER-NO-CARD: package: id=0 schema=7 ranks=16
# WORKER-NO-CARD: board_execution: false
# CONFLICT: wafer-compile: test-only static fixed-slot qualification cannot be combined with failure injection
# EXISTING: wafer-compile: refusing to replace existing fixed-slot qualification companion directory
