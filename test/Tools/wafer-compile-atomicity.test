# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nnum_partitions=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    --num-partitions) num_partitions="$2"; shift 2 ;;\n    *) shift ;;\n  esac\ndone\nmkdir -p "$output"\ncp -R "$input/." "$output/"\nmetadata_partitions="$num_partitions"\nif [[ "${HELPER_MODE:-}" = "bad-partitions" ]]; then metadata_partitions=2; fi\nprintf "{\\"function\\":\\"forward\\",\\"num_partitions\\":%%s,\\"parameters\\":[]}\\n" "$metadata_partitions" > "$output/functions/forward.parameter_shards.json"\nif [[ "${HELPER_MODE:-}" != "no-boundary" ]]; then\npython3 - "$output/functions/forward.meta" "$num_partitions" <<PY\nimport json\nimport sys\npath = sys.argv[1]\nnum_partitions = int(sys.argv[2])\nwith open(path) as stream:\n    meta = json.load(stream)\npartitions = [{"partition_id": partition_id, "replica_id": partition_id, "offsets": [0], "sizes": [16], "strides": [1]} for partition_id in range(num_partitions)]\ndef binding(index_field, index):\n    return {index_field: index, "distribution": "replicated", "global_shape": [16], "local_shape": [16], "dtype": "float32", "partitions": partitions}\nmeta["distributed_boundary"] = {"num_partitions": num_partitions, "inputs": [binding("argument_index", 0)], "outputs": [binding("result_index", 0)]}\nwith open(path, "w") as stream:\n    json.dump(meta, stream)\nPY\nfi\nif [[ "${HELPER_MODE:-}" = "sdy" ]]; then sed -i s/stablehlo.constant/sdy.constant/g "$output/functions/forward.mlir"; fi\nif [[ "${HELPER_MODE:-}" = "sdy-attribute" ]]; then sed -i "0,/^module {/s//module attributes {sdy.leftover = #sdy.mesh<[\\"card_partition\\"=1]>} {/" "$output/functions/forward.mlir"; fi\nif [[ "${HELPER_MODE:-}" = "sdy-string" ]]; then sed -i "0,/^module {/s//module attributes {sdy.leftover = \\"opaque\\"} {/" "$output/functions/forward.mlir"; fi\n' > %t.mock-helper
# RUN: chmod +x %t.mock-helper

# A helper that has already written a partial staging program and then fails
# must not mutate the source or write the requested output.
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/failed --num-partitions=1 2>&1 | FileCheck %s --check-prefix=LATE
# RUN: diff -ru %t.input.before %t.input
# RUN: test ! -e %t.outputs/failed
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'

# A helper marker is insufficient when the returned program still contains
# an SDY intermediate op.
# RUN: not env HELPER_MODE=sdy WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/residual-sdy --num-partitions=1 2>&1 | FileCheck %s --check-prefix=RESIDUAL-SDY
# RUN: test ! -e %t.outputs/residual-sdy

# SDY attributes are residual sharding semantics even when every operation
# belongs to an admitted post-helper dialect.
# RUN: not env HELPER_MODE=sdy-attribute WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/residual-sdy-attribute --num-partitions=1 2>&1 | FileCheck %s --check-prefix=RESIDUAL-SDY-ATTRIBUTE
# RUN: test ! -e %t.outputs/residual-sdy-attribute

# A builtin string still carries Shardy semantics when its attribute key is in
# the sdy namespace. The post-helper gate checks names as well as dialect-owned
# attribute values.
# RUN: not env HELPER_MODE=sdy-string WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/residual-sdy-string --num-partitions=1 2>&1 | FileCheck %s --check-prefix=RESIDUAL-SDY-STRING
# RUN: test ! -e %t.outputs/residual-sdy-string

# Post-helper metadata is checked inside the same compilation transaction.
# RUN: not env HELPER_MODE=bad-partitions WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/bad-metadata --num-partitions=1 2>&1 | FileCheck %s --check-prefix=BAD-METADATA
# RUN: test ! -e %t.outputs/bad-metadata

# A marker alone cannot establish the typed user-input/result distribution
# contract that the tensor program hands to CardModule construction.
# RUN: not env HELPER_MODE=no-boundary WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/missing-boundary --num-partitions=1 2>&1 | FileCheck %s --check-prefix=NO-BOUNDARY
# RUN: test ! -e %t.outputs/missing-boundary

# A no-op process cannot masquerade as the SPMD helper without an explicit
# post-partition marker.
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.bad-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/fake-success --num-partitions=1 2>&1 | FileCheck %s --check-prefix=NO-MARKER
# RUN: test ! -e %t.outputs/fake-success
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'

# The marker path must be a regular file; a directory with the canonical name
# cannot satisfy the partition boundary.
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.marker-dir-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/marker-directory --num-partitions=1 2>&1 | FileCheck %s --check-prefix=MARKER-DIRECTORY
# RUN: test ! -e %t.outputs/marker-directory

# The helper output root itself must be a real directory, not a symlink back
# into another transaction member that would dangle after cleanup.
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.symlink-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/helper-root-symlink --num-partitions=1 2>&1 | FileCheck %s --check-prefix=HELPER-ROOT-SYMLINK
# RUN: test ! -e %t.outputs/helper-root-symlink
# RUN: test ! -L %t.outputs/helper-root-symlink

# An existing final directory is never replaced by the package directory rename.
# RUN: mkdir -p %t.outputs/final/nested && printf old > %t.outputs/final/nested/sentinel
# RUN: cp -R %t.outputs/final %t.final.before
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.outputs/final --num-partitions=1 2>&1 | FileCheck %s --check-prefix=EXISTING
# RUN: diff -ru %t.input.before %t.input
# RUN: diff -ru %t.final.before %t.outputs/final

# A symlinked output parent cannot bypass source/output containment.
# RUN: ln -sfn %t.input %t.alias-parent
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.alias-parent/output --num-partitions=1 2>&1 | FileCheck %s --check-prefix=ALIASED-OUTPUT
# RUN: diff -ru %t.input.before %t.input
# RUN: test ! -e %t.input/output

# A not-yet-created deep output parent below the source is rejected before any
# parent directory or staging state is created.
# RUN: not env HELPER_CALLED=%t.helper-called WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.unexpected-helper %wafer_compile_test --input-program-dir %t.input --output-dir %t.input/not-yet-created/deep/output --num-partitions=1 2>&1 | FileCheck %s --check-prefix=DEEP-SOURCE-OUTPUT
# RUN: diff -ru %t.input.before %t.input
# RUN: test ! -e %t.input/not-yet-created
# RUN: test ! -e %t.helper-called

# Source snapshots reject symlink members instead of following data outside
# the admitted program tree.
# RUN: cp -R %t.input %t.symlink-input && ln -s functions/forward.meta %t.symlink-input/metadata-link
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.symlink-input --output-dir %t.outputs/symlink-output --num-partitions=1 2>&1 | FileCheck %s --check-prefix=SOURCE-SYMLINK
# RUN: test ! -e %t.outputs/symlink-output

# Lower-level instruction IR is already beyond the admitted exporter stage and
# is rejected before the external helper can run.
# RUN: cp -R %t.input %t.stage-instr
# RUN: printf '%b' 'module {\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%c = stablehlo.constant dense<1.000000e+00> : tensor<16xf32>\n    wafer.instr.ncc_join [0]\n    %%0 = stablehlo.add %%arg0, %%c : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.stage-instr/functions/forward.mlir
# RUN: not env HELPER_CALLED=%t.helper-called WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.unexpected-helper %wafer_compile_test --input-program-dir %t.stage-instr --output-dir %t.outputs/stage-instr --num-partitions=1 2>&1 | FileCheck %s --check-prefix=STAGE-INSTR
# RUN: test ! -e %t.outputs/stage-instr
# RUN: test ! -e %t.helper-called

# The same namespace-key rule applies at the source boundary and must fire
# before helper orchestration.
# RUN: cp -R %t.input %t.source-sdy-string
# RUN: printf '%b' 'module attributes {sdy.leftover = "opaque"} {\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%c = stablehlo.constant dense<1.000000e+00> : tensor<16xf32>\n    %%0 = stablehlo.add %%arg0, %%c : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.source-sdy-string/functions/forward.mlir
# RUN: not env HELPER_CALLED=%t.helper-called WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.unexpected-helper %wafer_compile_test --input-program-dir %t.source-sdy-string --output-dir %t.outputs/source-sdy-string --num-partitions=1 2>&1 | FileCheck %s --check-prefix=SOURCE-SDY-STRING
# RUN: test ! -e %t.outputs/source-sdy-string
# RUN: test ! -e %t.helper-called

# Individually valid execution facts inside a nested builtin module cannot
# substitute for the direct members owned by the compiled program module.
# RUN: cp -R %t.input %t.nested-facts
# RUN: printf '%b' 'module {\n  module @nested {\n    wafer.target.topology @default {card_grid = array<i64: 1, 1>, card_interconnect = "mesh", tile_grid = array<i64: 4, 4>, unavailable_tiles = array<i64>}\n    wafer.execution.mesh @default_mesh {axes = ["card_partition"], shape = array<i64: 1>}\n  }\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%c = stablehlo.constant dense<1.000000e+00> : tensor<16xf32>\n    %%0 = stablehlo.add %%arg0, %%c : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.nested-facts/functions/forward.mlir
# RUN: not env HELPER_CALLED=%t.helper-called WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.unexpected-helper %wafer_compile_test --input-program-dir %t.nested-facts --output-dir %t.outputs/nested-facts --num-partitions=1 2>&1 | FileCheck %s --check-prefix=NESTED-FACTS
# RUN: test ! -e %t.outputs/nested-facts
# RUN: test ! -e %t.helper-called

# A valid but mismatched pre-existing mesh must not be silently reused.
# RUN: cp -R %t.input %t.mismatch
# RUN: printf '%b' 'module {\n  wafer.target.topology @default {card_grid = array<i64: 1, 1>, card_interconnect = "mesh", tile_grid = array<i64: 4, 4>, unavailable_tiles = array<i64>}\n  wafer.execution.mesh @default_mesh {axes = ["card_partition"], shape = array<i64: 2>}\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%0 = stablehlo.add %%arg0, %%arg0 : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.mismatch/functions/forward.mlir
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.mismatch --output-dir %t.outputs/mismatch-output --num-partitions=1 2>&1 | FileCheck %s --check-prefix=MISMATCH
# RUN: test ! -e %t.outputs/mismatch-output

# Multiple individually valid topology facts are ambiguous to the typed driver.
# RUN: cp -R %t.input %t.duplicate
# RUN: printf '%b' 'module {\n  wafer.target.topology @default {card_grid = array<i64: 1, 1>, card_interconnect = "mesh", tile_grid = array<i64: 4, 4>, unavailable_tiles = array<i64>}\n  wafer.target.topology @other {card_grid = array<i64: 1, 1>, card_interconnect = "mesh", tile_grid = array<i64: 4, 4>, unavailable_tiles = array<i64>}\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%0 = stablehlo.add %%arg0, %%arg0 : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.duplicate/functions/forward.mlir
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.duplicate --output-dir %t.outputs/duplicate-output --num-partitions=1 2>&1 | FileCheck %s --check-prefix=DUPLICATE
# RUN: test ! -e %t.outputs/duplicate-output

# Multiple execution meshes and a non-canonical topology are independently
# rejected even when every individual IR op verifies.
# RUN: cp -R %t.input %t.duplicate-mesh
# RUN: printf '%b' 'module {\n  wafer.target.topology @default {card_grid = array<i64: 1, 1>, card_interconnect = "mesh", tile_grid = array<i64: 4, 4>, unavailable_tiles = array<i64>}\n  wafer.execution.mesh @default_mesh {axes = ["card_partition"], shape = array<i64: 1>}\n  wafer.execution.mesh @other_mesh {axes = ["card_partition"], shape = array<i64: 1>}\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%0 = stablehlo.add %%arg0, %%arg0 : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.duplicate-mesh/functions/forward.mlir
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.duplicate-mesh --output-dir %t.outputs/duplicate-mesh-output --num-partitions=1 2>&1 | FileCheck %s --check-prefix=DUPLICATE-MESH
# RUN: test ! -e %t.outputs/duplicate-mesh-output
# RUN: cp -R %t.input %t.bad-topology
# RUN: printf '%b' 'module {\n  wafer.target.topology @default {card_grid = array<i64: 1, 1>, card_interconnect = "mesh", tile_grid = array<i64: 2, 8>, unavailable_tiles = array<i64>}\n  wafer.execution.mesh @default_mesh {axes = ["card_partition"], shape = array<i64: 1>}\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%0 = stablehlo.add %%arg0, %%arg0 : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.bad-topology/functions/forward.mlir
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.bad-topology --output-dir %t.outputs/bad-topology-output --num-partitions=1 2>&1 | FileCheck %s --check-prefix=BAD-TOPOLOGY
# RUN: test ! -e %t.outputs/bad-topology-output
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'

# LATE: wafer-compile: XLA SPMD partitioner helper failed with exit code 42
# NO-MARKER: wafer-compile: XLA SPMD partitioner output is missing its partition marker
# MARKER-DIRECTORY: wafer-compile: XLA SPMD partitioner output is missing its partition marker
# HELPER-ROOT-SYMLINK: wafer-compile: helper output is not a real directory
# RESIDUAL-SDY: wafer-compile: XLA SPMD partitioner output still contains Shardy semantics
# RESIDUAL-SDY-ATTRIBUTE: wafer-compile: XLA SPMD partitioner output still contains Shardy semantics
# RESIDUAL-SDY-STRING: wafer-compile: XLA SPMD partitioner output still contains Shardy semantics
# BAD-METADATA: parameter shard num_partitions does not match execution mesh partition count
# NO-BOUNDARY: post-SPMD program directory is missing distributed_boundary
# EXISTING: wafer-compile: refusing to replace existing output directory
# ALIASED-OUTPUT: wafer-compile: output directory must not equal or be nested under the source program directory
# DEEP-SOURCE-OUTPUT: wafer-compile: output directory must not equal or be nested under the source program directory
# SOURCE-SYMLINK: wafer-compile: program directory contains unsupported symbolic link
# STAGE-INSTR: retired source IR member remains: functions/forward.mlir
# SOURCE-SDY-STRING: retired source IR member remains: functions/forward.mlir
# NESTED-FACTS: retired source IR member remains: functions/forward.mlir
# MISMATCH: retired source IR member remains: functions/forward.mlir
# DUPLICATE: retired source IR member remains: functions/forward.mlir
# DUPLICATE-MESH: retired source IR member remains: functions/forward.mlir
# BAD-TOPOLOGY: retired source IR member remains: functions/forward.mlir
