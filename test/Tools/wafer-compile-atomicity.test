# RUN: chmod +x %t.bad-helper
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    *) shift ;;\n  esac\ndone\nmkdir -p "$output"\ncp -R "$input/." "$output/"\nmkdir "$output/functions/forward.parameter_shards.json"\n' > %t.marker-dir-helper
# RUN: chmod +x %t.marker-dir-helper
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    *) shift ;;\n  esac\ndone\nln -s "$input" "$output"\n' > %t.symlink-helper
# RUN: chmod +x %t.symlink-helper
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\nprintf called > "${HELPER_CALLED:?}"\nexit 99\n' > %t.unexpected-helper
