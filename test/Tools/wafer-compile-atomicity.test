# Multiple execution meshes and a non-canonical topology are independently
# rejected even when every individual IR op verifies.
# RUN: cp -R %t.input %t.duplicate-mesh
# RUN: printf '%b' 'module {\n  wafer.target.topology @default {card_grid = array<i64: 1, 1>, card_interconnect = "mesh", tile_grid = array<i64: 4, 4>, unavailable_tiles = array<i64>}\n  wafer.execution.mesh @default_mesh {topology = @default, axes = ["rank"], shape = array<i64: 16>, policy = "all_available", endpoints = array<i64>}\n  wafer.execution.mesh @other_mesh {topology = @default, axes = ["rank"], shape = array<i64: 16>, policy = "all_available", endpoints = array<i64>}\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%0 = stablehlo.add %%arg0, %%arg0 : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.duplicate-mesh/functions/forward.mlir
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.duplicate-mesh --output-program-dir %t.outputs/duplicate-mesh-output --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=DUPLICATE-MESH
# RUN: test ! -e %t.outputs/duplicate-mesh-output
# RUN: cp -R %t.input %t.bad-topology
# RUN: printf '%b' 'module {\n  wafer.target.topology @default {card_grid = array<i64: 1, 1>, card_interconnect = "mesh", tile_grid = array<i64: 2, 8>, unavailable_tiles = array<i64>}\n  wafer.execution.mesh @default_mesh {topology = @default, axes = ["rank"], shape = array<i64: 16>, policy = "all_available", endpoints = array<i64>}\n  func.func @main(%%arg0: tensor<16xf32>) -> tensor<16xf32> {\n    %%0 = stablehlo.add %%arg0, %%arg0 : tensor<16xf32>\n    return %%0 : tensor<16xf32>\n  }\n}\n' > %t.bad-topology/functions/forward.mlir
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.bad-topology --output-program-dir %t.outputs/bad-topology-output --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=BAD-TOPOLOGY
# RUN: test ! -e %t.outputs/bad-topology-output
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'

