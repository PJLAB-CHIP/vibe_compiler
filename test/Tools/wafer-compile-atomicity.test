# RUN: test ! -e %t.outputs/failed
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'

# A helper marker is insufficient when the returned program still contains
# an SDY intermediate op.
# RUN: not env HELPER_MODE=sdy WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/residual-sdy --num-partitions=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=RESIDUAL-SDY
# RUN: test ! -e %t.outputs/residual-sdy

# SDY attributes are residual sharding semantics even when every operation
# belongs to an admitted post-helper dialect.
# RUN: not env HELPER_MODE=sdy-attribute WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/residual-sdy-attribute --num-partitions=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=RESIDUAL-SDY-ATTRIBUTE
# RUN: test ! -e %t.outputs/residual-sdy-attribute

# A builtin string still carries Shardy semantics when its attribute key is in
# the sdy namespace. The post-helper gate checks names as well as dialect-owned
# attribute values.
# RUN: not env HELPER_MODE=sdy-string WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/residual-sdy-string --num-partitions=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=RESIDUAL-SDY-STRING
# RUN: test ! -e %t.outputs/residual-sdy-string

# Post-helper metadata is checked inside the same compilation transaction.
# RUN: not env HELPER_MODE=bad-partitions WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/bad-metadata --num-partitions=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=BAD-METADATA
# RUN: test ! -e %t.outputs/bad-metadata

# A marker alone cannot establish the typed user-input/result distribution
# contract that the tensor program hands to CardModule construction.
# RUN: not env HELPER_MODE=no-boundary WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/missing-boundary --num-partitions=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=NO-BOUNDARY
# RUN: test ! -e %t.outputs/missing-boundary

# A no-op process cannot masquerade as the SPMD helper without an explicit
# post-partition marker.
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.bad-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/fake-success --num-partitions=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=NO-MARKER
