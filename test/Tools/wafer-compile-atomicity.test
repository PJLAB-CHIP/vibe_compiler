# RUN: chmod +x %t.fail-helper
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    *) shift ;;\n  esac\ndone\nmkdir -p "$output"\ncp -R "$input/." "$output/"\n' > %t.bad-helper
# RUN: chmod +x %t.bad-helper
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    *) shift ;;\n  esac\ndone\nmkdir -p "$output"\ncp -R "$input/." "$output/"\nmkdir "$output/functions/forward.parameter_shards.json"\n' > %t.marker-dir-helper
# RUN: chmod +x %t.marker-dir-helper
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    *) shift ;;\n  esac\ndone\nln -s "$input" "$output"\n' > %t.symlink-helper
# RUN: chmod +x %t.symlink-helper
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\nprintf called > "${HELPER_CALLED:?}"\nexit 99\n' > %t.unexpected-helper
# RUN: chmod +x %t.unexpected-helper
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nrank_count=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    --logical-rank-count) rank_count="$2"; shift 2 ;;\n    *) shift ;;\n  esac\ndone\nmkdir -p "$output"\ncp -R "$input/." "$output/"\nmetadata_rank="$rank_count"\nif [[ "${HELPER_MODE:-}" = "bad-rank" ]]; then metadata_rank=8; fi\nprintf "{\\"parameter_shards_version\\":3,\\"function\\":\\"forward\\",\\"logical_rank_count\\":%%s,\\"parameters\\":[]}\\n" "$metadata_rank" > "$output/functions/forward.parameter_shards.json"\nif [[ "${HELPER_MODE:-}" != "no-boundary" ]]; then\npython3 - "$output/functions/forward.meta" "$rank_count" <<PY\nimport json\nimport sys\npath = sys.argv[1]\nrank_count = int(sys.argv[2])\nwith open(path) as stream:\n    meta = json.load(stream)\nranks = [{"rank": rank, "replica_id": rank, "offsets": [0], "sizes": [16], "strides": [1]} for rank in range(rank_count)]\ndef binding(index_field, index):\n    return {index_field: index, "distribution": "replicated", "global_shape": [16], "local_shape": [16], "dtype": "float32", "ranks": ranks}\nmeta["distributed_boundary"] = {"version": 1, "logical_rank_count": rank_count, "inputs": [binding("argument_index", 0)], "outputs": [binding("result_index", 0)]}\nwith open(path, "w") as stream:\n    json.dump(meta, stream)\nPY\nfi\nif [[ "${HELPER_MODE:-}" = "sdy" ]]; then sed -i s/stablehlo.constant/sdy.constant/g "$output/functions/forward.mlir"; fi\nif [[ "${HELPER_MODE:-}" = "sdy-attribute" ]]; then sed -i "0,/^module {/s//module attributes {sdy.leftover = #sdy.mesh<[\\"rank\\"=16]>} {/" "$output/functions/forward.mlir"; fi\nif [[ "${HELPER_MODE:-}" = "sdy-string" ]]; then sed -i "0,/^module {/s//module attributes {sdy.leftover = \\"opaque\\"} {/" "$output/functions/forward.mlir"; fi\nif [[ "${HELPER_MODE:-}" = "publication-race" ]]; then mkdir -p "${FINAL_OUTPUT:?}"; printf competitor > "${FINAL_OUTPUT}/sentinel"; fi\n' > %t.mock-helper
# RUN: chmod +x %t.mock-helper

# A helper that has already written a partial staging program and then fails
# must not mutate the source or publish the requested output.
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/failed --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=LATE
# RUN: diff -ru %t.input.before %t.input
# RUN: test ! -e %t.outputs/failed
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'

# A helper marker is insufficient when the returned program still contains
# an SDY intermediate op.
# RUN: not env HELPER_MODE=sdy WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/residual-sdy --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=RESIDUAL-SDY
# RUN: test ! -e %t.outputs/residual-sdy

# SDY attributes are residual sharding semantics even when every operation
# belongs to an admitted post-helper dialect.
# RUN: not env HELPER_MODE=sdy-attribute WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/residual-sdy-attribute --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=RESIDUAL-SDY-ATTRIBUTE
# RUN: test ! -e %t.outputs/residual-sdy-attribute

# A builtin string still carries Shardy semantics when its attribute key is in
# the sdy namespace. The post-helper gate checks names as well as dialect-owned
# attribute values.
# RUN: not env HELPER_MODE=sdy-string WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/residual-sdy-string --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=RESIDUAL-SDY-STRING
# RUN: test ! -e %t.outputs/residual-sdy-string

# Post-helper metadata is checked inside the same publication transaction.
# RUN: not env HELPER_MODE=bad-rank WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/bad-metadata --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=BAD-METADATA
# RUN: test ! -e %t.outputs/bad-metadata

# A marker alone cannot establish the typed user-input/result distribution
# contract that the tensor program hands to rank bundle materialization.
# RUN: not env HELPER_MODE=no-boundary WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/missing-boundary --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=NO-BOUNDARY
# RUN: test ! -e %t.outputs/missing-boundary

# A no-op process cannot masquerade as the SPMD helper without an explicit
# post-partition marker.
