# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nnum_partitions=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    --num-partitions) num_partitions="$2"; shift 2 ;;\n    *) shift ;;\n  esac\ndone\nmkdir -p "$output"\ncp -R "$input/." "$output/"\nmetadata_partitions="$num_partitions"\nif [[ "${HELPER_MODE:-}" = "bad-partitions" ]]; then metadata_partitions=2; fi\nprintf "{\\"parameter_shards_version\\":4,\\"function\\":\\"forward\\",\\"num_partitions\\":%%s,\\"parameters\\":[]}\\n" "$metadata_partitions" > "$output/functions/forward.parameter_shards.json"\nif [[ "${HELPER_MODE:-}" != "no-boundary" ]]; then\npython3 - "$output/functions/forward.meta" "$num_partitions" <<PY\nimport json\nimport sys\npath = sys.argv[1]\nnum_partitions = int(sys.argv[2])\nwith open(path) as stream:\n    meta = json.load(stream)\npartitions = [{"partition_id": partition_id, "replica_id": partition_id, "offsets": [0], "sizes": [16], "strides": [1]} for partition_id in range(num_partitions)]\ndef binding(index_field, index):\n    return {index_field: index, "distribution": "replicated", "global_shape": [16], "local_shape": [16], "dtype": "float32", "partitions": partitions}\nmeta["distributed_boundary"] = {"version": 2, "num_partitions": num_partitions, "inputs": [binding("argument_index", 0)], "outputs": [binding("result_index", 0)]}\nwith open(path, "w") as stream:\n    json.dump(meta, stream)\nPY\nfi\nif [[ "${HELPER_MODE:-}" = "sdy" ]]; then sed -i s/stablehlo.constant/sdy.constant/g "$output/functions/forward.mlir"; fi\nif [[ "${HELPER_MODE:-}" = "sdy-attribute" ]]; then sed -i "0,/^module {/s//module attributes {sdy.leftover = #sdy.mesh<[\\"card_partition\\"=1]>} {/" "$output/functions/forward.mlir"; fi\nif [[ "${HELPER_MODE:-}" = "sdy-string" ]]; then sed -i "0,/^module {/s//module attributes {sdy.leftover = \\"opaque\\"} {/" "$output/functions/forward.mlir"; fi\nif [[ "${HELPER_MODE:-}" = "output-race" ]]; then mkdir -p "${FINAL_OUTPUT:?}"; printf competitor > "${FINAL_OUTPUT}/sentinel"; fi\n' > %t.mock-helper
# RUN: chmod +x %t.mock-helper

# A helper that has already written a partial staging program and then fails
# must not mutate the source or write the requested output.
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.fail-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/failed --num-partitions=1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=LATE
