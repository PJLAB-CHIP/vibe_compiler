# The marker path must be a regular file; a directory with the canonical name
# cannot satisfy the partition boundary.
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.marker-dir-helper %wafer_compile_test --input-program-dir %t.input --output-program-dir %t.outputs/marker-directory --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-kind=kernel 2>&1 | FileCheck %s --check-prefix=MARKER-DIRECTORY
# RUN: test ! -e %t.outputs/marker-directory

# The helper output root itself must be a real directory, not a symlink back
