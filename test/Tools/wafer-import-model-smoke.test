# REQUIRES: stablehlo

# RUN: wafer-import-model --emit-static-smoke-artifact | FileCheck %s --check-prefix=EMIT
# RUN: wafer-import-model --emit-static-smoke-artifact > %t.static.mlir
# RUN: wafer-import-model --verify-import-result %t.static.mlir | FileCheck %s --check-prefix=VERIFY

# RUN: printf '%b' 'module attributes {"wafer.import.graph_break" = "python control flow escaped capture"} {}\n' > %t.graph-break.mlir
# RUN: not wafer-import-model --verify-import-result %t.graph-break.mlir 2>&1 | FileCheck %s --check-prefix=GRAPH

# RUN: printf '%b' 'module attributes {"wafer.import.eager_fallback" = "aten fallback remained in capture"} {}\n' > %t.eager-fallback.mlir
# RUN: not wafer-import-model --verify-import-result %t.eager-fallback.mlir 2>&1 | FileCheck %s --check-prefix=EAGER

# RUN: printf '%b' 'module {\n  func.func @unbounded_dynamic(%%arg0: tensor<?x4xf32>) -> tensor<?x4xf32> {\n    return %%arg0 : tensor<?x4xf32>\n  }\n}\n' > %t.dynamic.mlir
# RUN: not wafer-import-model --verify-import-result %t.dynamic.mlir 2>&1 | FileCheck %s --check-prefix=DYNAMIC

# RUN: printf '%b' 'module {\n  func.func @bounded_dynamic(%%arg0: tensor<?x4xf32> {wafer.frontend.dynamic_bounds = [8, 4]}) -> (tensor<?x4xf32> {wafer.frontend.dynamic_bounds = [8, 4]}) {\n    return %%arg0 : tensor<?x4xf32>\n  }\n}\n' > %t.bounded-dynamic.mlir
# RUN: wafer-import-model --verify-import-result %t.bounded-dynamic.mlir | FileCheck %s --check-prefix=VERIFY

# RUN: printf '%b' 'module {\n  func.func @bad_dynamic_bound(%%arg0: tensor<?x4xf32> {wafer.frontend.dynamic_bounds = [0, 4]}) -> tensor<?x4xf32> {\n    return %%arg0 : tensor<?x4xf32>\n  }\n}\n' > %t.bad-dynamic-bound.mlir
# RUN: not wafer-import-model --verify-import-result %t.bad-dynamic-bound.mlir 2>&1 | FileCheck %s --check-prefix=BAD-BOUND

# RUN: printf '%b' 'module {\n  func.func @weight_artifact(%%arg0: tensor<2x4xf32> {wafer.frontend.constant = "w0"}) -> tensor<2x4xf32> {\n    return %%arg0 : tensor<2x4xf32>\n  }\n}\n' > %t.sidecar.mlir
# RUN: printf '%b' '{"version":0,"constants":[{"function":"weight_artifact","arg":0,"resource_key":"w0","shape":[2,4],"dtype":"f32","byte_size":32,"checksum":"sha256:abc"}]}\n' > %t.sidecar.json
# RUN: wafer-import-model --verify-import-result %t.sidecar.mlir --sidecar %t.sidecar.json | FileCheck %s --check-prefix=SIDECAR

# RUN: printf '%b' '{"version":0,"constants":[{"function":"weight_artifact","arg":0,"resource_key":"w0","shape":[4,2],"dtype":"f32","byte_size":32,"checksum":"sha256:abc"}]}\n' > %t.bad-sidecar-shape.json
# RUN: not wafer-import-model --verify-import-result %t.sidecar.mlir --sidecar %t.bad-sidecar-shape.json 2>&1 | FileCheck %s --check-prefix=SIDECAR-SHAPE

# RUN: printf '%b' 'module {\n  func.func @missing_constant_attr(%%arg0: tensor<2x4xf32>) -> tensor<2x4xf32> {\n    return %%arg0 : tensor<2x4xf32>\n  }\n}\n' > %t.missing-constant-attr.mlir
# RUN: printf '%b' '{"version":0,"constants":[{"function":"missing_constant_attr","arg":0,"resource_key":"w0","shape":[2,4],"dtype":"f32","byte_size":32}]}\n' > %t.missing-constant-attr.json
# RUN: not wafer-import-model --verify-import-result %t.missing-constant-attr.mlir --sidecar %t.missing-constant-attr.json 2>&1 | FileCheck %s --check-prefix=SIDECAR-ATTR

# EMIT: module
# EMIT: func.func @wafer_import_static_smoke
# EMIT: tensor<2x4xf32>
# EMIT: stablehlo.add

# VERIFY: wafer-import-model: verified frontend artifact

# GRAPH: wafer-import-model: graph break rejected
# GRAPH: python control flow escaped capture

# EAGER: wafer-import-model: eager fallback rejected
# EAGER: aten fallback remained in capture

# DYNAMIC: wafer-import-model: unbounded dynamic shape rejected
# DYNAMIC: func.func @unbounded_dynamic

# BAD-BOUND: wafer-import-model: invalid dynamic bound rejected
# BAD-BOUND: func.func @bad_dynamic_bound argument 0

# SIDECAR: wafer-import-model: verified frontend sidecar constants: 1
# SIDECAR: wafer-import-model: verified frontend artifact

# SIDECAR-SHAPE: wafer-import-model: sidecar constant rejected
# SIDECAR-SHAPE: shape mismatch for func.func @weight_artifact argument 0

# SIDECAR-ATTR: wafer-import-model: sidecar constant rejected
# SIDECAR-ATTR: func.func @missing_constant_attr argument 0 is missing wafer.frontend.constant
