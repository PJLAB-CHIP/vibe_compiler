# REQUIRES: stablehlo, shardy, numeric-model, systemc-model

# This is a source-to-package production vertical.  The test-only SPMD helper
# only supplies the verified replicated ProgramRankSlice contract that a
# configured XLA helper normally emits; it does not select or construct an
# instruction candidate.

# RUN: rm -rf %t.input.program %t.outputs %t.mock-spmd-helper %t.input.npy %t.expected.npy
# RUN: mkdir -p %t.input.program/functions %t.input.program/data %t.outputs
# RUN: printf '%b' 'module {\n  func.func @main(%%input: tensor<32x32xf32>) -> tensor<32x32xf32> {\n    %%constant = stablehlo.constant dense<1.000000e+00> : tensor<32x32xf32>\n    %%shifted = stablehlo.add %%input, %%constant : tensor<32x32xf32>\n    %%result = "stablehlo.dot_general"(%%shifted, %%constant) {\n      dot_dimension_numbers = #stablehlo.dot<lhs_contracting_dimensions = [1], rhs_contracting_dimensions = [0]>,\n      precision_config = [#stablehlo<precision DEFAULT>, #stablehlo<precision DEFAULT>]\n    } : (tensor<32x32xf32>, tensor<32x32xf32>) -> tensor<32x32xf32>\n    return %%result : tensor<32x32xf32>\n  }\n}\n' > %t.input.program/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[32,32],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[32,32],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"input"}],"unused_inputs":[]}\n' > %t.input.program/functions/forward.meta
# RUN: %python -c 'import numpy as np; x=np.eye(32,dtype=np.float32); c=np.ones((32,32),dtype=np.float32); np.save("%t.input.npy",x); np.save("%t.expected.npy",(x+c)@c)'
# RUN: printf '%b' '#!/usr/bin/env bash\nset -euo pipefail\ninput=""\noutput=""\nrank_count=""\nwhile [[ $# -gt 0 ]]; do\n  case "$1" in\n    --input-program-dir) input="$2"; shift 2 ;;\n    --output-program-dir) output="$2"; shift 2 ;;\n    --logical-rank-count) rank_count="$2"; shift 2 ;;\n    --entry-function) shift 2 ;;\n    *) shift ;;\n  esac\ndone\ntest "$rank_count" = 16\nrm -rf "$output"\nmkdir -p "$output"\ncp -R "$input/." "$output/"\nmodule="$output/functions/forward.mlir"\nsed -i "0,/^module {/s//module attributes {\\\"mhlo.spmd_parameters_shardings\\\" = \\\"\\\"} {/" "$module"\necho "{\\\"parameter_shards_version\\\":3,\\\"function\\\":\\\"forward\\\",\\\"logical_rank_count\\\":$rank_count,\\\"parameters\\\":[]}" > "$output/functions/forward.parameter_shards.json"\npython3 - "$output/functions/forward.meta" "$rank_count" <<PY\nimport json\nimport sys\npath = sys.argv[1]\nrank_count = int(sys.argv[2])\nwith open(path) as stream:\n    meta = json.load(stream)\ndef binding(index_field, index):\n    shape = [32, 32]\n    ranks = [{\"rank\": rank, \"replica_id\": rank, \"offsets\": [0, 0], \"sizes\": shape, \"strides\": [1, 1]} for rank in range(rank_count)]\n    return {index_field: index, \"distribution\": \"replicated\", \"global_shape\": shape, \"local_shape\": shape, \"dtype\": \"float32\", \"ranks\": ranks}\nmeta[\"distributed_boundary\"] = {\"version\": 1, \"logical_rank_count\": rank_count, \"inputs\": [binding(\"argument_index\", 0)], \"outputs\": [binding(\"result_index\", 0)]}\nwith open(path, \"w\") as stream:\n    json.dump(meta, stream)\nPY\n' > %t.mock-spmd-helper
# RUN: chmod +x %t.mock-spmd-helper

# The ordinary default driver must select the NoC-resident sibling and carry it
# through target linking, package publication and the SystemC/CPU-expected gate.
# RUN: env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-spmd-helper %wafer_compile_test --input-program-dir %t.input.program --output-program-dir %t.outputs/winner --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v3 --launch-kind=kernel --model-input 0=%t.input.npy --model-expected 0=%t.expected.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=4000000 --target-model-max-fused-multiply-adds=4000000 --target-model-max-movement-bytes=100000000 --target-model-max-movement-segments=1000000 | FileCheck %s --check-prefix=WINNER
# RUN: env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-spmd-helper %wafer_compile_test --input-program-dir %t.input.program --output-program-dir %t.outputs/profiled --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v3 --launch-kind=kernel --profile | FileCheck %s --check-prefix=PROFILED
# Profiling instruments the executable, so its digest is expected to differ.
# The selected schedule, launch contract, resources and transport must not.
# RUN: %python -c 'import copy,json,pathlib; roots=[pathlib.Path("%t.outputs/winner"),pathlib.Path("%t.outputs/profiled")]; manifests=[json.loads((root/"manifest.json").read_text()) for root in roots]; normalized=[copy.deepcopy(manifest) for manifest in manifests]; [[module.pop("digest") for module in manifest["modules"]] for manifest in normalized]; assert normalized[0]==normalized[1]; assert all((root/manifest["modules"][0]["path"]).read_bytes().startswith(b"\x7fELF") for root,manifest in zip(roots,manifests))'

# The private qualification seam replays the exact same source/config through
# the reserved baseline.  Together with the final-IR cost evidence below, it
# proves a real candidate difference rather than a source/package difference.
# RUN: env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-spmd-helper WAFER_TEST_SELECT_RESERVED_BASELINE=1 %wafer_compile_test --input-program-dir %t.input.program --output-program-dir %t.outputs/baseline --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v3 --launch-kind=kernel --model-input 0=%t.input.npy --model-expected 0=%t.expected.npy --model-atol=0 --model-rtol=0 --target-model --target-model-max-scalar-evaluations=4000000 --target-model-max-fused-multiply-adds=4000000 --target-model-max-movement-bytes=100000000 --target-model-max-movement-segments=1000000 | FileCheck %s --check-prefix=BASELINE

# RUN: %python -c 'import json,pathlib; packages=[pathlib.Path("%t.outputs/winner"),pathlib.Path("%t.outputs/baseline")]; manifests=[json.loads((p/"manifest.json").read_text()) for p in packages]; w,b=manifests; assert all(m["schema_version"]==6 and m["rank_count"]==16 and m["target"]["profile"]=="wafer-tx81-single-card-kernel-v3" for m in manifests); assert w["target"]["launch"]=={"kind":"kernel","form":"cluster","entry_abi":"rank-major-pointer-table-v1","phases":["prepare","main"]}; assert b["target"]["launch"]=={"kind":"kernel","form":"grid","entry_abi":"rank-major-pointer-table-v1","phases":["main"]}; assert [entry["transport"]["kind"] for entry in w["entries"]]==["direct_dte"]*16 and [entry["transport"]["kind"] for entry in b["entries"]]==["none"]*16; assert all(entry["transport"]["status_abi"]=="wafer-direct-dte-status-v2" and entry["transport"]["host_watchdog_required"] for entry in w["entries"]); assert [resource["rank"] for resource in w["resources"] if resource["role"]=="transport_status"]==list(range(16)); assert not [resource for resource in b["resources"] if resource["role"]=="transport_status"]; assert all((p/m["modules"][0]["path"]).read_bytes().startswith(b"\x7fELF") for p,m in zip(packages,manifests))'
# RUN: %python -c 'import json,pathlib; v=json.loads((pathlib.Path("%t.outputs/profiled.profile")/"variants.json").read_text())["variants"][0]["static_cost_model"]["ranks"]; known=lambda field:[int(rank["work"][field]["value"]) if rank["work"][field]["knowledge"]=="known" else None for rank in v]; reads=known("ddr_read_bytes"); writes=known("ddr_write_bytes"); sends=known("noc_transmit_bytes"); recvs=known("noc_receive_bytes"); assert reads.count(4096)==1 and reads.count(0)==15 and sum(reads)==4096,reads; assert writes==[4096]*16,writes; assert sum(sends)==sum(recvs)==15*4096,(sends,recvs); assert sum(x>0 for x in sends)==15 and sum(x>0 for x in recvs)==15,(sends,recvs)'
# RUN: %python -c 'import json,pathlib,re,subprocess; tool="%wafer_src_root/third_party/tx8_deps/Xuantie-900-gcc-elf-newlib-x86_64-V2.10.2/bin/riscv64-unknown-elf-objdump"; roots=[pathlib.Path("%t.outputs/winner"),pathlib.Path("%t.outputs/baseline")]; modules=[root/json.loads((root/"manifest.json").read_text())["modules"][0]["path"] for root in roots]; dumps=[subprocess.run([tool,"-dr",str(module)],check=True,text=True,capture_output=True).stdout for module in modules]; count=lambda text,name:len(re.findall(r"\b(?:jal|j)\s+[^\n]*<"+re.escape(name)+r">",text)); w,b=dumps; assert count(w,"wafer_tx81_rdma_v3")==count(b,"wafer_tx81_rdma_v3")==1; assert count(w,"wafer_tx81_direct_dte_send_prepare")>0 and count(w,"wafer_tx81_direct_dte_send_issue_v3")>0 and count(w,"wafer_tx81_direct_dte_recv_prepare")>0 and count(w,"wafer_tx81_direct_dte_wait")>0,w; assert all(count(b,name)==0 for name in ("wafer_tx81_direct_dte_send_prepare","wafer_tx81_direct_dte_send_issue_v3","wafer_tx81_direct_dte_recv_prepare","wafer_tx81_direct_dte_wait")),b; assert all(count(text,"wafer_tx81_elementwise_add_v3")==count(text,"wafer_tx81_gemm_v3")==1 for text in (w,b))'
# RUN: wafer-run --package-dir %t.outputs/winner --all-ranks --no-card --direct-dte-status-abi wafer-direct-dte-status-v2 --supports-host-watchdog | FileCheck %s --check-prefix=NO-CARD
# RUN: wafer-run --package-dir %t.outputs/baseline --all-ranks --no-card | FileCheck %s --check-prefix=NO-CARD

# WINNER: wafer-compile: published verified package with execution-ranks=16:
# WINNER: target model outputs matched; ranks=16 transactions=
# PROFILED: wafer-compile: published verified package with execution-ranks=16:
# PROFILED: wafer-compile: published profile companion:
# BASELINE: wafer-compile: published verified package with execution-ranks=16:
# BASELINE: target model outputs matched; ranks=16 transactions=
# NO-CARD: board_execution: false
