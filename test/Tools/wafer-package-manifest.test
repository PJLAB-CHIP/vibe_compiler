# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --roundtrip %S/valid-package-manifest.json | FileCheck %s
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --validate %S/valid-package-manifest.json
# RUN: not %python %wafer_src_root/tools/wafer_package_manifest.py --validate %S/invalid-completion-manifest.json 2>&1 | FileCheck %s --check-prefix=ERR
# RUN: not %python %wafer_src_root/tools/wafer_package_manifest.py --validate %S/invalid-workspace-manifest.json 2>&1 | FileCheck %s --check-prefix=WORKSPACE-ERR
# RUN: not %python %wafer_src_root/tools/wafer_package_manifest.py --validate %S/invalid-resident-constant-manifest.json 2>&1 | FileCheck %s --check-prefix=CONST-ERR

# CHECK: "schema_version": 1
# CHECK: "package_name": "manifest_schema_fixture"
# CHECK: "completion_source": "hpgr_stream_event"
# CHECK-NOT: {{"place}}{{ment"}}
# CHECK-NOT: TsmDeviceSynchronize
# CHECK: "ddr_external_input_bytes": 32
# CHECK: "ddr_external_output_bytes": 16
# CHECK: "workspace_bytes": 16
# CHECK: "resident_constant_bytes": 16
# CHECK: "wafer.instr.rdma"
# CHECK: "wafer.instr.elementwise"
# CHECK: "wafer.instr.reduce"
# CHECK: "wafer.instr.wdma"

# ERR: completion source is a known stub fence
# WORKSPACE-ERR: resources.workspace_bytes does not match workspace buffers
# CONST-ERR: resources.resident_constant_bytes does not match resident constants
