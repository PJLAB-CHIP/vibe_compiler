# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-m0-smoke | %python %wafer_src_root/tools/wafer_package_manifest.py --roundtrip - | FileCheck %s
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-m0-smoke | %python %wafer_src_root/tools/wafer_package_manifest.py --validate -
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-elementwise-smoke | %python %wafer_src_root/tools/wafer_package_manifest.py --validate -
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-m6-local-smoke | %python %wafer_src_root/tools/wafer_package_manifest.py --roundtrip - | FileCheck %s --check-prefix=M6
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-stub-smoke | not %python %wafer_src_root/tools/wafer_package_manifest.py --validate - 2>&1 | FileCheck %s --check-prefix=ERR
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-bad-placement-smoke | not %python %wafer_src_root/tools/wafer_package_manifest.py --validate - 2>&1 | FileCheck %s --check-prefix=PLACEMENT-ERR
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-bad-local-shard-smoke | not %python %wafer_src_root/tools/wafer_package_manifest.py --validate - 2>&1 | FileCheck %s --check-prefix=SHARD-ERR
# RUN: not %python %wafer_src_root/tools/wafer_package_manifest.py --validate %S/invalid-workspace-manifest.json 2>&1 | FileCheck %s --check-prefix=WORKSPACE-ERR
# RUN: not %python %wafer_src_root/tools/wafer_package_manifest.py --validate %S/invalid-resident-constant-manifest.json 2>&1 | FileCheck %s --check-prefix=CONST-ERR

