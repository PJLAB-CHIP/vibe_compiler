# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-single-tile-matmul | %python %wafer_src_root/tools/wafer_package_manifest.py --roundtrip - | FileCheck %s
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-single-tile-matmul | %python %wafer_src_root/tools/wafer_package_manifest.py --validate -
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-single-tile-elementwise | %python %wafer_src_root/tools/wafer_package_manifest.py --validate -
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-local-transformer-block | %python %wafer_src_root/tools/wafer_package_manifest.py --roundtrip - | FileCheck %s --check-prefix=BLOCK
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-synchronous-completion | not %python %wafer_src_root/tools/wafer_package_manifest.py --validate - 2>&1 | FileCheck %s --check-prefix=ERR
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-invalid-placement | not %python %wafer_src_root/tools/wafer_package_manifest.py --validate - 2>&1 | FileCheck %s --check-prefix=PLACEMENT-ERR
# RUN: %python %wafer_src_root/tools/wafer_package_manifest.py --emit-invalid-local-shard | not %python %wafer_src_root/tools/wafer_package_manifest.py --validate - 2>&1 | FileCheck %s --check-prefix=SHARD-ERR
# RUN: not %python %wafer_src_root/tools/wafer_package_manifest.py --validate %S/invalid-workspace-manifest.json 2>&1 | FileCheck %s --check-prefix=WORKSPACE-ERR
# RUN: not %python %wafer_src_root/tools/wafer_package_manifest.py --validate %S/invalid-resident-constant-manifest.json 2>&1 | FileCheck %s --check-prefix=CONST-ERR

