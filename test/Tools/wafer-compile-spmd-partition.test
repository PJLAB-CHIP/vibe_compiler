# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper

# RUN: rm -rf %t.input.program %t.outputs
# RUN: mkdir -p %t.outputs
# RUN: env CPU_NUM_DEVICES=1 PJRT_DEVICE=CPU %importer_python %wafer_src_root/test/Tools/Inputs/wafer_pytorch_xla_capture.py --emit-reference-program --size 32 --output-program-dir %t.input.program
# RUN: printf 'bytecode sentinel from exporter program\n' > %t.input.program/functions/forward.bytecode
# RUN: printf 'auxiliary data sentinel from exporter program\n' > %t.input.program/data/aux.payload
# RUN: wafer-compile --input-program-dir %t.input.program --output-package-dir %t.outputs/package --num-partitions=1 | FileCheck %s --check-prefix=PIPELINE
# The executable package carries manifest/modules/program data only; the
# source tree, IR copy, parameter shard directory and auxiliary exporter
# payload do not enter the package.
# RUN: test ! -e %t.outputs/package/functions
# RUN: test ! -e %t.outputs/package/parameter_shards
# RUN: test ! -e %t.outputs/package/data/aux.payload
# RUN: %python -c 'import hashlib, json, pathlib; p=pathlib.Path("%t.outputs/package"); m=json.loads((p/"manifest.json").read_text()); pd=m["program_data"]; data=(p/pd["relative_path"]).read_bytes(); assert len(data)==pd["total_bytes"]>0 and pd["digest"]=="sha256:"+hashlib.sha256(data).hexdigest(); pt=m["program_tensors"]; assert {x["role"] for x in pt}=={"parameter"} and {x["role_index"] for x in pt}=={0,1}; tt=m["target_tensors"]; assert {x["program_tensor"] for x in tt}=={0,1} and sum(x["bytes"] for x in tt)<=pd["total_bytes"] and all(x["file_offset"]+x["bytes"]<=pd["total_bytes"] for x in tt); i=m["inputs"][0]; assert i["role_index"]==2 and i["logical_dtype"]=="f32" and i["logical_shape"]==[32,32] and i["bytes"]==4096; o=m["outputs"][0]; assert o["role_index"]==0 and o["logical_dtype"]=="f32" and o["logical_shape"]==[32,32]'
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'
# RUN: %python -c 'from pathlib import Path; modules=sorted(Path("%t.outputs/package/modules").glob("module_*.so")); assert [p.name for p in modules]==["module_00000.so"]; assert modules[0].read_bytes().startswith(b"\x7fELF")'
# RUN: %python -c 'import json, pathlib; p=pathlib.Path("%t.outputs/package"); m=json.loads((p/"manifest.json").read_text()); assert m["target"]["identity"]=="wafer-tx81-single-card" and m["card_count"]==1 and m["tile_count"]==16; module_ids={x["id"] for x in m["modules"]}; assert module_ids and {x["card_id"] for x in m["entries"]}=={0} and {x["tile_id"] for x in m["entries"]}==set(range(16)) and {x["launch_slot"] for x in m["entries"]}==set(range(16)) and {x["module"] for x in m["entries"]}<=module_ids and {x["completion"] for x in m["entries"]}=={"return_after_local_drain"}; assert "completions" not in m and "instructions" not in m and all((p/x["path"]).read_bytes().startswith(b"\x7fELF") for x in m["modules"])'
# PIPELINE: wafer-compile: wrote verified package with num-partitions=1 tiles=16:
