# PIPELINE: wafer-compile: published verified package with execution-ranks=16:

# DIRECT-DTE: wafer-compile: published verified package with execution-ranks=16:
# LATE-RANK: wafer-compile: test-only injected failure after logical rank 15
# LATE-TARGET-RANK: wafer-compile: test-only injected target failure after logical rank 15
# LATE-PACKAGE-RANK: wafer-compile: test-only injected package failure after logical rank 15

# VERIFY: wafer-compile-stablehlo: verified StableHLO program directory parameters: 2
# VERIFY: wafer-compile-stablehlo: verified StableHLO program directory parameter shards: 2
# VERIFY: wafer-compile-stablehlo: verified StableHLO program

# MLIR: mhlo.spmd_parameters_shardings
# MLIR: wafer.target.topology @default
# MLIR: wafer.execution.mesh @default_mesh
# MLIR-SAME: policy = "all_available"
# MLIR-SAME: shape = array<i64: 16>
# MLIR: func.func @main
# MLIR-SAME: tensor<2xf32>
# MLIR-SAME: tensor<32x2xf32>
# MLIR-NOT: stablehlo.all_gather
# MLIR-NOT: wafer.tile.
# MLIR-NOT: stablehlo.
# MLIR: tensor.empty
# MLIR: linalg.matmul
# MLIR: linalg.generic
# MLIR: arith.addf

# NO-BOUNDARY-IR: module
# NO-BOUNDARY-IR-NOT: wafer.boundary_shards
# NO-BOUNDARY-IR-NOT: wafer.boundary.shards

# NO-UNLOWERED-IR: module
# NO-UNLOWERED-IR-NOT: stablehlo.
# NO-UNLOWERED-IR-NOT: wafer.tile.

# SHARDS: "logical_rank_count": 16
# SHARDS: "parameter_shards_version": 3
# SHARDS: "distribution":
# SHARDS: "name": "bias"
# SHARDS: "name": "weight"

# MATRIX-MLIR: mhlo.spmd_parameters_shardings
# MATRIX-MLIR: wafer.target.topology @default
# MATRIX-MLIR: wafer.execution.mesh @default_mesh
# MATRIX-MLIR: func.func @main
# MATRIX-MLIR: linalg.
# MATRIX-MLIR-NOT: wafer.boundary_shards
# MATRIX-MLIR-NOT: wafer.boundary.shards
