# REQUIRES: stablehlo, shardy, xla-spmd-helper

# Source-derived choices must survive profile packaging, with exact messages
# and payloads checked against final Instr. The tail exercises ragged lowering.
# RUN: rm -rf %t.peer %t.ddr %t.tail %t.ordinary
# RUN: %python %S/../Board/Support/wafer_board_communication_performance.py --transport peer --extent 1024 --work-dir %t.peer --wafer-compile %wafer_compile_test --wafer-run %wafer_obj_root/bin/wafer-run --no-card | FileCheck %s --check-prefix=PEER
# RUN: %python %S/../Board/Support/wafer_board_communication_performance.py --transport shared-ddr --extent 1024 --work-dir %t.ddr --wafer-compile %wafer_compile_test --wafer-run %wafer_obj_root/bin/wafer-run --no-card | FileCheck %s --check-prefix=DDR
# RUN: %python %S/../Board/Support/wafer_board_communication_performance.py --transport peer --extent 1025 --work-dir %t.tail --wafer-compile %wafer_compile_test --wafer-run %wafer_obj_root/bin/wafer-run --no-card | FileCheck %s --check-prefix=TAIL
# Keep metadata compact, including when a reader supplies a byte budget.
# RUN: %python -c "import pathlib; files = [p for root in ['%t.peer', '%t.ddr', '%t.tail'] for p in (pathlib.Path(root) / 'delivery/package.profile').glob('*.json')]; assert len(files) == 9; assert all(p.read_bytes().count(b'\n') == 1 and p.read_bytes().endswith(b'\n') for p in files)"
# RUN: %wafer_compile_test --input-program-dir %t.peer/source --output-dir %t.ordinary --num-partitions=1 --optimization-policy=none --test-communication-candidate=peer
# RUN: diff -r %t.ordinary %t.peer/delivery/package
# RUN: %wafer_obj_root/bin/wafer-run --package-dir %t.peer/delivery/package --no-card --direct-dte-status-abi wafer-direct-dte-status --supports-host-watchdog --profile-trace-event-limit 1024 | FileCheck %s --check-prefix=PREFIX
# RUN: not %wafer_obj_root/bin/wafer-run --package-dir %t.peer/delivery/package --no-card --profile-trace-event-limit 0 2>&1 | FileCheck %s --check-prefix=ZERO-LIMIT
# RUN: not %wafer_obj_root/bin/wafer-run --package-dir %t.peer/delivery/package --no-card --profile-trace-event-limit 209706 2>&1 | FileCheck %s --check-prefix=OVER-LIMIT
# RUN: not %wafer_obj_root/bin/wafer-run --package-dir %t.ordinary --no-card --profile-trace-event-limit 1024 2>&1 | FileCheck %s --check-prefix=NO-PROFILE
# RUN: %wafer_obj_root/bin/wafer-run --package-dir %t.peer/delivery/package --no-card --direct-dte-status-abi wafer-direct-dte-status --supports-host-watchdog --kernel-timing | FileCheck %s --check-prefix=TIMING
# RUN: %wafer_obj_root/bin/wafer-run --package-dir %t.tail/delivery/package --no-card --direct-dte-status-abi wafer-direct-dte-status --supports-host-watchdog --kernel-timing | FileCheck %s --check-prefix=TIMING
# RUN: not %wafer_obj_root/bin/wafer-run --package-dir %t.ordinary --no-card --kernel-timing 2>&1 | FileCheck %s --check-prefix=NO-TIMING
# RUN: not %wafer_obj_root/bin/wafer-run --package-dir %t.peer/delivery/package --no-card --kernel-timing --profile-trace-event-limit 1 2>&1 | FileCheck %s --check-prefix=TIMING-CONFLICT
# TIMING: profile_instrumentation: ready cards=1 tiles=16 captures=3
# TIMING: kernel_timing: ready record_bytes=64 scope=main-entry aggregation=max-tile-duration
# TIMING: board_execution: false
# NO-TIMING: --kernel-timing requires sibling profile instrumentation
# TIMING-CONFLICT: --kernel-timing cannot be combined with --profile-trace-event-limit
# RUN: not %wafer_compile_test --input-program-dir %t.peer/source --output-dir %t.invalid --num-partitions=1 --optimization-policy=search --test-communication-candidate=peer --profile 2>&1 | FileCheck %s --check-prefix=INVALID

# PEER: performance_no_card: peer extent=1024 sends_per_tile=15 profile_ready=true numeric_reference=false
# DDR: performance_no_card: shared-ddr extent=1024 sends_per_tile=0 profile_ready=true numeric_reference=false
# TAIL: performance_no_card: peer extent=1025 sends_per_tile=15 profile_ready=true numeric_reference=false
# INVALID: explicit communication qualification requires none

# PREFIX: profile_trace: event_prefix_limit=1024
# PREFIX: profile_instrumentation: ready cards=1 tiles=16
# ZERO-LIMIT: --profile-trace-event-limit must be a positive uint32 integer
# OVER-LIMIT: --profile-trace-event-limit exceeds the trace package capacity
# NO-PROFILE: --profile-trace-event-limit requires sibling profile instrumentation
