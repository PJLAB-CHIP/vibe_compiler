# REQUIRES: stablehlo, shardy, xla-spmd-helper

# Increasing one FP16 parameter from 0.5 MiB through 8 MiB must increase the
# byte/read-window ledger without increasing source identity/open counts or
# exceeding the 1 MiB read bound.

# RUN: rm -rf %t.small %t.medium %t.large %t.small-output %t.medium-output %t.large-output %t.small.log %t.medium.log %t.large.log
# RUN: mkdir -p %t.small-output %t.medium-output %t.large-output
# RUN: %python -c 'import json,numpy as np,pathlib; root=pathlib.Path("%t"); mlir="module {\n  func.func @main($input: tensor<{n}x{n}xf16>, $weight: tensor<{n}x{n}xf16>) -> tensor<{n}x{n}xf16> {\n    $result = stablehlo.add $input, $weight : tensor<{n}x{n}xf16>\n    return $result : tensor<{n}x{n}xf16>\n  }\n}\n".replace("$",chr(37)); [(lambda p,n: (p.joinpath("functions").mkdir(parents=True),p.joinpath("data").mkdir(),p.joinpath("functions/forward.mlir").write_text(mlir.replace("{n}",str(n))),p.joinpath("functions/forward.meta").write_text(json.dumps({"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[n,n],"dtype":"float16","dynamic_dims":[]},{"shape":[n,n],"dtype":"float16","dynamic_dims":[]}],"output_signature":[{"shape":[n,n],"dtype":"float16","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"input"},{"type_":"parameter","position":-1,"name":"weight"}],"unused_inputs":[]})+"\n"),np.save(p.joinpath("data/weight").open("wb"),np.ones((n,n),dtype=np.float16))))(pathlib.Path(str(root)+"."+label),n) for label,n in (("small",512),("medium",1024),("large",2048))]'
# RUN: wafer-compile --input-program-dir %t.small --output-dir %t.small-output/package --num-partitions=1 --optimization-policy=none 2>&1 | tee %t.small.log | FileCheck %s --check-prefix=SMALL
# RUN: wafer-run --package-dir %t.small-output/package --no-card | FileCheck %s --check-prefix=NO-CARD
# RUN: wafer-compile --input-program-dir %t.medium --output-dir %t.medium-output/package --num-partitions=1 --optimization-policy=none 2>&1 | tee %t.medium.log | FileCheck %s --check-prefix=MEDIUM
# RUN: wafer-run --package-dir %t.medium-output/package --no-card | FileCheck %s --check-prefix=NO-CARD
# RUN: wafer-compile --input-program-dir %t.large --output-dir %t.large-output/package --num-partitions=1 --optimization-policy=none 2>&1 | tee %t.large.log | FileCheck %s --check-prefix=LARGE
# RUN: wafer-run --package-dir %t.large-output/package --no-card | FileCheck %s --check-prefix=NO-CARD
# RUN: bash -c 'test -z "$(find "%t.small-output" "%t.medium-output" "%t.large-output" -maxdepth 1 -name ".wafer-program-data-*" -print -quit)"'

# SMALL: wafer-compile: program-data-io source_opens=2 file_opens=8
# SMALL-SAME: read_windows={{[1-9][0-9]*}} read_bytes={{[1-9][0-9]*}} maximum_read_window_bytes={{[1-9][0-9]*}}
# SMALL-SAME: header_reads=11 digest_passes=7 helper_output_readbacks=1 range_materializations=1 materialized_file_writes=1
# SMALL: wafer-compile: wrote verified package with num-partitions=1 tiles=16:

# MEDIUM: wafer-compile: program-data-io source_opens=2 file_opens=8
# MEDIUM-SAME: read_windows={{[1-9][0-9]*}} read_bytes={{[1-9][0-9]*}} maximum_read_window_bytes=1048576
# MEDIUM-SAME: header_reads=11 digest_passes=7 helper_output_readbacks=1 range_materializations=1 materialized_file_writes=1
# MEDIUM: wafer-compile: wrote verified package with num-partitions=1 tiles=16:

# LARGE: wafer-compile: program-data-io source_opens=2 file_opens=8
# LARGE-SAME: read_windows={{[1-9][0-9]*}} read_bytes={{[1-9][0-9]*}} maximum_read_window_bytes=1048576
# LARGE-SAME: header_reads=11 digest_passes=7 helper_output_readbacks=1 range_materializations=1 materialized_file_writes=1
# LARGE: wafer-compile: wrote verified package with num-partitions=1 tiles=16:

# NO-CARD: package: id=0 cards=1 tiles=16
# NO-CARD: board_execution: false
