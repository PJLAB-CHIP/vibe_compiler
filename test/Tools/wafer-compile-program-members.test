# RUN: test ! -e %t.outputs/profile-collision
# RUN: FileCheck %s --input-file=%t.outputs/profile-collision.profile/sentinel --check-prefix=COMPETITOR
# RUN: not env PROFILE_RACE_OUTPUT=%t.outputs/profile-race.profile WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-spmd-helper %wafer_compile_test --input-program-dir %t.input.program --output-program-dir %t.outputs/profile-race --execution-ranks=16 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 --profile 2>&1 | FileCheck %s --check-prefix=PROFILE-RACE
# RUN: test ! -e %t.outputs/profile-race
# RUN: FileCheck %s --input-file=%t.outputs/profile-race.profile/sentinel --check-prefix=COMPETITOR
# RUN: not env WAFER_TEST_XLA_SPMD_PARTITIONER_HELPER=%t.mock-spmd-helper %wafer_compile_test --input-program-dir %t.input.program --output-program-dir %t.outputs/rank8.package --execution-ranks=8 --target-profile=wafer-tx81-single-card-kernel-v1 --launch-abi=per-rank-pointer-block-v1 2>&1 | FileCheck %s --check-prefix=RANK8
# RUN: test ! -e %t.outputs/rank8.package
# RUN: bash -c 'test -z "$(find "%t.outputs" -maxdepth 1 -name ".wafer-compile-staging-*" -print -quit)"'

# CHECK: wafer-compile: published verified package with execution-ranks=16:
# PROFILE: wafer-compile: published verified package with execution-ranks=16:
# PROFILE: wafer-compile: published profile companion:
# PROFILE-EXISTING: wafer-compile: refusing to replace existing profile companion directory:
# PROFILE-RACE: wafer-compile: output program directory appeared before publication; refusing to replace it
# COMPETITOR: competitor
# RANK8: wafer-compile: execution-ranks must be exactly 1 or 16 for the single-card compiler

# PIPELINE-MLIR: wafer.target.topology @default
# PIPELINE-MLIR: wafer.execution.mesh @default_mesh
# PIPELINE-MLIR-NOT: sdy.constant
# PIPELINE-MLIR: tensor.empty
# PIPELINE-MLIR: linalg.generic
# PIPELINE-MLIR: linalg.matmul
