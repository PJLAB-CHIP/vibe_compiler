# REQUIRES: stablehlo, shardy

# RUN: wafer-import-model --help | FileCheck %s --check-prefix=HELP

# RUN: rm -rf %t.input.bundle %t.partitioned.bundle
# RUN: mkdir -p %t.input.bundle/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%lhs: tensor<32x16xf32>, %%rhs: tensor<16x8xf32>) -> tensor<32x8xf32> {\n    %%0 = "stablehlo.dot_general"(%%lhs, %%rhs) {\n      dot_dimension_numbers = #stablehlo.dot<lhs_contracting_dimensions = [1], rhs_contracting_dimensions = [0]>,\n      precision_config = [#stablehlo<precision DEFAULT>, #stablehlo<precision DEFAULT>]\n    } : (tensor<32x16xf32>, tensor<16x8xf32>) -> tensor<32x8xf32>\n    return %%0 : tensor<32x8xf32>\n  }\n}\n' > %t.input.bundle/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[32,16],"dtype":"float32","dynamic_dims":[]},{"shape":[16,8],"dtype":"float32","dynamic_dims":[]}],"output_signature":[{"shape":[32,8],"dtype":"float32","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"lhs"},{"type_":"input_arg","position":1,"name":"rhs"}],"unused_inputs":[]}\n' > %t.input.bundle/functions/forward.meta

# RUN: not wafer-import-model --partition-stablehlo-bundle %t.input.bundle --output-bundle %t.partitioned.bundle 2>&1 | FileCheck %s --check-prefix=MISSING-HELPER

# RUN: printf '%b' '#!/bin/sh\nexec "%python" "%t.fake-helper.py" "$@"\n' > %t.fake-helper
# RUN: chmod +x %t.fake-helper
# RUN: printf '%b' 'import json\nimport pathlib\nimport sys\n\nargs = sys.argv[1:]\n\ndef option(name):\n    index = args.index(name)\n    return args[index + 1]\n\ninput_bundle = pathlib.Path(option("--input-bundle"))\noutput_bundle = pathlib.Path(option("--output-bundle"))\nlogical_rank_count = int(option("--logical-rank-count"))\nfunctions = output_bundle / "functions"\nfunctions.mkdir(parents=True, exist_ok=True)\n(functions / "forward.meta").write_bytes((input_bundle / "functions" / "forward.meta").read_bytes())\n(functions / "forward.mlir").write_text("""module attributes {\"mhlo.spmd_parameters_shardings\" = \"\"} {\n  func.func @main(%lhs: tensor<32x16xf32>, %rhs: tensor<16x8xf32>) -> tensor<32x8xf32> {\n    %0 = \"stablehlo.dot_general\"(%lhs, %rhs) {\n      dot_dimension_numbers = #stablehlo.dot<lhs_contracting_dimensions = [1], rhs_contracting_dimensions = [0]>,\n      precision_config = [#stablehlo<precision DEFAULT>, #stablehlo<precision DEFAULT>]\n    } : (tensor<32x16xf32>, tensor<16x8xf32>) -> tensor<32x8xf32>\n    return %0 : tensor<32x8xf32>\n  }\n}\n""")\n(functions / "forward.parameter_shards.json").write_text(json.dumps({\n    "parameter_shards_version": 2,\n    "function": "forward",\n    "logical_rank_count": logical_rank_count,\n    "parameters": [],\n}) + "\\n")\n(output_bundle / "helper.args").write_text("\\n".join(args) + "\\n")\n' > %t.fake-helper.py

# RUN: wafer-import-model --partition-stablehlo-bundle %t.input.bundle --output-bundle %t.partitioned.bundle --xla-spmd-partitioner-helper %t.fake-helper --default-tile-count=16 | FileCheck %s --check-prefix=PARTITION
# RUN: FileCheck %s --input-file=%t.partitioned.bundle/helper.args --check-prefix=HELPER-ARGS
