# REQUIRES: stablehlo, shardy, xla-spmd-helper

# RUN: rm -rf %t.input %t.package
# RUN: mkdir -p %t.input/functions
# RUN: printf '%b' 'module {\n  func.func @main(%%arg0: tensor<4x8xf16>) -> tensor<8x4xf16> {\n    %%0 = "stablehlo.transpose"(%%arg0) {permutation = array<i64: 1, 0>} : (tensor<4x8xf16>) -> tensor<8x4xf16>\n    return %%0 : tensor<8x4xf16>\n  }\n}\n' > %t.input/functions/forward.mlir
# RUN: printf '%b' '{"name":"forward","stablehlo_version":"0.0.0","input_signature":[{"shape":[4,8],"dtype":"float16","dynamic_dims":[]}],"output_signature":[{"shape":[8,4],"dtype":"float16","dynamic_dims":[]}],"input_locations":[{"type_":"input_arg","position":0,"name":"input"}],"unused_inputs":[]}\n' > %t.input/functions/forward.meta
# RUN: wafer-compile --input-program-dir %t.input --output-program-dir %t.package --num-partitions=1 --launch-kind=kernel --optimization-policy=none 2>&1 | FileCheck %s
# RUN: test -s %t.package/modules/module_00000.so

# CHECK: wafer-compile: instruction-work scope=tile card_id=0 tile_id=0 instructions_sites=known:4 instructions_exact=known:{{[1-9][0-9]*}}
# CHECK-SAME: rdma_sites=known:1 rdma_exact=known:{{[1-9][0-9]*}}
# CHECK-SAME: wdma_sites=known:1 wdma_exact=known:{{[1-9][0-9]*}}
# CHECK-SAME: tdma_sites=known:1 tdma_exact=known:{{[1-9][0-9]*}}
# CHECK-SAME: gather_scatter_sites=known:1 gather_scatter_exact=known:{{[1-9][0-9]*}}
# CHECK-SAME: ncc_join_sites=known:1 ncc_join_exact=known:1
