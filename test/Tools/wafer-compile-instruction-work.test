# CHECK: wafer-compile: instruction-work scope=tile card_id=0 tile_id=8 instructions_sites=known:0 instructions_exact=known:0
# CHECK: wafer-compile: instruction-work scope=tile card_id=0 tile_id=15 instructions_sites=known:0 instructions_exact=known:0
# CHECK: wafer-compile: instruction-work scope=whole-card instructions_sites=known:32 instructions_exact=known:{{[1-9][0-9]*}}
# CHECK-SAME: rdma_sites=known:8 rdma_exact=known:{{[1-9][0-9]*}}
# CHECK-SAME: gather_scatter_sites=known:8 gather_scatter_exact=known:{{[1-9][0-9]*}}
# CHECK-SAME: ncc_join_sites=known:8 ncc_join_exact=known:8
