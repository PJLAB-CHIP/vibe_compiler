# RUN: printf '%b' 'module {\n  func.func @main() -> i32 {\n    %%c0 = arith.constant 0 : i32\n    return %%c0 : i32\n  }\n}\n' > %t.mlir
# RUN: wafer-opt --pass-pipeline='builtin.module(canonicalize)' %t.mlir | FileCheck %s --check-prefix=IR

# IR: module {
# IR: func.func @main() -> i32
# IR: %[[C0:.+]] = arith.constant 0 : i32
# IR: return %[[C0]] : i32
