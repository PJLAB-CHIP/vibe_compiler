# REQUIRES: stablehlo, shardy, pytorch-xla-importer, xla-spmd-helper

# RUN: rm -rf %t.input.program %t.package
# RUN: env CPU_NUM_DEVICES=16 PJRT_DEVICE=CPU %importer_python %wafer_src_root/test/Tools/Inputs/wafer_pytorch_xla_capture.py --emit-sharded-program --sharding-strategy column --size 32 --output-program-dir %t.input.program
# RUN: wafer-compile --input-program-dir %t.input.program --output-program-dir %t.package --num-partitions=1 --launch-kind=kernel | FileCheck %s --check-prefix=PIPELINE
# RUN: FileCheck %s --input-file=%t.package/functions/forward.mlir --check-prefix=STRUCTURED-MLIR

# PIPELINE: wafer-compile: wrote verified package with num-partitions=1 tiles=16:

# STRUCTURED-MLIR: mhlo.spmd_parameters_shardings
# STRUCTURED-MLIR: wafer.target.topology @default
# STRUCTURED-MLIR: wafer.execution.mesh @default_mesh
# STRUCTURED-MLIR-SAME: axes = ["card_partition"]
# STRUCTURED-MLIR-SAME: shape = array<i64: 16>
# STRUCTURED-MLIR: func.func @main
# STRUCTURED-MLIR-NOT: stablehlo.all_gather
# STRUCTURED-MLIR: tensor.empty
# STRUCTURED-MLIR: linalg.matmul
# STRUCTURED-MLIR: linalg.generic
# STRUCTURED-MLIR: arith.addf
# STRUCTURED-MLIR-NOT: wafer.tile.
